---
import { AUTHOR } from '../data/author';

interface Props {
  variant?: 'inline' | 'card';
  isChinese?: boolean;
}

const { variant = 'inline', isChinese = false } = Astro.props;
---

{variant === 'inline' ? (
  <a class="author-inline" href={AUTHOR.url} aria-label={`${isChinese ? '作者' : 'Author'}: ${AUTHOR.name}`}>
    <img
      class="author-inline-image"
      src={AUTHOR.image}
      alt={`${AUTHOR.name}, ${AUTHOR.shortRole}`}
      width={48}
      height={48}
      decoding="async"
    />
    <span class="author-inline-copy">
      <span class="author-inline-label">{isChinese ? '作者' : 'By'}</span>
      <strong>{AUTHOR.name}</strong>
      <span class="author-inline-role">{AUTHOR.shortRole}</span>
    </span>
  </a>
) : (
  <aside class="author-card" aria-label={isChinese ? '关于作者' : 'About the author'}>
    <a class="author-card-image-link" href={AUTHOR.url} aria-label={`${isChinese ? '了解更多关于' : 'Learn more about'} ${AUTHOR.name}`}>
      <img
        class="author-card-image"
        src={AUTHOR.image}
        alt={`${AUTHOR.name}, ${AUTHOR.role}`}
        width={96}
        height={96}
        loading="lazy"
        decoding="async"
      />
    </a>
    <div class="author-card-copy">
      <div class="author-card-label">{isChinese ? '关于作者' : 'About the author'}</div>
      <h2><a href={AUTHOR.url}>{AUTHOR.name}</a></h2>
      <div class="author-card-role">{AUTHOR.role} at Kiwi Web Design</div>
      <p>{isChinese ? AUTHOR.bioZh : AUTHOR.bio}</p>
      <a class="author-card-link" href={AUTHOR.url}>{isChinese ? '了解 Charlie →' : 'About Charlie →'}</a>
    </div>
  </aside>
)}

<style>
  .author-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
    min-width: 0;
  }

  .author-inline-image {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    border-radius: 999px;
    object-fit: cover;
    border: 2px solid rgba(251, 232, 166, 0.72);
    box-shadow: 0 0 0 3px rgba(255,255,255,0.06);
  }

  .author-inline-copy {
    display: grid;
    grid-template-columns: auto auto;
    column-gap: 0.35rem;
    row-gap: 0.05rem;
    align-items: baseline;
    line-height: 1.25;
  }

  .author-inline-label {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.48);
  }

  .author-inline strong {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.92);
    font-weight: 700;
  }

  .author-inline-role {
    grid-column: 1 / -1;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.52);
  }

  .author-inline:hover strong {
    color: var(--kwd-yellow);
  }

  .author-card {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 1.5rem;
    align-items: start;
    margin: 3.25rem 0 2.75rem;
    padding: 1.75rem;
    background: var(--kwd-cream);
    border: 1px solid rgba(44, 41, 39, 0.1);
    border-radius: 14px;
    box-shadow: 0 8px 28px rgba(44, 41, 39, 0.06);
  }

  .author-card-image-link {
    display: block;
    border-radius: 999px;
  }

  .author-card-image {
    width: 96px;
    height: 96px;
    border-radius: 999px;
    object-fit: cover;
    display: block;
    border: 3px solid #fff;
    box-shadow: 0 0 0 1px rgba(44, 41, 39, 0.1), 0 6px 18px rgba(44, 41, 39, 0.12);
  }

  .author-card-label {
    margin-bottom: 0.3rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--kwd-brown);
  }

  .author-card h2 {
    margin: 0;
    font-family: var(--kwd-font-heading);
    font-size: 1.45rem;
    line-height: 1.15;
  }

  .author-card h2 a {
    color: var(--kwd-dark);
    text-decoration: none;
  }

  .author-card h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--kwd-gold);
    text-underline-offset: 3px;
  }

  .author-card-role {
    margin-top: 0.28rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--kwd-brown);
  }

  .author-card p {
    margin: 0.8rem 0 0.75rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--kwd-dark);
  }

  .author-card-link {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--kwd-dark);
    text-decoration: underline;
    text-decoration-color: var(--kwd-gold);
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .author-inline-image {
      width: 42px;
      height: 42px;
      flex-basis: 42px;
    }

    .author-inline-role {
      display: none;
    }

    .author-card {
      grid-template-columns: 72px 1fr;
      gap: 1rem;
      padding: 1.35rem;
    }

    .author-card-image {
      width: 72px;
      height: 72px;
    }

    .author-card p,
    .author-card-link {
      grid-column: 1 / -1;
    }
  }
</style>
