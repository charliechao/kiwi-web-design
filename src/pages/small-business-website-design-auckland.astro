---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import StatsRow from '../components/StatsRow.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTABanner from '../components/CTABanner.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import about1 from '../assets/general/about1.jpg';
import about2 from '../assets/general/about2.jpg';
import smallBizAuckland from '../assets/general/Small-Business-Auckland.jpg';
import webSolutions from '../assets/general/Website-Solutsions-Auckland.jpg';
import aucklandCafe from '../assets/general/Auckland-small-business-1.jpg';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/",
      "url": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/",
      "name": "Small Business Website Design Auckland | Kiwi Web Design",
      "description": "Custom websites for Auckland small businesses. Built to generate leads, live in 2–3 weeks. Free in-person consultation. Call 021 039 6580.",
      "inLanguage": "en-NZ",
      "isPartOf": { "@id": "https://www.kiwiwebdesign.co.nz/#website" },
      "about": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "breadcrumb": { "@id": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/#breadcrumb" },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".smb-snippet", ".stats-row"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.kiwiwebdesign.co.nz/" },
        { "@type": "ListItem", "position": 2, "name": "Small Business Web Design Auckland", "item": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/" }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/#service",
      "name": "Small Business Website Design Auckland",
      "serviceType": "Website Design",
      "category": "Web Development",
      "description": "Custom website design for Auckland small businesses. Conversion-focused, mobile-first, delivered in 2–3 weeks. WordPress or custom build.",
      "provider": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "areaServed": [
        { "@type": "City", "name": "Auckland" },
        { "@type": "Country", "name": "New Zealand" }
      ],
      "url": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/"
    },
    {
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": "https://www.kiwiwebdesign.co.nz/#organization",
      "name": "Kiwi Web Design",
      "alternateName": "Small Business Website Design Auckland",
      "url": "https://www.kiwiwebdesign.co.nz/",
      "telephone": "+64-21-039-6580",
      "email": "hi@kiwiwebdesign.co.nz",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "147 Great North Road",
        "addressLocality": "Grey Lynn",
        "addressRegion": "Auckland",
        "postalCode": "1021",
        "addressCountry": "NZ"
      },
      "areaServed": [
        { "@type": "City", "name": "Auckland" },
        { "@type": "Country", "name": "New Zealand" }
      ],
      "priceRange": "$$",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.kiwiwebdesign.co.nz/favicon.png",
        "width": 512,
        "height": 512
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does a website cost for a small business in Auckland?",
          "acceptedAnswer": { "@type": "Answer", "text": "Every project gets a fixed, custom quote based on your pages, features, and platform, no published price list and no surprises. Most Auckland small business sites are built on WordPress, though we also deliver fully custom builds depending on your needs. Book a free consultation for an exact quote." }
        },
        {
          "@type": "Question",
          "name": "How long does it take to build a website?",
          "acceptedAnswer": { "@type": "Answer", "text": "Most projects are completed in 2–3 weeks from when content is received. More complex sites with custom features may take 4–6 weeks. A timeline is provided upfront." }
        },
        {
          "@type": "Question",
          "name": "Will I be able to update the website myself?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. WordPress sites are easy to update without a developer. For custom builds we set up the right editing tools for your needs. A handover session is included with every project. Monthly maintenance plans are also available." }
        },
        {
          "@type": "Question",
          "name": "Do you offer hosting and maintenance for Auckland small businesses?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Managed hosting is available and includes updates, backups, security, and monthly content changes. Ask us for hosting pricing when you get your quote." }
        },
        {
          "@type": "Question",
          "name": "Can you redesign my existing website?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Full rebuilds, redesigns, and migrations from Wix, Squarespace, or old WordPress themes are all available. We also build from scratch on custom platforms where needed. SEO and content are preserved during the process." }
        }
      ]
    }
  ]
};

const stats = [
  { number: "Free", label: "Discovery call, no obligation" },
  { number: "2–3 wks", label: "Typical delivery time" },
  { number: "50+", label: "Auckland businesses helped" },
  { number: "5★", label: "Average Google rating" },
];

const included = [
  {
    icon: "🎨",
    title: "Custom Design",
    desc: "No cookie-cutter templates. Your website is designed around your brand, your customers, and your goals, so it looks and feels like you.",
    items: ["Brand-matched colours & fonts", "Mobile-first layouts", "Modern, clean aesthetics", "Competitor differentiation"],
  },
  {
    icon: "⚡",
    title: "WordPress or Custom Build",
    desc: "Most of our builds use WordPress, reliable, flexible, and easy to update. We also build fully custom sites when your project needs something beyond off-the-shelf. No lock-in either way.",
    items: ["Easy content editing", "WordPress or custom CMS", "WooCommerce ready", "Scales as you grow"],
  },
  {
    icon: "🔍",
    title: "SEO-Ready From Day One",
    desc: "Every page we build is structured for search engines. Speed, mobile performance, schema markup, and proper heading structure, all standard.",
    items: ["Fast page speed", "Proper meta tags", "Schema markup", "Google Search Console setup"],
  },
  {
    icon: "📱",
    title: "Mobile Optimised",
    desc: "Over 60% of your traffic is on mobile. We build mobile-first and test across devices so your site works perfectly on every screen.",
    items: ["Responsive layouts", "Touch-friendly navigation", "Mobile page speed", "Cross-device testing"],
  },
  {
    icon: "🔒",
    title: "Secure & Reliable",
    desc: "SSL certificates, regular backups, security hardening, and managed hosting. We handle the technical side so you can focus on your business.",
    items: ["SSL included", "Daily backups", "Uptime monitoring", "Security hardening"],
  },
  {
    icon: "📞",
    title: "Lead-Generation Focus",
    desc: "Your website should be working for you 24/7. We design with clear calls-to-action, fast-loading pages, and conversion-tested layouts.",
    items: ["CTA strategy", "Contact form setup", "Click-to-call integration", "Enquiry tracking"],
  },
];

const industries = [
  { icon: "Wrench",        title: "Tradies",               desc: "Plumbers, electricians, builders, painters. We know what converts for trade businesses in Auckland.", href: "/tradie-website-design-auckland/" },
  { icon: "Sparkles",      title: "Beauty & Wellness",     desc: "Salons, spas, clinics. Booking-integrated sites that showcase your services and keep the chair full.", href: "/how-kiwi-web-design-helps-auckland-beauty-industry/" },
  { icon: "UtensilsCrossed", title: "Restaurants & Cafés", desc: "Menu pages, booking links, Google Maps integration. Hungry customers find you first.", href: "/how-kiwi-web-design-helps-auckland-restaurants/" },
  { icon: "HeartPulse",    title: "Healthcare",             desc: "Physios, dentists, GPs. HIPAA-aware design with online booking and clear service pages.", href: "/how-kiwi-web-design-helps-auckland-healthcare/" },
  { icon: "Briefcase",     title: "Professional Services",  desc: "Lawyers, accountants, consultants. Authority-building design that wins the trust of new clients.", href: "/how-kiwi-web-design-helps-auckand-lawyers/" },
  { icon: "ShoppingCart",  title: "eCommerce & Retail",     desc: "WooCommerce and Shopify stores built to sell. Product pages, checkout flow, and payment gateway setup.", href: "/ecommerce-website-auckland/" },
];

const process = [
  { step: "1", title: "Free Discovery Call", desc: "We start with a conversation, not a quote. We learn about your business, your customers, and what success looks like for you." },
  { step: "2", title: "Strategy & Wireframe", desc: "We map out the site structure, page layout, and content plan. You approve the direction before any design begins." },
  { step: "3", title: "Design & Build", desc: "We design and build your site, on WordPress or a custom platform, depending on your needs. You get a staging link to review and request changes before launch." },
  { step: "4", title: "Launch & Handover", desc: "We go live, set up Google Search Console and Analytics, and walk you through how to make basic updates yourself." },
];

const faqs = [
  { q: "How much does a website cost for a small business in Auckland?", a: "Every project gets a fixed, custom quote based on your pages, features, and platform, no published price list and no surprises. Most sites are built on <a href=\"/wordpress-website-design-auckland/\">WordPress</a>, though we also offer fully custom builds when your project needs it. Book a free consultation for an exact quote, or try our <a href=\"/affordable-web-design-auckland/website-cost-new-zealand-small-business/\">free website cost calculator</a> for a ballpark estimate." },
  { q: "How long does it take to build a website?", a: "Most projects are completed in 2–3 weeks from when we receive your content. More complex sites with custom features may take 4–6 weeks. We'll give you a timeline upfront and stick to it. See our full <a href=\"/website-design-process-in-auckland/\">website design process</a> for a step-by-step breakdown." },
  { q: "Do I need to provide content?", a: "Ideally yes, you know your business best. But we help with content guidance, structure, and can write copy for you as an add-on. We also source or licence stock images if needed." },
  { q: "Will I be able to update the website myself?", a: "Yes. WordPress sites are easy to manage without a developer, we include a handover session on every project. For custom builds, we set up the right editing tools for your team. Ongoing maintenance plans are available if you'd prefer we handle updates." },
  { q: "Do you offer hosting and maintenance?", a: "Yes. We offer managed hosting covering updates, backups, security, and monthly content changes. Ask us about pricing and bundling it with your build." },
  { q: "Can you redesign my existing website?", a: "Yes. We do full rebuilds, redesigns, and migrations from Wix, Squarespace, old WordPress themes, or any other platform. We also build bespoke sites from scratch when a standard CMS isn't the right fit. We preserve your <a href=\"/affordable-seo-auckland/\">SEO</a> and content throughout. After launch, consider adding <a href=\"/local-seo-for-auckland-small-businesses/\">local SEO</a> or <a href=\"/google-ads/\">Google Ads</a> to drive traffic." },
];

// Verbatim 5-star Google reviews (kiwiwebdesign.co.nz Business Profile). Shared with the homepage.
const reviews = [
  { name: "Eduardo Arnez", company: "Aesthetic Painting & Deco", text: "Charlie from Kiwi Web Design did an outstanding job designing our website. He was incredibly helpful throughout the entire process, offering great ideas and maintaining excellent communication. We're extremely happy with both the look and functionality of the final result. Highly recommend!" },
  { name: "Francesco Moretti", text: "Kiwi Web Design doesn't just build website, they actually focus on getting you found online. Their approach to SEO and AI search made a big difference for us. We're now showing up in more places and getting more enquires." },
  { name: "Charles Haddix", avatar: "/images/reviews/charles-haddix.png", text: "We recently got our website rebuilt by Kiwi Web Design in Auckland, and honestly, it was such a good experience. Charlie made everything really easy to understand and kept us in the loop the whole way through. The new site looks great on both phone and desktop, and we've already noticed more people finding us on Google and getting in touch. Couldn't recommend Kiwi Web Design enough if you're after an affordable, professional web designer in Auckland." },
  { name: "Deborah Shaw", company: "Deborah Shaw Editing", avatar: "/images/reviews/deborah-shaw.png", text: "Charlie is fantastic to work with! I got stuck fiddling around with WordPress blocks, but Charlie came to the rescue. He understood what I was wanting with my website and made my ideas come together. Thank you!" },
  { name: "Zane Barrett", company: "Barrett Access Scaffolding", text: "We recently worked with Kiwiweb to design and launch our new website, and we couldn't be happier with the results. The team was professional, responsive, and really took the time to understand our business. They helped us create a modern, easy-to-navigate site and incorporated some amazing features, including a scaffold cost calculator – the first of its kind in NZ! This has already set us apart in our industry and made quoting so much easier for our clients. Communication was clear and efficient throughout, and any tweaks we needed were handled quickly. I highly recommend Kiwiweb to anyone looking for a web design team that delivers both creativity and functionality." },
  { name: "Steven Liu", company: "Kiwiland Constructions", avatar: "/images/reviews/steven-liu.png", text: "Outstanding Experience with Kiwi Web Design and Charlie! I couldn't be happier with the website that Kiwi Web Design created for me. From start to finish, Charlie was professional, responsive, and incredibly easy to work with. He took the time to understand exactly what I wanted, offered helpful suggestions, and delivered a final product that exceeded my expectations. The design is clean, modern, and user-friendly — exactly what I was hoping for. Charlie made the whole process smooth and stress-free, and he was always quick to answer any questions I had. His attention to detail and commitment to quality really stood out. If you're looking for a reliable, talented web designer who truly cares about your vision, I highly recommend Kiwi Web Design and Charlie. Five stars all the way!" },
  { name: "Jack at Show Me Shorts", avatar: "/images/reviews/jack-show-me-shorts.png", text: "Kiwi Web Design were fantastic to work with. From the very beginning they really took the time to understand what I needed and offered smart, practical solutions. The team were professional, friendly and quick to respond whenever I had questions. If you're looking for a reliable, creative, and genuinely helpful web design team in New Zealand, I'd definitely recommend Kiwi Web Design." },
  { name: "Tony S", company: "Streetfood Network", avatar: "/images/reviews/tony-s.png", text: "Charlie from Kiwi Web Design has been great to work with. He communicates clearly, responds promptly, and makes the process easy to understand. The pricing has been reasonable, and I've appreciated his practical approach to building and improving our Streetfood Network website. I would recommend Kiwi Web Design to any small business looking for reliable website support. Business has since taken off and the Website is amazing!" },
  { name: "Iby V.", company: "Yoga Teacher", text: "Charlie from Kiwi Web Design helped me design a flyer for my studio, and I'm really happy with the result. He was easy to communicate with, understood what I needed, and created something professional, clean, and aligned with the feeling of my business. The process was smooth and thoughtful, and I appreciated the care he put into making the flyer look polished and effective. I'd happily recommend Charlie and Kiwi Web Design to any small business owner who needs help with design, websites, or digital marketing." },
  { name: "Elisabeth Krull", text: "Kiwi Web Design is helping me with an international website. I can highly recommend working with Charlie — both professionally and personally!" },
  { name: "Gina Dellabarca", company: "Showme Short Film Festival", avatar: "/images/reviews/gina-dellabarca.png", text: "They provided a comprehensive and helpful website audit for us. Clear information. Great communication." },
  { name: "Dave G", text: "Charlie was very responsive to my concerns and demonstrated a strong understanding of the issues I raised. Excellent service and support — thank you." },
];

// Full-colour Google "G" logo (official 4-colour mark).
const googleG = '<path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/><path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/><path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>';
const avatarColors = ['#d93b8f', '#5b8def', '#8b5cf6', '#0ea5a4', '#e0672c', '#3f7d4f', '#c0392b', '#2f6f9f'];
---

<Layout
  title="Small Business Website Design Auckland | Kiwi Web Design"
  description="Custom websites for Auckland small businesses. WordPress or fully custom build, lead-focused, live in 2–3 weeks. Free consultation. Call 021 039 6580."
  canonicalURL="https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/"
  schema={schema}
  alternateUrl="https://www.kiwiwebdesign.co.nz/zh/small-business-website-design-auckland/"
>

  <PageHero
    eyebrow="Small Business Web Design Auckland"
    title="Websites built to generate leads. Not just look good."
    subtitle="Custom websites for Auckland small businesses and tradies, WordPress or fully custom, delivered in 2–3 weeks, with a free in-person consult."
    badgeText="Free consultation, no obligation"
    ctaPrimary={{ text: "Get a Free Quote", href: "/contact/" }}
    ctaSecondary={{ text: "See How It Works", href: "#process" }}
    centered={true}
  />

  <!-- AI citability snippet -->
  <div class="smb-snippet">
    <div class="container">
      <p><strong>Kiwi Web Design</strong> builds custom websites for Auckland small businesses, using the platform that best fits the project. Most projects go live in <strong>2–3 weeks</strong>. Every website includes mobile-first design, SEO foundations, contact form, Google Analytics, and a handover training session. Every quote is fixed and tailored to the project, no published price list, no surprises. Based in Grey Lynn, Auckland, with a 5★ Google rating.</p>
    </div>
  </div>

  <!-- Stats -->
  <StatsRow items={stats} />

  <!-- What's included -->
  <section class="section" style="background: var(--kwd-cream);">
    <div class="container">
      <SectionHeader
        eyebrow="What's Included"
        title="Everything your business needs. Nothing you don't."
        subtitle="Every website we build includes these fundamentals, because cutting corners costs you leads."
      />
      <ServiceGrid items={included} cols={3} />
    </div>
  </section>

  <!-- Visual break, who we help -->
  <section class="sbwd-who-section">
    <div class="sbwd-who-img-wrap">
      <Image src={smallBizAuckland} alt="Auckland small business owner at work, the kind of business we build websites for" width={800} height={560} class="sbwd-who-img" />
    </div>
    <div class="sbwd-who-content">
      <p class="sbwd-who-eyebrow">Built for Auckland</p>
      <h2 class="sbwd-who-title">Your customers are searching online. Are you showing up?</h2>
      <p class="sbwd-who-body">Most small business websites in Auckland are losing leads every day, slow, outdated, or just hard to find. We build websites that rank on Google, load fast, and turn visitors into enquiries. Whether you're a café, a tradie, or a professional service, the result is the same: more customers.</p>
      <a href="/contact/" class="sbwd-who-cta">Get a Free Quote →</a>
    </div>
  </section>

  <!-- Industries -->
  <section class="section" style="background: var(--kwd-dark);">
    <div class="container">
      <SectionHeader
        eyebrow="Industries We Serve"
        title="We know your industry. We know what converts."
        light={true}
      />
      <div class="sbwd-industries">
        {industries.map(({ icon, title, desc, href }) => (
          <a href={href} class="sbwd-ind-card">
            <span class="sbwd-ind-icon"><Icon name={icon} size={26} /></span>
            <div>
              <strong class="sbwd-ind-title">{title}</strong>
              <p class="sbwd-ind-desc">{desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section sbwd-process-section" id="process">
    <div class="container">
      <div class="sbwd-process-split">
        <div class="sbwd-process-content">
          <SectionHeader
            eyebrow="How It Works"
            title="Simple process. Predictable results."
            subtitle="We keep things clear and collaborative, you always know what's happening and what's next."
          />
          <ProcessSteps items={process} />
        </div>
        <div class="sbwd-process-img-wrap">
          <Image src={about1} alt="Charlie Chao consulting with an Auckland small business owner on their website strategy" width={600} height={700} class="sbwd-process-img" />
          <div class="sbwd-process-img-pill">Free in-person consult · Auckland-based</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Web design visual -->
  <section class="sbwd-info-split section">
    <div class="container">
      <div class="sbwd-info-img-wrap">
        <Image src={webSolutions} alt="Web designer building an Auckland small business website" width={1200} height={480} class="sbwd-info-img" />
        <div class="sbwd-info-img-badge">
          <span class="sbwd-info-badge-num">2–3 wks</span>
          <span class="sbwd-info-badge-label">avg. delivery</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo band with pull-quote -->
  <div class="sbwd-testimonials-photo">
    <Image src={about2} alt="Kiwi Web Design Auckland, helping small businesses grow online" width={1400} height={480} class="sbwd-tp-img" />
    <div class="sbwd-tp-overlay">
      <blockquote class="sbwd-tp-quote">
        "From the first call, Charlie understood exactly what we needed. The site was live in 2 weeks and we got our first enquiry the day after launch."
        <cite>- Zane Barrett, Barrett Access Scaffolding</cite>
      </blockquote>
    </div>
  </div>

  <!-- Google reviews carousel — matches homepage treatment -->
  <section class="section sbwd-reviews-section" id="reviews">
    <div class="container">
      <div class="lp-reviews-head">
        <span class="lp-reviews-badge">
          <svg class="lp-g" viewBox="0 0 48 48" aria-hidden="true" set:html={googleG} />
          <span class="lp-review-stars" aria-hidden="true">★★★★★</span>
          <strong>5.0</strong>
          <span class="lp-reviews-count">on Google Reviews</span>
        </span>
        <h2 class="lp-reviews-title">What Auckland business owners say.</h2>
      </div>
      <div class="lp-carousel">
        <button type="button" class="lp-carousel-btn lp-carousel-prev" id="sbwd-rev-prev" aria-label="Previous reviews">‹</button>
        <div class="lp-carousel-track" id="sbwd-reviews-track">
          {reviews.map(({ name, company, avatar, text }, i) => (
            <figure class="lp-review-card">
              <div class="lp-review-top">
                <svg class="lp-g" viewBox="0 0 48 48" aria-hidden="true" set:html={googleG} />
                <span class="lp-review-stars" aria-label="Rated 5 out of 5">★★★★★</span>
              </div>
              <div class="lp-review-textwrap">
                <p class="lp-review-text">{text}</p>
                <button type="button" class="lp-review-more" hidden>Read more</button>
              </div>
              <figcaption class="lp-review-foot">
                {avatar ? (
                  <img class="lp-review-avatar" src={avatar} alt={`${name} avatar`} loading="lazy" width="40" height="40" />
                ) : (
                  <span class="lp-review-avatar" style={`background:${avatarColors[i % avatarColors.length]}`}>{name.charAt(0)}</span>
                )}
                <span class="lp-review-who">
                  <span class="lp-review-name">{name}</span>
                  {company && <span class="lp-review-co">{company}</span>}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
        <button type="button" class="lp-carousel-btn lp-carousel-next" id="sbwd-rev-next" aria-label="Next reviews">›</button>
      </div>
    </div>
  </section>

  <script>
    // Reviews carousel: one card per step, loops, auto-advances. Matches homepage treatment.
    (() => {
      function initReviewClamp() {
        document.querySelectorAll<HTMLElement>('.lp-review-card').forEach((card) => {
          if (card.dataset.clampInit) return;
          const textEl = card.querySelector<HTMLElement>('.lp-review-text');
          const moreBtn = card.querySelector<HTMLButtonElement>('.lp-review-more');
          if (!textEl || !moreBtn) return;
          card.dataset.clampInit = '1';
          if (textEl.scrollHeight - textEl.clientHeight > 4) {
            moreBtn.hidden = false;
            moreBtn.addEventListener('click', () => {
              const expanded = card.classList.toggle('is-expanded');
              moreBtn.textContent = expanded ? 'Read less' : 'Read more';
            });
          }
        });
      }
      const fontsApi = (document as Document & { fonts?: FontFaceSet }).fonts;
      if (fontsApi?.ready) { fontsApi.ready.then(initReviewClamp); } else { initReviewClamp(); }

      const track = document.getElementById('sbwd-reviews-track');
      const prevBtn = document.getElementById('sbwd-rev-prev') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('sbwd-rev-next') as HTMLButtonElement | null;
      if (!track || !prevBtn || !nextBtn) return;

      const stepBy = () => {
        const card = track.querySelector<HTMLElement>('.lp-review-card');
        return card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.9;
      };
      const maxScroll = () => track.scrollWidth - track.clientWidth;
      const advance = (dir: 1 | -1) => {
        if (dir === 1 && track.scrollLeft >= maxScroll() - 2) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else if (dir === -1 && track.scrollLeft <= 2) {
          track.scrollTo({ left: maxScroll(), behavior: 'smooth' });
        } else {
          track.scrollBy({ left: dir * stepBy(), behavior: 'smooth' });
        }
      };

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let autoplayTimer: ReturnType<typeof setInterval> | null = null;
      const stopAutoplay = () => { if (autoplayTimer) { clearInterval(autoplayTimer); autoplayTimer = null; } };
      const startAutoplay = () => {
        if (prefersReducedMotion || autoplayTimer) return;
        autoplayTimer = setInterval(() => advance(1), 4500);
      };
      const restartAutoplay = () => { stopAutoplay(); startAutoplay(); };

      prevBtn.addEventListener('click', () => { advance(-1); restartAutoplay(); });
      nextBtn.addEventListener('click', () => { advance(1); restartAutoplay(); });
      track.addEventListener('mouseenter', stopAutoplay);
      track.addEventListener('mouseleave', startAutoplay);
      track.addEventListener('touchstart', stopAutoplay, { passive: true });
      track.addEventListener('touchend', () => { stopAutoplay(); setTimeout(startAutoplay, 3000); }, { passive: true });

      startAutoplay();
    })();
  </script>

