---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import StatsRow from '../components/StatsRow.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTABanner from '../components/CTABanner.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import GoogleReviewCarousel from '../components/GoogleReviewCarousel.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import about1 from '../assets/general/about1.jpg';
import about2 from '../assets/general/about2.jpg';
import smallBizAuckland from '../assets/general/Small-Business-Auckland.jpg';
import webSolutions from '../assets/general/Website-Solutsions-Auckland.jpg';
import aucklandCafe from '../assets/general/Auckland-small-business-1.jpg';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/",
      "url": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/",
      "name": "Small Business Website Design Auckland | Packages & Pricing",
      "description": "Website design packages for Auckland small businesses and tradies. Built to generate leads, live in 2–3 weeks. Free in-person consultation. Call 021 039 6580.",
      "inLanguage": "en-NZ",
      "isPartOf": { "@id": "https://www.kiwiwebdesign.co.nz/#website" },
      "about": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "breadcrumb": { "@id": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/#breadcrumb" },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".smb-snippet", ".stats-row"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.kiwiwebdesign.co.nz/" },
        { "@type": "ListItem", "position": 2, "name": "Small Business Web Design Auckland", "item": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/" }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/#service",
      "name": "Small Business Website Design Auckland",
      "serviceType": "Website Design",
      "category": "Web Development",
      "description": "Custom website design for Auckland small businesses. Conversion-focused, mobile-first, delivered in 2–3 weeks. WordPress or custom build.",
      "provider": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "areaServed": [
        { "@type": "City", "name": "Auckland" },
        { "@type": "Country", "name": "New Zealand" }
      ],
      "url": "https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/"
    },
    {
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": "https://www.kiwiwebdesign.co.nz/#organization",
      "name": "Kiwi Web Design",
      "alternateName": "Small Business Website Design Auckland",
      "url": "https://www.kiwiwebdesign.co.nz/",
      "telephone": "+64-21-039-6580",
      "email": "hi@kiwiwebdesign.co.nz",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "147 Great North Road",
        "addressLocality": "Grey Lynn",
        "addressRegion": "Auckland",
        "postalCode": "1021",
        "addressCountry": "NZ"
      },
      "areaServed": [
        { "@type": "City", "name": "Auckland" },
        { "@type": "Country", "name": "New Zealand" }
      ],
      "priceRange": "$$",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.kiwiwebdesign.co.nz/favicon.png",
        "width": 512,
        "height": 512
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does a website cost for a small business in Auckland?",
          "acceptedAnswer": { "@type": "Answer", "text": "Every project gets a fixed, custom quote based on your pages, features, and platform, no surprises. Most Auckland small business sites are built on WordPress, though we also deliver fully custom builds depending on your needs. Book a free consultation for an exact quote." }
        },
        {
          "@type": "Question",
          "name": "How long does it take to build a website?",
          "acceptedAnswer": { "@type": "Answer", "text": "Most projects are completed in 2–3 weeks from when content is received. More complex sites with custom features may take 3–4 weeks. A timeline is provided upfront." }
        },
        {
          "@type": "Question",
          "name": "Will I be able to update the website myself?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. WordPress sites are easy to update without a developer. For custom builds we set up the right editing tools for your needs. A handover session is included with every project. Monthly maintenance plans are also available." }
        },
        {
          "@type": "Question",
          "name": "Do you offer hosting and maintenance for Auckland small businesses?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Managed hosting is available and includes updates, backups, security, and monthly content changes. Ask us for hosting pricing when you get your quote." }
        },
        {
          "@type": "Question",
          "name": "Can you redesign my existing website?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Full rebuilds, redesigns, and migrations from Wix, Squarespace, or old WordPress themes are all available. We also build from scratch on custom platforms where needed. SEO and content are preserved during the process." }
        },
        {
          "@type": "Question",
          "name": "Do you build websites for small businesses outside Auckland?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. While based in Grey Lynn, Auckland, we build websites for small businesses across New Zealand via video call. Auckland clients can always meet in person." }
        }
      ]
    }
  ]
};

const stats = [
  { number: "Free", label: "Discovery call, no obligation" },
  { number: "2–3 wks", label: "Typical delivery time" },
  { number: "50+", label: "Auckland businesses helped" },
  { number: "5★", label: "Average Google rating" },
];

const included = [
  {
    icon: "🎨",
    title: "Custom Design",
    desc: "No cookie-cutter templates. Your website is designed around your brand, your customers, and your goals, so it looks and feels like you.",
    items: ["Brand-matched colours & fonts", "Mobile-first layouts", "Modern, clean aesthetics", "Competitor differentiation"],
  },
  {
    icon: "⚡",
    title: "WordPress or Custom Build",
    desc: "Most of our builds use WordPress, reliable, flexible, and easy to update. We also build fully custom sites when your project needs something beyond off-the-shelf. No lock-in either way.",
    items: ["Easy content editing", "WordPress or custom CMS", "WooCommerce ready", "Scales as you grow"],
  },
  {
    icon: "🔍",
    title: "SEO-Ready From Day One",
    desc: "Every page we build is structured for search engines. Speed, mobile performance, schema markup, and proper heading structure, all standard.",
    items: ["Fast page speed", "Proper meta tags", "Schema markup", "Google search foundation setup"],
  },
  {
    icon: "📱",
    title: "Mobile Optimised",
    desc: "Over 60% of your traffic is on mobile. We build mobile-first and test across devices so your site works perfectly on every screen.",
    items: ["Responsive layouts", "Touch-friendly navigation", "Mobile page speed", "Cross-device testing"],
  },
  {
    icon: "🔒",
    title: "Secure & Reliable",
    desc: "SSL certificates, regular backups, security hardening, and managed hosting. We handle the technical side so you can focus on your business.",
    items: ["SSL included", "Daily backups", "Uptime monitoring", "Security hardening"],
  },
  {
    icon: "📞",
    title: "Lead-Generation Focus",
    desc: "Your website should be working for you 24/7. We design with clear calls-to-action, fast-loading pages, and conversion-tested layouts.",
    items: ["CTA strategy", "Contact form setup", "Click-to-call integration", "Enquiry optimisation"],
  },
];

const industries = [
  { icon: "Wrench",        title: "Tradies",               desc: "Plumbers, electricians, builders, painters. We know what converts for trade businesses in Auckland.", href: "/tradie-website-design-auckland/" },
  { icon: "Sparkles",      title: "Beauty & Wellness",     desc: "Salons, spas, clinics. Booking-integrated sites that showcase your services and keep the chair full.", href: "/how-kiwi-web-design-helps-auckland-beauty-industry/" },
  { icon: "UtensilsCrossed", title: "Restaurants & Cafés", desc: "Menu pages, booking links, Google Maps integration. Hungry customers find you first.", href: "/how-kiwi-web-design-helps-auckland-restaurants/" },
  { icon: "HeartPulse",    title: "Healthcare",             desc: "Physios, dentists, GPs. HIPAA-aware design with online booking and clear service pages.", href: "/how-kiwi-web-design-helps-auckland-healthcare/" },
  { icon: "Briefcase",     title: "Professional Services",  desc: "Lawyers, accountants, consultants. Authority-building design that wins the trust of new clients.", href: "/how-kiwi-web-design-helps-auckland-lawyers/" },
  { icon: "ShoppingCart",  title: "eCommerce & Retail",     desc: "WooCommerce and Shopify stores built to sell. Product pages, checkout flow, and payment gateway setup.", href: "/ecommerce-website-auckland/" },
];

const process = [
  { step: "1", title: "Free Discovery Call", desc: "We start with a conversation, not a quote. We learn about your business, your customers, and what success looks like for you." },
  { step: "2", title: "Strategy & Sitemap", desc: "We map out the site structure, page layout, and content plan. You approve the direction before any design begins." },
  { step: "3", title: "Design & Build", desc: "We design and build your site, on WordPress or a custom platform, depending on your needs. You get a staging link to review and request changes before launch." },
  { step: "4", title: "Launch & Go Live", desc: "We go live after your approval." },
];

const faqs = [
  { q: "How much does a website cost for a small business in Auckland?", a: "Every project gets a fixed, custom quote based on your pages, features, and platform, no surprises. Most sites are built on <a href=\"/wordpress-website-design-auckland/\">WordPress</a>, though we also offer fully custom builds when your project needs it. Book a free consultation for an exact quote, or try our <a href=\"/affordable-web-design-auckland/website-cost-new-zealand-small-business/\">free website cost calculator</a> for a ballpark estimate." },
  { q: "How long does it take to build a website?", a: "Most projects are completed in 2–3 weeks from when we receive your content. More complex sites with custom features may take 3–4 weeks. We'll give you a timeline upfront and stick to it. See our full <a href=\"/website-design-process-in-auckland/\">website design process</a> for a step-by-step breakdown." },
  { q: "Do I need to provide content?", a: "Ideally yes, you know your business best. But we help with content guidance, structure, and can write draft copy for you. We also source stock images if needed." },
  { q: "Will I be able to update the website myself?", a: " We offer ongoing maintenance plans for most of our clients which including content updates monthly. But if you prefer to manage yourself, this can be done through WordPress CMS. " },
  { q: "Do you offer hosting and maintenance?", a: "Yes. We offer managed hosting covering updates, backups, security, and monthly content changes. Ask us about pricing and bundling it with your build." },
  { q: "Can you redesign my existing website?", a: "Yes. We do full rebuilds, redesigns, and migrations from Wix, Squarespace, old WordPress themes, or any other platform. We also build bespoke sites from scratch when a standard CMS isn't the right fit. We preserve your <a href=\"/affordable-seo-auckland/\">SEO</a> and content throughout. After launch, consider adding <a href=\"/local-seo-for-auckland-small-businesses/\">local SEO</a> or <a href=\"/google-ads/\">Google Ads</a> to drive traffic." },
  { q: "Do you build websites for small businesses outside Auckland?", a: "Yes. We're based in Grey Lynn but build websites for small businesses across New Zealand via video call. Auckland clients can always meet in person if preferred." },
];

// Web design hub: every page in the web design cluster hangs off this one.
// The homepage is the digital marketing hub above the three pillars;
// /affordable-web-design-auckland/ holds the "web design Auckland" head term
// and is deliberately untouched, so this page does the structural work.
const hubGroups = [
  {
    heading: "Website types and platforms",
    links: [
      { label: "WordPress website design", href: "/wordpress-website-design-auckland/" },
      { label: "Shopify website design", href: "/shopify-website-design-auckland/" },
      { label: "WooCommerce website design", href: "/woocommerce-website-design-auckland/" },
      { label: "eCommerce websites", href: "/ecommerce-website-auckland/" },
      { label: "Tradie websites", href: "/tradie-website-design-auckland/" },
      { label: "Booking and appointment websites", href: "/booking-appointment-websites-with-wordpress/" },
      { label: "Membership and subscription websites", href: "/membership-subscription-websites-with-wordpress-auckland/" },
      { label: "Landing pages and funnels", href: "/landing-pages-funnels-on-wordpress/" },
      { label: "Website rebuilds", href: "/wordpress-website-rebuilds-auckland/" },
    ],
  },
  {
    heading: "Design, content and setup",
    links: [
      { label: "Website branding", href: "/website-branding/" },
      { label: "Website copywriting", href: "/website-copywriting-auckland/" },
      { label: "Our design process", href: "/website-design-process-in-auckland/" },
      { label: "WordPress theme selection", href: "/wordpress-themes-for-auckland-small-businesses/" },
      { label: "WordPress plugins", href: "/wordpress-plugins-for-small-businesses-in-auckland/" },
      { label: "WordPress and AI tools", href: "/wordpress-ai-tools-integration-auckland/" },
      { label: "AI content setup", href: "/ai-content-setup-for-websites/" },
    ],
  },
  {
    heading: "Industries we build for",
    links: [
      { label: "All industries we serve", href: "/industries-we-serve-in-auckland/" },
      { label: "Lawyers and legal firms", href: "/how-kiwi-web-design-helps-auckland-lawyers/" },
      { label: "Healthcare and clinics", href: "/how-kiwi-web-design-helps-auckland-healthcare/" },
      { label: "Restaurants and cafes", href: "/how-kiwi-web-design-helps-auckland-restaurants/" },
      { label: "Beauty and wellness", href: "/how-kiwi-web-design-helps-auckland-beauty-industry/" },
    ],
  },
  {
    heading: "Areas we serve",
    links: [
      { label: "All Auckland areas", href: "/areas-we-serve/" },
      { label: "Central Auckland", href: "/central-auckland-web-design/" },
      { label: "North Shore", href: "/north-shore-website-design/" },
      { label: "West Auckland", href: "/west-auckland-web-design/" },
      { label: "South Auckland", href: "/south-auckland-web-design/" },
      { label: "East Auckland", href: "/east-auckland-web-design/" },
    ],
  },
  {
    heading: "Client case studies",
    links: [
      { label: "All case studies", href: "/case-studies/" },
      { label: "Barrett Access Scaffolding", href: "/case-study-scaffolding/" },
      { label: "Kiwiland Construction", href: "/kiwiland-construction-website/" },
      { label: "Beauty Touch", href: "/beauty-touch-case-study/" },
      { label: "La Veranda Restaurant", href: "/la-veranda-restaurant-website/" },
      { label: "Melanoma Specialists", href: "/melanoma-specialists-website/" },
      { label: "FL Legal", href: "/fl-legal-website/" },
      { label: "Inspector Guys Building Inspections", href: "/inspector-guys-building-inspections-website/" },
      { label: "Dryice Blasting Services", href: "/dryice-blasting-services-website/" },
      { label: "Topline Services", href: "/topline-services-cleaning-website/" },
    ],
  },
  {
    heading: "After your site is live",
    links: [
      { label: "Website care plan", href: "/monthly-subscription/" },
      { label: "Website hosting", href: "/website-hosting-auckland/" },
      { label: "Domain management", href: "/domain-management-auckland/" },
      { label: "Business email setup", href: "/email-setup-business-email-hosting/" },
    ],
  },
];

---

<Layout
  title="Small Business Website Design Auckland | Packages & Pricing"
  description="Website design packages for Auckland small businesses and tradies. WordPress or fully custom build, lead-focused, live in 2–3 weeks. Free consultation. Call 021 039 6580."
  canonicalURL="https://www.kiwiwebdesign.co.nz/small-business-website-design-auckland/"
  schema={schema}
  alternateUrl="https://www.kiwiwebdesign.co.nz/zh/small-business-website-design-auckland/"
>

  <PageHero
    eyebrow="Small Business Web Design Auckland"
    title="Small business websites built to generate leads"
    subtitle="Custom websites for Auckland small businesses and tradies, WordPress or fully custom, delivered in 2–3 weeks, with a free consultation."
    badgeText="Free consultation, no obligation"
    ctaPrimary={{ text: "Get a Free Quote", href: "/contact/" }}
    ctaSecondary={{ text: "See How It Works", href: "#process" }}
    centered={true}
  />

  <!-- AI citability snippet -->
  <div class="smb-snippet">
    <div class="container">
      <p><strong>Kiwi Web Design</strong> builds custom websites for Auckland small businesses, using the platform that best fits the project. Most projects go live in <strong>2–3 weeks</strong>. Every website includes mobile-first design, SEO foundations, contact form, and a handover training session. Every quote is fixed and tailored to the project, fixed price upfront, no surprises. Based in Grey Lynn, Auckland, with 5★ Google ratings.</p>
    </div>
  </div>

  <!-- Stats -->
  <StatsRow items={stats} />

  <!-- What's included -->
  <section class="section" style="background: var(--kwd-cream);">
    <div class="container">
      <SectionHeader
        eyebrow="What's Included"
        title="Everything your business needs, nothing you don't"
        subtitle="Every website we build includes these fundamentals, because cutting corners costs you leads."
      />
      <ServiceGrid items={included} cols={3} />
    </div>
  </section>

  <!-- Visual break, who we help -->
  <section class="sbwd-who-section">
    <div class="sbwd-who-img-wrap">
      <Image src={smallBizAuckland} alt="Auckland small business owner at work, the kind of business we build websites for" width={800} height={560} class="sbwd-who-img" />
    </div>
    <div class="sbwd-who-content">
      <p class="sbwd-who-eyebrow">Built for Auckland</p>
      <h2 class="sbwd-who-title">Your customers are searching online. Are you showing up?</h2>
      <p class="sbwd-who-body">Most small business websites in Auckland are losing leads every day, slow, outdated, or just hard to find. We build websites that rank on Google and ChatGPT, load fast, and turn visitors into enquiries. Whether you're a café, a tradie, or a professional service, the result is the same: more customers.</p>
      <a href="/contact/" class="sbwd-who-cta">Get a Free Quote →</a>
    </div>
  </section>

  <!-- Industries -->
  <section class="section" style="background: var(--kwd-dark);">
    <div class="container">
      <SectionHeader
        eyebrow="Industries We Serve"
        title="We know your industry, and what converts"
        light={true}
      />
      <div class="sbwd-industries">
        {industries.map(({ icon, title, desc, href }) => (
          <a href={href} class="sbwd-ind-card">
            <span class="sbwd-ind-icon"><Icon name={icon} size={26} /></span>
            <div>
              <strong class="sbwd-ind-title">{title}</strong>
              <p class="sbwd-ind-desc">{desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section sbwd-process-section" id="process">
    <div class="container">
      <div class="sbwd-process-split">
        <div class="sbwd-process-content">
          <SectionHeader
            eyebrow="How It Works"
            title="Simple process. Predictable results"
            subtitle="We keep things clear and collaborative, you always know what's happening and what's next."
          />
          <ProcessSteps items={process} />
        </div>
        <div class="sbwd-process-img-wrap">
          <Image src={about1} alt="Charlie Chao consulting with an Auckland small business owner on their website strategy" width={600} height={700} class="sbwd-process-img" />
          <div class="sbwd-process-img-pill">Free in-person consult · Auckland-based</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Web design visual -->
  <section class="sbwd-info-split section">
    <div class="container">
      <div class="sbwd-info-img-wrap">
        <Image src={webSolutions} alt="Web designer building an Auckland small business website" width={1200} height={480} class="sbwd-info-img" />
        <div class="sbwd-info-img-badge">
          <span class="sbwd-info-badge-num">2–3 wks</span>
          <span class="sbwd-info-badge-label">avg. delivery</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo band with pull-quote -->
  <div class="sbwd-testimonials-photo">
    <Image src={about2} alt="Kiwi Web Design Auckland, helping small businesses grow online" width={1400} height={480} class="sbwd-tp-img" />
    <div class="sbwd-tp-overlay">
      <blockquote class="sbwd-tp-quote">
        "From the first call, Charlie understood exactly what we needed. The site was live in 2 weeks and we got our first enquiry the day after launch."
        <cite>- Zane Barrett, Barrett Access Scaffolding</cite>
      </blockquote>
    </div>
  </div>

  <GoogleReviewCarousel />

  <!-- Auckland café photo strip -->
  <div class="sbwd-cafe-strip">
    <Image src={aucklandCafe} alt="Auckland small business, the kind of local business we help grow online" width={1400} height={420} class="sbwd-cafe-img" />
    <div class="sbwd-cafe-overlay">
      <p class="sbwd-cafe-tag">Serving Auckland businesses since 2019</p>
      <p class="sbwd-cafe-line">From Grey Lynn cafés to North Shore tradies, we build websites that work.</p>
    </div>
  </div>

  <!-- FAQ -->
  <section class="section" style="background: var(--kwd-cream);">
    <div class="container" style="max-width: 860px;">
      <FAQAccordion
        items={faqs}
        title="Web Design Questions Answered"
        subtitle="Common questions from Auckland small business owners before getting started."
      />
    </div>
  </section>

  <!-- Web design hub: the full cluster -->
  <section class="section sbwd-hub" id="explore">
    <div class="container">
      <SectionHeader
        eyebrow="Explore"
        title="Everything you need to know about our web design services"
        subtitle="Every part of our web design work, from platform choice to what happens after launch."
      />
      <div class="sbwd-hub-grid">
        {hubGroups.map(({ heading, links }) => (
          <div class="sbwd-hub-group">
            <h3 class="sbwd-hub-heading">{heading}</h3>
            <ul class="sbwd-hub-list">
              {links.map(({ label, href }) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    variant="yellow"
    title="Ready to get a website that generates leads?"
    subtitle="Free consultation, in person or online, Auckland-wide. Call 021 039 6580 or request a quote below."
    ctaPrimary={{ text: "Get a Free Quote", href: "/contact/" }}
    ctaSecondary={{ text: "Learn About SEO Too", href: "/affordable-seo-auckland/" }}
  />

</Layout>

<style>
  /* Industries grid */
  .sbwd-industries {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .sbwd-ind-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 1.5rem;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .sbwd-ind-card:hover {
    background: rgba(255,255,255,0.11);
    border-color: rgba(255,255,255,0.2);
  }
  .sbwd-ind-icon {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--kwd-gold);
  }
  .sbwd-ind-title {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.3rem;
  }
  .sbwd-ind-desc {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.55;
    margin: 0;
  }

  /* Process split with image */
  .sbwd-process-split {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 4rem;
    align-items: start;
  }
  .sbwd-process-img-wrap {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(44,41,39,0.18);
  }
  .sbwd-process-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    display: block;
  }
  .sbwd-process-img-pill {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--kwd-yellow);
    color: var(--kwd-dark);
    font-size: 0.75rem;
