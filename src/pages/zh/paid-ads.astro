---
import PaidAdsServicePage from '../../components/PaidAdsServicePage.astro';

const canonicalURL = 'https://www.kiwiwebdesign.co.nz/zh/paid-ads/';
const alternateUrl = 'https://www.kiwiwebdesign.co.nz/paid-ads/';
const title = '奥克兰付费广告服务 | Google广告与ChatGPT广告 | Kiwi Web Design';
const description = 'Kiwi Web Design 为奥克兰华人中小企业提供付费广告策略，重点包括 Google广告、ChatGPT广告、落地页、转化追踪和清晰报告。';

const faqs = [
  { q: '我应该先做 Google广告 还是 ChatGPT广告？', a: '对大多数奥克兰本地服务企业来说，如果客户已经在主动搜索你的服务，Google广告通常应该先做。ChatGPT广告是较新的渠道，而且新西兰已经可以使用自助式 Ads Manager，所以更适合在基础追踪和落地页准备好之后进行有控制的测试。' },
  { q: '广告预算需要多少？', a: '预算应该根据搜索需求、行业竞争、每个客户的价值、预期转化率和测试速度来定。我们会先看你的市场和业务数据，再给出建议，不在网站上公布一个对所有企业都一样的固定数字。' },
  { q: '你们可以一起做落地页吗？', a: '可以。我们可以把广告连接到更适合转化的页面、表单、电话按钮和追踪系统，让广告不只是带来点击，而是带来可追踪的询盘。' },
  { q: '你们怎么收管理费？', a: '管理费用会根据广告系列复杂度、落地页需求、创意和追踪范围来报价。范围会在开始前确认，广告预算则直接支付给广告平台。' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      inLanguage: 'zh-Hans',
      isPartOf: { '@id': 'https://www.kiwiwebdesign.co.nz/#website' },
      breadcrumb: { '@id': `${canonicalURL}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '中文首页', item: 'https://www.kiwiwebdesign.co.nz/zh/' },
        { '@type': 'ListItem', position: 2, name: '付费广告', item: canonicalURL },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${canonicalURL}#service`,
      name: '奥克兰付费广告服务',
      serviceType: 'Paid Ads Management',
      provider: { '@type': 'LocalBusiness', name: 'Kiwi Web Design', url: 'https://www.kiwiwebdesign.co.nz/' },
      areaServed: { '@type': 'City', name: 'Auckland' },
      description,
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalURL}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<PaidAdsServicePage
  lang="zh-Hans"
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  alternateUrl={alternateUrl}
  schema={schema}
  eyebrow="奥克兰付费广告"
  h1="让广告预算围绕询盘和客户来工作。"
  subtitle="Google广告承接已经在主动搜索的客户。ChatGPT广告提供新的对话式发现渠道。我们把广告、落地页、转化追踪和报告放在同一套系统里规划。"
  badgeText="为奥克兰企业规划 Google广告 与 ChatGPT广告"
  primaryCta={{ text: '预约免费广告咨询', href: '/zh/website-designer-auckland/' }}
  secondaryCta={{ text: '查看 ChatGPT广告', href: '/chatgpt-ads/' }}
  proof={['以询盘为目标', '按业务定制范围', '奥克兰本地服务', '包含转化追踪']}
  snippetLabel="快速答案"
  snippet="Kiwi Web Design 帮助奥克兰中小企业通过 Google广告获取高意向询盘，并在适合的情况下测试 ChatGPT广告。我们会把广告策略、落地页、转化追踪和报告连接起来，再根据真实的询盘质量判断哪个渠道值得继续投入。"
  introEyebrow="渠道策略"
  introTitle="先承接现有搜索需求，再谨慎测试新的AI广告需求。"
  introText="付费广告不是只开一个账户。平台选择、广告信息、落地页、表单、电话按钮和转化追踪都要一起规划，预算才更容易产生可衡量的结果。"
  channels={[
    {
      icon: 'Search',
      title: 'Google广告',
      desc: '当客户已经在 Google 搜索你的服务时，用清晰的广告结构和转化追踪承接高意向流量。',
      href: '/zh/google-ads/',
      label: '查看 Google广告',
      items: ['搜索广告', '本地服务需求', '再营销', '转化追踪'],
    },
    {
      icon: 'Sparkles',
      title: 'ChatGPT广告',
      desc: '围绕客户在对话中比较、研究和做决定的场景，测试新的广告机会，并用落地页和数据判断真实效果。',
      href: '/chatgpt-ads/',
      label: '查看 ChatGPT广告',
      items: ['广告策略', '对话意图研究', '落地页准备', '数据与转化追踪'],
    },
  ]}
  featureEyebrow="我们管理什么"
  featureTitle="广告只是系统的一部分。"
  featureText="很多广告预算浪费在错误页面、模糊信息和没有追踪的表单上。我们会把广告、页面和数据连起来，让优化围绕真实询盘进行。"
  features={[
    { icon: 'Globe', title: '更适合转化的落地页', desc: '广告流量会被导向更清晰、更快速、更能建立信任的页面。' },
    { icon: 'BadgeDollarSign', title: '转化追踪', desc: '电话、表单和重要点击尽量被追踪，让优化围绕真实业务结果。' },
    { icon: 'Sparkles', title: '信息与意图测试', desc: '测试不同卖点、客户问题、关键词和行动按钮，找出更有效的方向。' },
    { icon: 'ClipboardCheck', title: '清晰报告', desc: '说明发生了什么、做了哪些调整、下一步建议是什么，不用复杂术语包装。' },
  ]}
  processEyebrow="我们的流程"
  processTitle="先规划，再上线，然后持续优化。"
  processText="目标不是把广告做复杂，而是让每一笔预算都有清楚目的，并持续改善最影响询盘的部分。"
  process={[
    { icon: 'Search', title: '市场与服务评估', desc: '分析你的服务、竞争对手、网站现状、搜索需求和客户价值。' },
    { icon: 'Map', title: '广告方案', desc: '确定合适渠道、目标、落地页、转化事件和上线顺序。' },
    { icon: 'Zap', title: '追踪与上线', desc: '在广告上线前检查页面、表单、分析工具和转化路径。' },
    { icon: 'ClipboardCheck', title: '优化与报告', desc: '根据真实询盘数据调整广告，并保持报告清楚可读。' },
  ]}
  pricing={{
    eyebrow: '服务范围',
    title: '根据你的业务和广告复杂度单独报价',
    setupLabel: '初始设置',
    setupPrice: '定制范围',
    monthlyLabel: '持续管理',
    monthlyPrice: '定制范围',
    note: '我们会先评估行业、广告结构、落地页和追踪需求，再确定具体合作范围。广告预算与服务费分开，并直接支付给广告平台。',
    items: ['Google广告或ChatGPT广告设置', '落地页与追踪建议', '持续优化', '中文沟通与清晰报告'],
  }}
  faqs={faqs}
  relatedLabel="相关服务"
  related={[
    { text: 'Google广告服务', href: '/zh/google-ads/' },
    { text: 'ChatGPT广告', href: '/chatgpt-ads/' },
    { text: 'AI SEO 与 GEO', href: '/zh/ai-seo-for-auckland-small-businesses/' },
    { text: '奥克兰SEO', href: '/zh/seo-auckland/' },
    { text: '奥克兰网页设计', href: '/zh/small-business-website-design-auckland/' },
  ]}
  finalCta={{
    title: '想先知道哪个广告渠道更适合你的业务？',
    subtitle: '预约一次免费咨询，我们会根据你的行业、客户需求和现有网站，判断应该先做 Google广告、ChatGPT广告、SEO，还是先改善落地页。',
    primaryText: '预约免费咨询',
    primaryHref: '/zh/website-designer-auckland/',
    secondaryText: '电话 021 039 6580',
    secondaryHref: 'tel:+64210396580',
  }}
/>
