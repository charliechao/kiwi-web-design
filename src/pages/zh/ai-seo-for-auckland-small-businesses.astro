---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import CTABanner from '../../components/CTABanner.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const canonicalURL = 'https://www.kiwiwebdesign.co.nz/zh/ai-seo-for-auckland-small-businesses/';
const alternateUrl = 'https://www.kiwiwebdesign.co.nz/ai-seo-for-auckland-small-businesses/';
const title = '奥克兰 AI SEO 与 GEO 优化服务 | Kiwi Web Design';
const description = '为奥克兰和新西兰华人企业提供 AI SEO 与生成式引擎优化（GEO），结合传统 SEO、结构化数据、本地信号、内容和品牌权威，提升 Google 与 AI 搜索可见度。';

const services = [
  {
    icon: '🤖',
    title: '生成式引擎优化（GEO）',
    desc: '把业务、服务、地区和常见问题整理得更清楚，让 AI 辅助搜索工具更容易理解你的内容。',
    items: ['AI 可见度审核', '直接回答式内容结构', '实体与主题覆盖', 'AI 可读网站建议'],
  },
  {
    icon: '🏷️',
    title: '结构化数据与实体信息',
    desc: '通过 Schema 和一致的企业信息，让搜索系统更清楚地理解你是谁、做什么、服务哪些地区。',
    items: ['LocalBusiness 与 Service Schema', 'FAQ Schema', '实体链接', '结构化数据检查'],
  },
  {
    icon: '📝',
    title: 'AI 辅助内容策略',
    desc: '研究客户真正会问的问题、比较方式和服务需求，再围绕有商业价值的搜索意图规划内容。',
    items: ['关键词与主题聚类', '竞争内容差距', '人工审核内容', '内容规划'],
  },
  {
    icon: '⚡',
    title: '技术 SEO',
    desc: '保持网站快速、可抓取、移动端友好，让搜索引擎和 AI 系统能够访问正确页面。',
    items: ['Core Web Vitals', '抓取与索引检查', 'Sitemap 与 robots.txt', '页面速度优化'],
  },
  {
    icon: '🗺️',
    title: '本地 AI SEO',
    desc: '加强奥克兰地区、服务范围、Google 商家档案和本地企业信息，让本地客户更容易找到你。',
    items: ['Google 商家档案优化', '本地 Schema', '地区服务页面', '评价策略'],
  },
  {
    icon: '📊',
    title: 'AI 搜索可见度跟踪',
    desc: '把 AI 平台上的品牌提及与 Google Search Console、GA4、本地排名和真实询盘一起观察。',
    items: ['AI 提及检查', 'Search Console', 'GA4 与询盘数据', '月度可见度报告'],
  },
];

const process = [
  { step: '1', title: 'AI 可见度审核', desc: '检查现有 Google 排名、AI 搜索表现、网站技术状态、本地信号和品牌权威。' },
  { step: '2', title: '制定优先级', desc: '找出最值得先做的搜索主题、客户问题、Schema、技术和第三方权威机会。' },
  { step: '3', title: '逐步实施', desc: '按优先级改善技术 SEO、结构化数据、服务页面、本地信息、内部链接和品牌权威。' },
  { step: '4', title: '跟踪与调整', desc: '结合排名、自然流量、本地可见度、AI 提及和询盘数据，持续判断下一步。' },
];

const faqs = [
  { q: '什么是 AI SEO？', a: 'AI SEO，也常被称为 GEO，是在传统 SEO 基础上增加一层优化，让企业和内容更容易被 AI 辅助搜索工具理解、检索和引用。它不是传统 SEO 的替代品。' },
  { q: 'AI SEO 和传统 SEO 有什么区别？', a: '传统 SEO 主要关注 Google 排名、技术、内容、外链和本地搜索。AI SEO 在这些基础上更强调直接回答、实体信息、结构化数据、第三方权威和 AI 搜索中的可理解性。最有效的做法是两者一起做。' },
  { q: '能保证我的企业被 ChatGPT 或其他 AI 引用吗？', a: '不能保证。不同 AI 工具会根据查询、来源和上下文生成不同答案。我们做的是提高被理解和被引用的条件，例如清晰内容、可抓取页面、结构化数据、品牌实体和可信第三方提及。' },
  { q: '什么是 GEO 分数？', a: '没有一个所有 AI 搜索平台共同使用的官方 GEO 分数。我们会用内容清晰度、Schema 完整度、技术可抓取性、品牌提及、本地权威和实际 AI 可见度作为内部基准，帮助找出缺口。' },
  { q: 'llms.txt 是什么？一定需要吗？', a: 'llms.txt 是一个仍在发展的网页约定，用来帮助部分 AI 系统或代理更容易理解网站的重要内容。它不是排名捷径，也不能替代技术 SEO、Schema、可抓取性和高质量内容，所以只作为辅助层使用。' },
  { q: '你们如何跟踪 AI 搜索效果？', a: '我们会观察相关 AI 工具中的品牌可见度，同时结合 Search Console、GA4、本地搜索表现、推荐流量和真实询盘。AI 答案会因查询和会话变化，所以提及跟踪更适合作为方向性指标。' },
  { q: 'AI SEO 怎么收费？', a: '我们先审核你目前的网站、竞争程度、内容需求、本地覆盖和品牌权威，再根据实际需要报价。我们不在网站上公布统一的固定套餐价格。' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      inLanguage: 'zh-Hans',
      isPartOf: { '@id': 'https://www.kiwiwebdesign.co.nz/#website' },
      breadcrumb: { '@id': `${canonicalURL}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '中文首页', item: 'https://www.kiwiwebdesign.co.nz/zh/' },
        { '@type': 'ListItem', position: 2, name: 'SEO优化', item: 'https://www.kiwiwebdesign.co.nz/zh/seo-auckland/' },
        { '@type': 'ListItem', position: 3, name: 'AI SEO 与 GEO', item: canonicalURL },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${canonicalURL}#service`,
      name: 'AI SEO 与生成式引擎优化（GEO）',
      serviceType: 'AI SEO',
      category: '数字营销',
      description,
      provider: { '@type': 'LocalBusiness', name: 'Kiwi Web Design', url: 'https://www.kiwiwebdesign.co.nz/' },
      areaServed: [
        { '@type': 'City', name: 'Auckland' },
        { '@type': 'Country', name: 'New Zealand' },
      ],
      url: canonicalURL,
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalURL}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<Layout
  lang="zh-Hans"
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  alternateUrl={alternateUrl}
  schema={schema}
>
  <PageHero
    eyebrow="奥克兰 AI SEO 与 GEO"
    title="让 Google 和 AI 更容易理解你的业务"
    subtitle="我们把传统 SEO、本地搜索、结构化数据、内容和品牌权威结合起来，帮助奥克兰企业在 Google 与 AI 辅助搜索环境中获得更清楚、更稳定的可见度。"
    badgeText="AI SEO 与 GEO，服务奥克兰及全新西兰"
    ctaPrimary={{ text: '获取免费 AI SEO 审核', href: '/zh/website-designer-auckland/' }}
    ctaSecondary={{ text: '了解服务内容', href: '#services' }}
  />

  <div class="aiseo-snippet">
    <div class="container">
      <p><strong>Kiwi Web Design</strong> 为奥克兰和新西兰华人企业提供 AI SEO 与生成式引擎优化（GEO）。重点不是追逐 AI 概念，而是把技术 SEO、结构化数据、本地信息、直接回答式内容和品牌权威做好，让搜索引擎和 AI 工具更容易理解你的企业，并把工作最终连接到询盘和客户。</p>
    </div>
  </div>

  <section class="section" id="services" style="background: var(--kwd-cream);">
    <div class="container">
      <SectionHeader
        eyebrow="AI SEO 服务"
        title="现代搜索需要的不只是关键词"
        subtitle="我们先做好传统 SEO 基础，再增加更适合 AI 辅助搜索的内容结构、实体信息和权威信号。"
      />
      <ServiceGrid items={services} cols={3} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="工作方式"
        title="先审核，再按商业价值排序"
        subtitle="不为了做 AI SEO 而做 AI SEO。每一步都要回答一个问题：它是否能帮助更多合适的客户找到并信任你的企业？"
      />
      <ProcessSteps items={process} />
    </div>
  </section>

  <section class="section" style="background: var(--kwd-cream);">
    <div class="container" style="max-width: 860px;">
      <FAQAccordion
        items={faqs}
        title="AI SEO 常见问题"
        subtitle="关于 GEO、AI 搜索、ChatGPT 可见度和传统 SEO 的常见问题。"
      />
    </div>
  </section>

  <section class="related-strip">
    <div class="container" style="max-width: 900px;">
      <p class="rps-label">相关服务</p>
      <div class="rps-links">
        <a href="/zh/seo-auckland/" class="rps-link">奥克兰 SEO</a>
        <a href="/zh/local-seo-for-auckland-small-businesses/" class="rps-link">本地 SEO</a>
        <a href="/zh/google-ads/" class="rps-link">Google 广告</a>
        <a href="/chatgpt-ads/" class="rps-link">ChatGPT 广告</a>
        <a href="/zh/small-business-website-design-auckland/" class="rps-link">网页设计</a>
      </div>
    </div>
  </section>

  <CTABanner
    variant="yellow"
    title="想知道你的企业在 AI 搜索里缺什么？"
    subtitle="先做一次免费 AI SEO 审核，我们会把最值得优先处理的问题和机会讲清楚。"
    ctaPrimary={{ text: '获取免费 AI SEO 审核', href: '/zh/website-designer-auckland/' }}
    ctaSecondary={{ text: '查看全部 SEO 服务', href: '/zh/seo-auckland/' }}
  />
</Layout>

<style>
  .aiseo-snippet {
    background: #fff8e1;
    border-left: 4px solid var(--kwd-yellow);
    padding: 1rem 0;
  }
  .aiseo-snippet p {
    margin: 0;
    color: var(--kwd-dark);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .related-strip {
    background: var(--kwd-cream);
    border-top: 1px solid rgba(0,0,0,0.07);
    padding: 1.4rem 0;
  }
  .rps-label {
    margin: 0 0 0.7rem;
    color: var(--kwd-brown);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .rps-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .rps-link {
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 999px;
    background: #fff;
    color: var(--kwd-dark);
    padding: 0.45rem 0.9rem;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
  }
  .rps-link:hover {
    background: #e8e7db;
  }
</style>
