---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTABanner from '../components/CTABanner.astro';
import Icon from '../components/Icon.astro';
import PageVisual from '../components/PageVisual.astro';
import workWithUsImage from '../assets/services/work-with-us-kiwi-web-design-auckland.jpg';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.kiwiwebdesign.co.nz/work-with-us/",
      "url": "https://www.kiwiwebdesign.co.nz/work-with-us/",
      "name": "Work With Us: Partner Network | Kiwi Web Design",
      "description": "Kiwi Web Design's Auckland partner network and collaboration approach. We are not currently accepting job or freelance applications.",
      "inLanguage": "en-NZ",
      "isPartOf": { "@id": "https://www.kiwiwebdesign.co.nz/#website" },
      "breadcrumb": { "@id": "https://www.kiwiwebdesign.co.nz/work-with-us/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.kiwiwebdesign.co.nz/work-with-us/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.kiwiwebdesign.co.nz/" },
        { "@type": "ListItem", "position": 2, "name": "Work with Us" }
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://www.kiwiwebdesign.co.nz/#organization",
      "name": "Kiwi Web Design",
      "url": "https://www.kiwiwebdesign.co.nz/"
    }
  ]
};

const values = [
  { icon: "🚀", title: "Quality Over Volume", desc: "We take on projects we can do well. We'd rather do fewer projects and do them properly than rush through volume work." },
  { icon: "💬", title: "Clear Communication", desc: "No ghosting, no vague briefs. We scope clearly, pay on time, and give feedback that's actionable." },
  { icon: "🧠", title: "Shared Ownership", desc: "We want people who genuinely care about the outcome, not just the deliverable. Client success is the shared goal." },
  { icon: "🌏", title: "Based in Auckland", desc: "We prefer working with people who understand the Auckland / NZ market, though remote collaboration is absolutely fine." },
];
---

<Layout
  title="Work With Us: Partner Network | Kiwi Web Design Auckland"
  description="Kiwi Web Design's Auckland partner network and collaboration approach. We are not currently accepting job or freelance applications."
  canonicalURL="https://www.kiwiwebdesign.co.nz/work-with-us/"
  schema={schema}
>

  <!-- Hero -->
  <section class="wwu-hero">
    <div class="container wwu-hero-inner">
      <div class="wwu-hero-content">
        <p class="wwu-eyebrow">Kiwi Web Design Partner Network</p>
        <h1>Partner network and future collaborations</h1>
        <p class="wwu-hero-lead">We keep a small network of established specialists for occasions when a client project needs a particular capability.</p>
        <p class="wwu-hero-status">We are not hiring or accepting freelance applications at this time.</p>
        <div class="wwu-hero-actions">
          <a href="/small-business-website-design-auckland/" class="wwu-hero-btn-primary">Explore Our Services</a>
          <a href="#approach" class="wwu-hero-btn-secondary">Our Approach</a>
        </div>
      </div>
      <div class="wwu-hero-card">
        <p class="wwu-hc-label">Current status</p>
        <ul class="wwu-hc-list">
          <li><span>✓</span> No current vacancies or freelance briefs</li>
          <li><span>✓</span> No applications or unsolicited introductions</li>
          <li><span>✓</span> Existing partners are contacted when relevant</li>
          <li><span>✓</span> We review our network when a genuine need arises</li>
        </ul>
      </div>
    </div>
  </section>

  <PageVisual
    imgSrc={workWithUsImage.src}
    imgAlt="Kiwi Web Design collaborator workspace for Auckland web projects"
    imgTitle="Work with Kiwi Web Design Auckland"
    eyebrow="How We Work"
    title="A small partner network, reviewed when needed"
    caption="When a client project needs a specific capability, we reconnect with established specialists. We are not accepting applications at this time."
  />

  <section class="section" style="background: var(--kwd-cream);">
    <div class="container">
      <SectionHeader
        eyebrow="Partner Network"
        title="Kept focused for the right project"
        subtitle="Our collaboration approach is designed around clear project needs, established capability, and the standards that protect client work. We do not have roles or freelance briefs open at present."
      />
    </div>
  </section>

  <!-- What we value -->
  <section class="section" id="approach" style="background: var(--kwd-dark);">
    <div class="container">
      <SectionHeader
        eyebrow="Collaboration Standards"
        title="What we value when collaboration is needed"
        light={true}
        subtitle="The working standards we bring to every client project."
      />
      <div class="wwu-values">
        {values.map(({ icon, title, desc }) => (
          <div class="wwu-value">
            <span class="wwu-value-icon"><Icon name={icon} size={24} /></span>
            <h3 class="wwu-value-title">{title}</h3>
            <p class="wwu-value-desc">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class="related-strip">
    <div class="container" style="max-width: 860px;">
      <p class="rps-label">Related services</p>
      <div class="rps-links">
        <a href="/small-business-website-design-auckland/" class="rps-link">Web Design Packages</a>
        <a href="/about-us/" class="rps-link">About Us</a>
        <a href="/website-design-process-in-auckland/" class="rps-link">Our Process</a>
        <a href="/contact/" class="rps-link">Contact</a>
        <a href="/faq/" class="rps-link">FAQ</a>
      </div>
    </div>
  </section>

  <CTABanner
    variant="cream"
    title="Looking to hire us instead?"
    subtitle="If you're a business looking for web design, SEO, or Google Ads, we'd love to hear from you."
    ctaPrimary={{ text: "Get a Free Quote", href: "/contact/" }}
    ctaSecondary={{ text: "See Our Services", href: "/small-business-website-design-auckland/" }}
  />

</Layout>

<style>
  /* Hero */
  .wwu-hero {
    background: var(--kwd-dark);
    padding: 5rem 0;
  }
  .wwu-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .wwu-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--kwd-yellow);
    margin-bottom: 1rem;
  }
  .wwu-hero-content h1 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    color: #fff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }
  .wwu-hero-lead {
    font-size: 1rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin-bottom: 1rem;
    max-width: 500px;
  }
  .wwu-hero-status {
    color: var(--kwd-yellow);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.6;
    margin: 0 0 2.25rem;
    max-width: 500px;
  }
  .wwu-hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .wwu-hero-btn-primary {
    display: inline-block;
    background: var(--kwd-yellow);
    color: var(--kwd-dark);
    padding: 0.875rem 2rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    transition: background 0.2s;
  }
  .wwu-hero-btn-primary:hover { background: var(--kwd-gold); }
  .wwu-hero-btn-secondary {
    display: inline-block;
    color: rgba(255,255,255,0.7);
    padding: 0.875rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .wwu-hero-btn-secondary:hover { color: #fff; }

  .wwu-hero-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;
    padding: 2rem;
  }
  .wwu-hc-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.4);
    margin-bottom: 1.25rem;
  }
  .wwu-hc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .wwu-hc-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.8);
  }
  .wwu-hc-list span {
    color: var(--kwd-yellow);
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Values */
  .wwu-values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .wwu-value {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .wwu-value-icon { }
  .wwu-value-title {
    font-family: var(--kwd-font-body);
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }
  .wwu-value-desc {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 960px) {
    .wwu-hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .wwu-values { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 580px) {
    .wwu-values { grid-template-columns: 1fr; }
  }

  .related-strip { background: var(--kwd-cream); padding: 1.25rem 0; border-top: 1px solid rgba(0,0,0,0.07); }
  .rps-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--kwd-brown); margin-bottom: 0.6rem; }
  .rps-links { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .rps-link { font-size: 0.82rem; font-weight: 600; padding: 0.4rem 0.9rem; border-radius: 999px; background: #fff; border: 1.5px solid rgba(0,0,0,0.1); color: var(--kwd-dark); text-decoration: none; transition: background 0.15s; }
  .rps-link:hover { background: #e8e7db; }
</style>
