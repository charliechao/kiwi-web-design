---
import PaidAdsServicePage from '../components/PaidAdsServicePage.astro';

const canonicalURL = 'https://www.kiwiwebdesign.co.nz/paid-ads/';
const alternateUrl = 'https://www.kiwiwebdesign.co.nz/zh/paid-ads/';
const title = 'Paid Ads Auckland & NZ | Small Business Campaigns | Kiwi Web Design';
const description = 'Paid ads for Auckland and New Zealand small businesses. Google Ads setup is NZ$500 + GST and management is NZ$500 + GST/month, plus separate ad spend.';

const faqs = [
  { q: 'Should I start with Google Ads or ChatGPT Ads?', a: 'For most Auckland and New Zealand small businesses, Google Ads should come first because people are already searching there with strong buying intent. ChatGPT Ads are a newer channel, so we treat them as a controlled test alongside proven search campaigns rather than an automatic replacement.' },
  { q: 'How much does Google Ads management cost?', a: 'Google Ads setup is NZ$500 + GST, followed by NZ$500 + GST per month for ongoing management. Google advertising spend is separate, paid directly to Google, and depends on your market, location and competition.' },
  { q: 'Is Google ad spend included in the management fee?', a: 'No. The NZ$500 setup fee and NZ$500 monthly management fee cover our work. Your Google advertising budget is separate and paid directly to Google.' },
  { q: 'How do you decide what ad budget I need?', a: 'We base the recommendation on search demand, competition, expected value per lead, conversion rate, and how quickly you want useful data. We scope the budget after reviewing your market rather than publishing a generic figure that may not suit your business.' },
  { q: 'Can you build the landing page too?', a: 'Yes. We can connect paid ads to dedicated landing pages, website pages, forms, analytics, and conversion tracking so the campaign has a proper conversion path.' },
  { q: 'How do you charge for ChatGPT Ads?', a: 'ChatGPT Ads strategy and testing are quoted separately because the platform, campaign scope, creative, landing pages and measurement requirements vary. We will explain the recommended scope before work starts.' },
  { q: 'Do you work with small businesses outside Auckland?', a: 'Yes. Kiwi Web Design is based in Grey Lynn, Auckland, and supports paid ads for small businesses throughout New Zealand. Auckland clients can meet in person, while nationwide clients can work with us online.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      inLanguage: 'en-NZ',
      isPartOf: { '@id': 'https://www.kiwiwebdesign.co.nz/#website' },
      breadcrumb: { '@id': `${canonicalURL}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.kiwiwebdesign.co.nz/' },
        { '@type': 'ListItem', position: 2, name: 'Paid Ads', item: canonicalURL },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${canonicalURL}#service`,
      name: 'Paid Ads Management Auckland & New Zealand',
      serviceType: 'Paid Ads Management',
      provider: { '@id': 'https://www.kiwiwebdesign.co.nz/#organization' },
      areaServed: [
        { '@type': 'City', name: 'Auckland' },
        { '@type': 'Country', name: 'New Zealand' },
      ],
      description,
      offers: [
        {
          '@type': 'Offer',
          name: 'Google Ads campaign setup',
          price: '500',
          priceCurrency: 'NZD',
          description: 'One-off Google Ads campaign setup. GST and Google ad spend are additional.',
        },
        {
          '@type': 'Offer',
          name: 'Google Ads ongoing management',
          price: '500',
          priceCurrency: 'NZD',
          description: 'Monthly Google Ads management. GST and Google ad spend are additional.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalURL}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<PaidAdsServicePage
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  alternateUrl={alternateUrl}
  schema={schema}
  eyebrow="Paid Ads | Auckland & NZ"
  h1="Paid ads for Auckland and New Zealand small businesses"
  subtitle="Start with Google Ads to capture ready-to-buy searches: NZ$500 + GST setup and NZ$500 + GST per month for ongoing management, plus separate Google ad spend. We can then assess whether ChatGPT Ads is a useful test for your business."
  badgeText="Google Ads and ChatGPT Ads strategy for New Zealand small businesses"
  primaryCta={{ text: 'Book a free ads consultation', href: '/contact/' }}
  secondaryCta={{ text: 'View ChatGPT Ads', href: '/chatgpt-ads/' }}
  proof={['Small-business focused', 'Google Ads from NZ$500 + GST', 'Auckland-based, NZ-wide', 'Tracking included']}
  snippetLabel="Quick answer"
  snippet="Kiwi Web Design helps Auckland and New Zealand small businesses run Google Ads with transparent pricing: NZ$500 + GST for setup and NZ$500 + GST per month for ongoing management. Google ad spend is separate and paid directly to Google. We can also scope a controlled ChatGPT Ads test where the customer journey supports it."
  introEyebrow="Channel strategy"
  introTitle="Use proven search demand first, then test newer AI demand carefully."
  introText="Paid ads work best when the platform, message, landing page, and tracking are planned together. We help you choose the right channel rather than spreading a small-business budget across platforms just because they exist."
  channels={[
    {
      icon: 'Search',
      title: 'Google Ads',
      desc: 'Capture people already searching for your service on Google with clear campaign structure and conversion tracking.',
      href: '/google-ads/',
      label: 'Explore Google Ads',
      items: ['Search campaigns', 'Local service intent', 'Remarketing', 'Conversion tracking'],
    },
    {
      icon: 'Sparkles',
      title: 'ChatGPT Ads',
      desc: 'Plan and test paid ChatGPT placements with a clear offer, suitable creative, conversion-focused landing pages, and reliable measurement.',
      href: '/chatgpt-ads/',
      label: 'Explore ChatGPT Ads',
      items: ['Campaign strategy', 'Prompt-intent research', 'Landing-page preparation', 'Measurement setup'],
    },
  ]}
  featureEyebrow="What we manage"
  featureTitle="The campaign is only one part of the result."
  featureText="A good paid ads setup connects traffic to a strong offer, a conversion-focused page, and simple reporting. That is where most small business campaigns either start working or start wasting money."
  features={[
    { icon: 'Globe', title: 'Landing pages that convert', desc: 'Ads point to pages built for clarity, trust, speed, and enquiry generation.' },
    { icon: 'BadgeDollarSign', title: 'Conversion tracking', desc: 'Calls, forms, and key actions are tracked so optimisation is based on real business outcomes.' },
    { icon: 'Sparkles', title: 'Message and intent testing', desc: 'We test keywords, buyer questions, offers, and calls to action to find what moves prospects.' },
    { icon: 'ClipboardCheck', title: 'Clear monthly reporting', desc: 'You see what happened, what changed, and what we recommend next without unnecessary platform jargon.' },
  ]}
  processEyebrow="Our process"
  processTitle="Clear setup with controlled launch and steady optimisation."
  processText="The goal is not to make paid ads complicated. The goal is to make every dollar accountable, then improve the parts that matter most."
  process={[
    { icon: 'Search', title: 'Market and offer audit', desc: 'We review your service, competitors, current website, search demand, and realistic acquisition economics.' },
    { icon: 'Map', title: 'Campaign plan', desc: 'We choose the right channel, targeting, landing pages, tracking events, and launch priorities.' },
    { icon: 'Zap', title: 'Tracking and launch', desc: 'Campaigns go live only after the conversion path, forms, analytics, and audience setup are checked.' },
    { icon: 'ClipboardCheck', title: 'Optimise and report', desc: 'We improve campaigns using actual lead data, not guesswork, and keep reporting simple enough to act on.' },
  ]}
  pricing={{
    eyebrow: 'Transparent Google Ads Pricing',
    title: 'Straightforward Google Ads pricing for small businesses',
    setupLabel: 'Google Ads setup',
    setupPrice: 'NZ$500 + GST',
    monthlyLabel: 'Google Ads management',
    monthlyPrice: 'NZ$500 + GST/mo',
    note: 'Google Ads setup and ongoing management are fixed fees. Google advertising spend is separate and paid directly to Google. ChatGPT Ads strategy and testing are quoted separately to suit the scope.',
    items: ['Google Ads campaign setup and conversion tracking', 'Landing-page and tracking recommendations', 'Ongoing Google Ads optimisation and plain-English reporting', 'ChatGPT Ads strategy and testing quoted separately'],
  }}
  faqs={faqs}
  relatedLabel="Related services"
  related={[
    { text: 'Google Ads pricing and real results', href: '/google-ads/#results' },
    { text: 'ChatGPT Ads NZ', href: '/chatgpt-ads/' },
    { text: 'Meta Ads', href: '/meta-ads/' },
    { text: 'ChatGPT Ads readiness check', href: '/chatgpt-ads-readiness-check/' },
    { text: 'Google Ads budget calculator', href: '/google-ads-budget-calculator-nz/' },
    { text: 'ChatGPT Ads: NZ launch guide', href: '/affordable-web-design-auckland/chatgpt-ads-new-zealand-guide/' },
    { text: 'ChatGPT vs Google Search Ads', href: '/affordable-web-design-auckland/chatgpt-ads-vs-google-search-ads-nz/' },
    { text: 'ChatGPT Ads conversion tracking', href: '/affordable-web-design-auckland/chatgpt-ads-conversion-tracking-nz/' },
    { text: 'ChatGPT Ads context hints', href: '/affordable-web-design-auckland/chatgpt-ads-context-hints-nz-examples/' },
    { text: 'Landing Pages', href: '/landing-pages-funnels-on-wordpress/' },
    { text: 'AI SEO & GEO', href: '/ai-seo-for-auckland-small-businesses/' },
    { text: 'SEO Auckland', href: '/affordable-seo-auckland/' },
    { text: 'Website Care Plan', href: '/monthly-subscription/' },
  ]}
  finalCta={{
    title: 'Want a paid ads plan before you spend more?',
    subtitle: 'Book a free consultation and we will tell you whether Google Ads, ChatGPT Ads, SEO, or landing-page work should come first. Auckland clients can meet in person; New Zealand-wide consultations are available online.',
    primaryText: 'Book a free consultation',
    primaryHref: '/contact/',
    secondaryText: 'Call 021 039 6580',
    secondaryHref: 'tel:+64210396580',
  }}
/>
