---
import PaidAdsServicePage from '../components/PaidAdsServicePage.astro';

const canonicalURL = 'https://www.kiwiwebdesign.co.nz/paid-ads/';
const alternateUrl = 'https://www.kiwiwebdesign.co.nz/zh/paid-ads/';
const title = 'Paid Ads Auckland | Google Ads & ChatGPT Ads Strategy | Kiwi Web Design';
const description = 'Paid ads strategy for Auckland small businesses, focused on Google Ads and ChatGPT Ads, with landing pages, tracking, and clear reporting.';

const faqs = [
  { q: 'Should I start with Google Ads or ChatGPT Ads?', a: 'For most Auckland service businesses, Google Ads should come first because people are already searching there with strong buying intent. ChatGPT Ads are a newer channel and self-service Ads Manager is available in New Zealand, so we treat them as a controlled test alongside proven search campaigns rather than an automatic replacement.' },
  { q: 'How do you decide what ad budget I need?', a: 'We base the recommendation on search demand, competition, expected value per lead, conversion rate, and how quickly you want useful data. We scope the budget after reviewing your market rather than publishing a generic figure that may not suit your business.' },
  { q: 'Can you build the landing page too?', a: 'Yes. We can connect paid ads to dedicated landing pages, website pages, forms, analytics, and conversion tracking so the campaign has a proper conversion path.' },
  { q: 'How do you charge for management?', a: 'We quote management based on campaign scope and complexity. The fee is agreed before work starts and kept separate from the ad spend paid directly to the advertising platform.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      inLanguage: 'en-NZ',
      isPartOf: { '@id': 'https://www.kiwiwebdesign.co.nz/#website' },
      breadcrumb: { '@id': `${canonicalURL}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.kiwiwebdesign.co.nz/' },
        { '@type': 'ListItem', position: 2, name: 'Paid Ads', item: canonicalURL },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${canonicalURL}#service`,
      name: 'Paid Ads Management Auckland',
      serviceType: 'Paid Ads Management',
      provider: { '@type': 'LocalBusiness', name: 'Kiwi Web Design', url: 'https://www.kiwiwebdesign.co.nz/' },
      areaServed: { '@type': 'City', name: 'Auckland' },
      description,
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalURL}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<PaidAdsServicePage
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  alternateUrl={alternateUrl}
  schema={schema}
  eyebrow="Paid Ads Auckland"
  h1="Paid ads built around leads, not platform activity."
  subtitle="Google Ads captures people already searching. ChatGPT Ads add a newer conversational discovery channel that is now available to self-service advertisers in New Zealand. We connect the right channel to landing pages, tracking, and reporting so your budget has a clear job to do."
  badgeText="Google Ads and ChatGPT Ads strategy for Auckland businesses"
  primaryCta={{ text: 'Book a free ads consultation', href: '/contact/' }}
  secondaryCta={{ text: 'View ChatGPT Ads', href: '/chatgpt-ads/' }}
  proof={['Lead-focused', 'Custom scope', 'Auckland focused', 'Tracking included']}
  snippetLabel="Quick answer"
  snippet="Kiwi Web Design helps Auckland small businesses generate enquiries through Google Ads and test ChatGPT Ads where the customer journey supports it. We connect campaign strategy to landing pages, conversion tracking, and practical reporting, then recommend the channel that makes commercial sense for your business."
  introEyebrow="Channel strategy"
  introTitle="Use proven search demand first, then test newer AI demand carefully."
  introText="Paid ads work best when the platform, message, landing page, and tracking are planned together. We help you choose the right channel rather than spreading budget across platforms just because they exist."
  channels={[
    {
      icon: 'Search',
      title: 'Google Ads',
      desc: 'Capture people already searching for your service on Google with clear campaign structure and conversion tracking.',
      href: '/google-ads/',
      label: 'Explore Google Ads',
      items: ['Search campaigns', 'Local service intent', 'Remarketing', 'Conversion tracking'],
    },
    {
      icon: 'Sparkles',
      title: 'ChatGPT Ads',
      desc: 'Plan and test paid ChatGPT placements with a clear offer, suitable creative, conversion-focused landing pages, and reliable measurement.',
      href: '/chatgpt-ads/',
      label: 'Explore ChatGPT Ads',
      items: ['Campaign strategy', 'Prompt-intent research', 'Landing-page preparation', 'Measurement setup'],
    },
  ]}
  featureEyebrow="What we manage"
  featureTitle="The campaign is only one part of the result."
  featureText="A good paid ads setup connects traffic to a strong offer, a conversion-focused page, and simple reporting. That is where most small business campaigns either start working or start wasting money."
  features={[
    { icon: 'Globe', title: 'Landing pages that convert', desc: 'Ads point to pages built for clarity, trust, speed, and enquiry generation.' },
    { icon: 'BadgeDollarSign', title: 'Conversion tracking', desc: 'Calls, forms, and key actions are tracked so optimisation is based on real business outcomes.' },
    { icon: 'Sparkles', title: 'Message and intent testing', desc: 'We test keywords, buyer questions, offers, and calls to action to find what moves prospects.' },
    { icon: 'ClipboardCheck', title: 'Clear monthly reporting', desc: 'You see what happened, what changed, and what we recommend next without unnecessary platform jargon.' },
  ]}
  processEyebrow="Our process"
  processTitle="Clear setup with controlled launch and steady optimisation."
  processText="The goal is not to make paid ads complicated. The goal is to make every dollar accountable, then improve the parts that matter most."
  process={[
    { icon: 'Search', title: 'Market and offer audit', desc: 'We review your service, competitors, current website, search demand, and realistic acquisition economics.' },
    { icon: 'Map', title: 'Campaign plan', desc: 'We choose the right channel, targeting, landing pages, tracking events, and launch priorities.' },
    { icon: 'Zap', title: 'Tracking and launch', desc: 'Campaigns go live only after the conversion path, forms, analytics, and audience setup are checked.' },
    { icon: 'ClipboardCheck', title: 'Optimise and report', desc: 'We improve campaigns using actual lead data, not guesswork, and keep reporting simple enough to act on.' },
  ]}
  pricing={{
    eyebrow: 'Scope',
    title: 'Quoted around the work your business actually needs',
    setupLabel: 'Initial setup',
    setupPrice: 'Custom scope',
    monthlyLabel: 'Ongoing management',
    monthlyPrice: 'Custom scope',
    note: 'We review your market, campaign complexity, landing-page needs, and measurement setup before recommending a scope. Ad spend remains separate and is paid directly to the advertising platform.',
    items: ['Google Ads or ChatGPT Ads campaign setup', 'Landing-page and tracking recommendations', 'Ongoing optimisation where appropriate', 'Plain-English reporting'],
  }}
  faqs={faqs}
  relatedLabel="Related services"
  related={[
    { text: 'Google Ads Auckland', href: '/google-ads/' },
    { text: 'ChatGPT Ads NZ', href: '/chatgpt-ads/' },
    { text: 'AI SEO & GEO', href: '/ai-seo-for-auckland-small-businesses/' },
    { text: 'Landing Pages', href: '/landing-pages-funnels-on-wordpress/' },
    { text: 'Analytics Reporting', href: '/analytics-reporting-for-auckland-small-business-websites/' },
    { text: 'SEO Auckland', href: '/affordable-seo-auckland/' },
  ]}
  finalCta={{
    title: 'Want a paid ads plan before you spend more?',
    subtitle: 'Book a free consultation and we will tell you whether Google Ads, ChatGPT Ads, SEO, or landing-page work should come first.',
    primaryText: 'Book a free consultation',
    primaryHref: '/contact/',
    secondaryText: 'Call 021 039 6580',
    secondaryHref: 'tel:+64210396580',
  }}
/>
