---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTABanner from '../components/CTABanner.astro';
---

<Layout
  title="Paid Ads Auckland | Google Ads & ChatGPT Ads | Kiwi Web Design"
  description="Kiwi Web Design currently focuses paid advertising services on Google Ads and ChatGPT Ads for Auckland small businesses."
  canonicalURL="https://www.kiwiwebdesign.co.nz/paid-ads/"
  robots="noindex,follow"
>
  <PageHero
    eyebrow="Paid Ads Auckland"
    title="Our paid ads focus is Google Ads and ChatGPT Ads"
    subtitle="Kiwi Web Design is not currently offering Meta Ads management. For lead-generation campaigns, we focus on Google Ads and the newer ChatGPT Ads channel, connected to landing pages and conversion tracking."
    badgeText="Google Ads + ChatGPT Ads"
    ctaPrimary={{ text: 'View Paid Ads', href: '/paid-ads/' }}
    ctaSecondary={{ text: 'View Google Ads', href: '/google-ads/' }}
  />

  <CTABanner
    variant="yellow"
    title="Looking for paid lead generation?"
    subtitle="See our current Google Ads and ChatGPT Ads services, or book a free consultation to decide which channel fits your business."
    ctaPrimary={{ text: 'View Paid Ads', href: '/paid-ads/' }}
    ctaSecondary={{ text: 'ChatGPT Ads', href: '/chatgpt-ads/' }}
  />
</Layout>
