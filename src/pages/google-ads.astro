---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTABanner from '../components/CTABanner.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { Image } from 'astro:assets';
import about3Img from '../assets/general/about3.jpg';
import about4Img from '../assets/general/about4.jpg';
import northShoreFurnitureAdsImg from '../assets/general/google-ads-north-shore-furniture-assembly.png';
import potholeFixingAdsImg from '../assets/general/google-ads-pothole-fixing-auckland.png';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.kiwiwebdesign.co.nz/google-ads/",
      "url": "https://www.kiwiwebdesign.co.nz/google-ads/",
      "name": "Affordable Google Ads Management Auckland & NZ | Kiwi Web Design",
      "description": "Affordable Google Ads management for Auckland and New Zealand small businesses. NZ$500 setup plus NZ$500 per month, plus GST and Google ad spend.",
      "inLanguage": "en-NZ",
      "isPartOf": { "@id": "https://www.kiwiwebdesign.co.nz/#website" },
      "about": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "breadcrumb": { "@id": "https://www.kiwiwebdesign.co.nz/google-ads/#breadcrumb" },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".ga-snippet", ".ga-statbar-inner"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.kiwiwebdesign.co.nz/google-ads/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.kiwiwebdesign.co.nz/" },
        { "@type": "ListItem", "position": 2, "name": "Google Ads", "item": "https://www.kiwiwebdesign.co.nz/google-ads/" }
      ]
    },
    {
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": "https://www.kiwiwebdesign.co.nz/#organization",
      "name": "Kiwi Web Design",
      "alternateName": "Web Design Auckland",
      "url": "https://www.kiwiwebdesign.co.nz/",
      "telephone": "+64-21-039-6580",
      "email": "hi@kiwiwebdesign.co.nz",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "147 Great North Road",
        "addressLocality": "Grey Lynn",
        "addressRegion": "Auckland",
        "postalCode": "1021",
        "addressCountry": "NZ"
      },
      "areaServed": [
        { "@type": "City", "name": "Auckland" },
        { "@type": "Country", "name": "New Zealand" }
      ],
      "priceRange": "$$",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.kiwiwebdesign.co.nz/favicon.png",
        "width": 512,
        "height": 512
      }
    },
    {
      "@type": "Service",
      "@id": "https://www.kiwiwebdesign.co.nz/google-ads/#service",
      "name": "Affordable Google Ads Management Auckland & New Zealand",
      "serviceType": "Google Ads Management",
      "category": "Digital Marketing",
      "description": "Google Ads campaign setup and ongoing management for Auckland and New Zealand small businesses. NZ$500 setup plus NZ$500 per month, plus GST and Google ad spend. Flat-fee management, not a percentage of ad spend.",
      "provider": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "areaServed": [
        { "@type": "City", "name": "Auckland" },
        { "@type": "Country", "name": "New Zealand" }
      ],
      "offers": [
        {
          "@type": "Offer",
          "name": "Google Ads campaign setup",
          "price": "500",
          "priceCurrency": "NZD",
          "description": "One-off campaign setup. GST and Google ad spend are additional."
        },
        {
          "@type": "Offer",
          "name": "Google Ads ongoing management",
          "price": "500",
          "priceCurrency": "NZD",
          "description": "Monthly campaign management. GST and Google ad spend are additional."
        }
      ],
      "url": "https://www.kiwiwebdesign.co.nz/google-ads/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How quickly can Google Ads go live?",
          "acceptedAnswer": { "@type": "Answer", "text": "Most campaigns can be ready to launch within five business days of receiving the information and access we need. Google must approve ads before they run, and the timing of first enquiries depends on search demand, budget, competition and the landing page." }
        },
        {
          "@type": "Question",
          "name": "How much does Google Ads management cost?",
          "acceptedAnswer": { "@type": "Answer", "text": "Google Ads setup is NZ$500 plus GST, followed by NZ$500 plus GST per month for ongoing management. Google advertising spend is separate and paid directly to Google. We charge a flat fee, not a percentage of your ad spend." }
        },
        {
          "@type": "Question",
          "name": "Is Google ad spend included in the management fee?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. The NZ$500 setup fee and NZ$500 monthly management fee cover our work. Your Google advertising budget is separate, is paid directly to Google, and depends on your industry, location and competition." }
        },
        {
          "@type": "Question",
          "name": "What ad spend budget do I need for Google Ads?",
          "acceptedAnswer": { "@type": "Answer", "text": "It depends on your industry and competition. Highly competitive industries like legal or trades typically need a bigger budget than lower-competition niches. We provide honest upfront estimates of what's needed to compete in your specific market during a free audit." }
        },
        {
          "@type": "Question",
          "name": "Should I run Google Ads or focus on SEO?",
          "acceptedAnswer": { "@type": "Answer", "text": "Both serve different purposes. Google Ads can generate traffic as soon as your ads are approved and running, but requires ongoing spend. SEO takes longer but earns free traffic that compounds over time. For many Auckland and New Zealand small businesses, a mix of both can be useful. Pairing Ads with well-built conversion landing pages can also improve lead quality." }
        },
        {
          "@type": "Question",
          "name": "Can you take over my existing Google Ads account?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. We can audit and take over management of existing campaigns, or set up a fresh account for businesses starting from scratch. Either way, we start with a free audit to understand what's working and what isn't." }
        },
        {
          "@type": "Question",
          "name": "Do you charge a percentage of ad spend?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Kiwi Web Design charges a flat fee: NZ$500 plus GST for setup and NZ$500 plus GST per month for ongoing management. Google ad spend is separate. This means our fee does not increase when you increase your advertising budget." }
        },
        {
          "@type": "Question",
          "name": "Do you work with small businesses outside Auckland?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Kiwi Web Design is based in Grey Lynn, Auckland, and manages Google Ads for small businesses across New Zealand. Auckland clients can meet in person, while nationwide clients can work with us online." }
        }
      ]
    }
  ]
};

const adServices = [
  {
    icon: "🔍",
    title: "Search Campaigns",
    desc: "Appear at the top of Google when people search for exactly what you offer. We build tightly-targeted campaigns that put you in front of high-intent buyers.",
    items: ["Keyword research & match type strategy", "Competitor gap analysis", "Negative keyword lists", "Ad copy A/B testing"],
  },
  {
    icon: "🏙️",
    title: "Local Service Ads",
    desc: "Appear in Google's verified local results, Google Guaranteed or Google Screened. Ideal for service businesses that want maximum local visibility.",
    items: ["LSA setup and verification", "Budget optimisation", "Review generation support", "Lead quality tracking"],
  },
  {
    icon: "🎯",
    title: "Remarketing",
    desc: "Re-engage visitors who left without converting. We show targeted ads to people who've already shown interest in your business.",
    items: ["Audience list creation", "Display remarketing", "YouTube remarketing", "Dynamic ad creative"],
  },
  {
    icon: "📊",
    title: "Conversion Tracking",
    desc: "Know exactly which ads are generating calls, form submissions, and revenue. We set up complete conversion tracking so every dollar is accountable.",
    items: ["Google Tag Manager setup", "Call tracking", "Form submission tracking", "eCommerce revenue tracking"],
  },
  {
    icon: "🛒",
    title: "Shopping Ads",
    desc: "For eCommerce businesses, get your products visible at the top of Google Shopping results with well-structured feed management.",
    items: ["Google Merchant Center setup", "Product feed optimisation", "Smart Shopping campaigns", "ROAS optimisation"],
  },
  {
    icon: "📈",
    title: "Campaign Optimisation",
    desc: "Ongoing management to continuously improve performance. We test, analyse, and refine, reducing cost per lead while increasing volume.",
    items: ["Monthly performance reviews", "Bid strategy optimisation", "Quality score improvement", "Ad schedule fine-tuning"],
  },
];

const whyUs = [
  {
    icon: "🚫",
    title: "No Wasted Ad Spend",
    desc: "We use tight keyword targeting, comprehensive negative keyword lists, and conversion-focused landing pages to make sure your budget reaches buyers, not browsers.",
  },
  {
    icon: "📍",
    title: "Auckland-based. New Zealand-wide.",
    desc: "We bring local Auckland knowledge and manage campaigns for small businesses throughout New Zealand. Every campaign is built around your specific audience, location and goals.",
  },
  {
    icon: "🔎",
    title: "Transparent Reporting",
    desc: "You'll know exactly what's happening with your ads every month. Clear reports showing spend, leads, cost-per-lead, and what we're doing to improve.",
  },
  {
    icon: "🏁",
    title: "Fast Setup, Clear Next Steps",
    desc: "Most campaigns can be ready to launch within five business days of receiving the information and access we need. Once live, results depend on demand, budget, competition and your landing page.",
  },
];

const process = [
  { step: "1", title: "Free Ads Audit", desc: "We review your existing campaigns (or assess your market from scratch) and identify the biggest opportunities." },
  { step: "2", title: "Campaign Strategy", desc: "We build a campaign plan: keywords, ad copy, landing pages, budgets, and bidding strategy tailored to your goals." },
  { step: "3", title: "Setup & Launch", desc: "Campaigns built, conversion tracking installed, and ads live, typically within 5 business days of briefing." },
  { step: "4", title: "Manage & Optimise", desc: "Ongoing monthly management: testing, bidding adjustments, negative keywords, and reporting to continuously improve ROI." },
];

const industries = [
  "Trades (plumbers, electricians, builders)",
  "Healthcare & dental",
  "Law firms & professional services",
  "Beauty & wellness salons",
  "Restaurants & hospitality",
  "eCommerce & retail",
  "Cleaning & property services",
  "Automotive & mechanical",
];

const faqs = [
  { q: "How quickly can Google Ads go live?", a: "Most campaigns can be ready to launch within five business days of receiving the information and access we need. Google must approve ads before they run, and the timing of first enquiries depends on search demand, budget, competition and the landing page." },
  { q: "How much does Google Ads management cost?", a: "Google Ads setup is <strong>NZ$500 + GST</strong>, followed by <strong>NZ$500 + GST per month</strong> for ongoing management. Google advertising spend is separate and paid directly to Google. We charge a flat fee, not a percentage of your ad spend." },
  { q: "Is Google ad spend included in the management fee?", a: "No. The NZ$500 setup fee and NZ$500 monthly management fee cover our work. Your Google advertising budget is separate, is paid directly to Google, and depends on your industry, location and competition." },
  { q: "What ad spend budget do I need?", a: "It depends on your industry and competition. Highly competitive industries like legal or trades typically need more than lower-competition niches. We'll be honest with you upfront about what budget is needed to compete in your market. Use our <a href=\"/google-ads-budget-calculator-nz/\">free Google Ads budget calculator</a> to estimate your CPC, click volume, and cost per lead." },
  { q: "Should I run Google Ads or focus on SEO?", a: "Both serve different purposes. Google Ads can generate traffic as soon as your ads are approved and running, but requires ongoing spend. <a href=\"/affordable-seo-auckland/\">SEO services</a> take longer but earn free traffic that compounds over time. For many Auckland and New Zealand small businesses, a mix of both can be useful. Pairing Ads with well-built <a href=\"/landing-pages-funnels-on-wordpress/\">conversion landing pages</a> can also improve lead quality." },
  { q: "Can you take over my existing Google Ads account?", a: "Yes. We can audit and take over management of your existing campaigns, or we can set up a fresh account if you're starting from scratch. Either way, we'll start with an audit to understand what's working and what isn't." },
  { q: "What's your management fee structure?", a: "We charge a flat fee: NZ$500 + GST for setup and NZ$500 + GST per month for ongoing management. Google ad spend is separate. This means our fee does not increase when you increase your advertising budget." },
  { q: "Do you work with small businesses outside Auckland?", a: "Yes. Kiwi Web Design is based in Grey Lynn, Auckland, and manages Google Ads for small businesses across New Zealand. Auckland clients can meet in person, while nationwide clients can work with us online." },
];
---

<Layout
  title="Affordable Google Ads Management Auckland & NZ | Kiwi Web Design"
  description="Affordable Google Ads management for Auckland and New Zealand small businesses. NZ$500 setup + NZ$500/month, plus GST and Google ad spend."
  canonicalURL="https://www.kiwiwebdesign.co.nz/google-ads/"
  schema={schema}
  alternateUrl="https://www.kiwiwebdesign.co.nz/zh/google-ads/"
>

  <PageHero
    eyebrow="Affordable Google Ads | Auckland & NZ"
    title="Affordable Google Ads for Auckland and New Zealand small businesses"
    subtitle="NZ$500 + GST setup and NZ$500 + GST per month for ongoing management. We build and manage targeted campaigns, while your Google ad spend stays separate and under your control."
    badgeText="Free Ads strategy session"
    ctaPrimary={{ text: "Get a Free Ads Audit", href: "/contact/" }}
    ctaSecondary={{ text: "See Real Results", href: "#results" }}
    centered={true}
  />

  <!-- AI citability snippet -->
  <div class="ga-snippet">
    <div class="container">
      <p><strong>Kiwi Web Design</strong> manages Google Ads for Auckland and New Zealand small businesses with transparent flat-fee pricing: <strong>NZ$500 + GST</strong> for campaign setup and <strong>NZ$500 + GST per month</strong> for ongoing management. Google ad spend is separate and paid directly to Google. We are based in Grey Lynn, Auckland, with in-person consultations available locally and online support nationwide.</p>
    </div>
  </div>

  <!-- Why Google Ads -->
  <section class="section" style="background: var(--kwd-cream);">
    <div class="container">
      <SectionHeader
        eyebrow="Why Google Ads"
        title="A practical way to reach ready-to-buy customers"
        subtitle="Google Ads can put your business in front of people searching for what you offer in Auckland or anywhere else in New Zealand. You choose the ad budget and only pay Google when someone clicks."
      />
      <ServiceGrid items={whyUs} cols={2} />
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Our Services"
        title="Complete Google Ads management"
        subtitle="From campaign setup to ongoing optimisation, everything needed to run profitable Google Ads."
      />
      <ServiceGrid items={adServices} cols={3} />
    </div>
  </section>

  <!-- Industries -->
  <section class="section" style="background: var(--kwd-dark);">
    <div class="container">
      <SectionHeader eyebrow="Industries" title="Industries we run Google Ads for." light={true} />
      <div class="ga-industries">
        {industries.map((item) => (
          <div class="ga-industry-item">
            <svg class="ga-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" style="background: var(--kwd-cream);" id="process">
    <div class="container">
      <SectionHeader
        eyebrow="How It Works"
        title="From brief to live in 5 business days"
        subtitle="We move fast so you can start generating leads without delay."
      />
      <ProcessSteps items={process} />
    </div>
  </section>

  <!-- Team photo band -->
  <section class="ga-team-band">
    <Image src={about3Img} alt="Kiwi Web Design team managing Google Ads campaigns for Auckland and New Zealand small businesses" width={1600} height={640} class="ga-team-band-img" />
    <div class="ga-team-band-overlay">
      <div class="container">
        <p class="ga-band-eyebrow">The team behind your campaigns</p>
        <h2 class="ga-band-title">We manage every dollar like it's our own</h2>
        <a href="#results" class="ga-band-link">See a live campaign's results →</a>
      </div>
    </div>
  </section>

  <!-- Pricing callout -->
  <section class="section">
    <div class="container">
      <div class="ga-pricing-card">
        <div class="ga-pricing-left">
          <p class="ga-pricing-eyebrow">How We Charge</p>
          <h2 class="ga-pricing-title">Straightforward pricing for small businesses</h2>
          <p class="ga-pricing-desc">You pay a flat fee for our work, not a percentage of your ad spend. Google advertising spend is separate and paid directly to Google, so you stay in control of the budget.</p>
          <div class="ga-pricing-tiers">
            <div class="ga-tier">
              <span class="ga-tier-price">NZ$500 + GST</span>
              <span class="ga-tier-label">One-off campaign setup</span>
            </div>
            <div class="ga-tier">
              <span class="ga-tier-price">NZ$500 + GST/mo</span>
              <span class="ga-tier-label">Ongoing management</span>
            </div>
            <div class="ga-tier">
              <span class="ga-tier-price">Ad spend separate</span>
              <span class="ga-tier-label">Paid directly to Google</span>
            </div>
          </div>
        </div>
        <div class="ga-pricing-right">
          <h3>Setup includes:</h3>
          <ul>
            <li>Keyword research & campaign structure</li>
            <li>Ad copywriting & creative</li>
            <li>Conversion tracking setup</li>
            <li>Landing page recommendations</li>
          </ul>
          <h3 class="ga-pricing-subhead">Ongoing management includes:</h3>
          <ul>
            <li>Negative keyword management</li>
            <li>Bid optimisation</li>
            <li>Monthly performance report</li>
            <li>Direct access to Charlie, no account managers</li>
          </ul>
          <a href="/contact/" class="ga-cta-btn">Get a Free Ads Audit</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Real Google Ads results -->
  <section class="section ga-results" id="results">
    <div class="container">
      <SectionHeader
        eyebrow="Real Small Business Results"
        title="Smart Google Ads budgets. Real small-business results."
        light={true}
        subtitle="These are active Google Ads campaigns for small businesses just like yours. With focused targeting and practical daily budgets, the goal is to make every advertising dollar work harder."
      />

      <div class="ga-results-grid">
        <article class="ga-result-card">
          <div class="ga-result-image-wrap">
            <Image src={northShoreFurnitureAdsImg} alt="Google Ads dashboard for North Shore Furniture Assembly showing 12 conversions, 69 clicks and NZ$320 spend" width={1016} height={568} format="webp" quality={85} loading="lazy" class="ga-result-image" />
          </div>
          <div class="ga-result-body">
            <p class="ga-result-label">North Shore Furniture Assembly</p>
            <h3>12 recorded conversions on a NZ$12/day budget</h3>
            <p>Over this 30-day dashboard period, the campaign recorded 12 conversions from 69 clicks with NZ$320 spent. A focused budget, clear search intent and conversion tracking made the activity measurable.</p>
          </div>
        </article>

        <article class="ga-result-card">
          <div class="ga-result-image-wrap">
            <Image src={potholeFixingAdsImg} alt="Google Ads dashboard for an Auckland pothole fixing company showing 102 clicks, 1.35 thousand impressions and NZ$601 spend" width={1016} height={568} format="webp" quality={85} loading="lazy" class="ga-result-image" />
          </div>
          <div class="ga-result-body">
            <p class="ga-result-label">Pothole Fixing Company, Auckland</p>
            <h3>102 clicks on a NZ$30/day budget</h3>
            <p>This active campaign generated 1.35K impressions and 102 clicks at an average CPC of NZ$5.89. It shows how a specialist local service can build visibility on a sensible daily budget.</p>
          </div>
        </article>
      </div>
      <p class="ga-results-note">Google Ads dashboard screenshots from active client campaigns. Results vary with market demand, competition, budgets, offers and landing-page quality.</p>
    </div>
  </section>

  <!-- Strategy session split -->
  <section class="section ga-consult-section">
    <div class="container">
      <div class="ga-consult-split">
        <div class="ga-consult-img-wrap">
          <Image src={about4Img} alt="Free Google Ads strategy session with an Auckland small business owner" width={760} height={520} class="ga-consult-img" />
        </div>
        <div class="ga-consult-content">
          <p class="ga-consult-eyebrow">Free Strategy Session</p>
          <h2 class="ga-consult-title">We start with a plan, not a pitch</h2>
          <p class="ga-consult-desc">Every Google Ads engagement starts with a free audit and strategy session. We map out your market, estimate your cost per lead, and give you honest advice, including whether Google Ads is the right fit for you yet. Auckland clients can meet in person; small businesses throughout New Zealand can work with us online.</p>
          <ul class="ga-consult-list">
            <li>Competitor ad analysis included</li>
            <li>Realistic budget and CPA estimates</li>
            <li>No obligation to proceed</li>
          </ul>
          <a href="/contact/" class="ga-consult-btn">Book Your Free Session →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container" style="max-width: 860px;">
      <FAQAccordion items={faqs} title="Google Ads Questions Answered" subtitle="Common questions from Auckland and New Zealand small businesses about pricing, ad spend and management." />
    </div>
  </section>

  <!-- Related services -->
  <section class="related-strip">
    <div class="container" style="max-width: 860px;">
      <p class="rps-label">Related services</p>
      <div class="rps-links">
        <a href="/paid-ads/" class="rps-link">Paid Ads Auckland</a>
        <a href="/meta-ads/" class="rps-link">Meta Ads Auckland</a>
        <a href="/google-ads-budget-calculator-nz/" class="rps-link">Google Ads Budget Calculator</a>
        <a href="/affordable-seo-auckland/" class="rps-link">SEO Auckland</a>
        <a href="/local-seo-for-auckland-small-businesses/" class="rps-link">Local SEO Auckland</a>
        <a href="/landing-pages-funnels-on-wordpress/" class="rps-link">Landing Pages &amp; Funnels</a>
        <a href="/monthly-subscription/" class="rps-link">Analytics &amp; Reporting</a>
        <a href="/affordable-web-design-auckland/" class="rps-link">Web Design Auckland</a>
      </div>
    </div>
  </section>

  <!-- Case studies -->
  <section class="related-strip">
    <div class="container" style="max-width: 860px;">
      <p class="rps-label">Client case studies</p>
      <div class="rps-links">
        <a href="/case-study-scaffolding/" class="rps-link">Barrett Access Scaffolding case study</a>
        <a href="/beauty-touch-case-study/" class="rps-link">Beauty Touch booking website</a>
      </div>
    </div>
  </section>

  <!-- Areas we serve -->
  <section class="related-strip">
    <div class="container" style="max-width: 860px;">
      <p class="rps-label">Areas we serve</p>
      <div class="rps-links">
        <a href="/north-shore-website-design/" class="rps-link">North Shore</a>
        <a href="/south-auckland-web-design/" class="rps-link">South Auckland</a>
        <a href="/west-auckland-web-design/" class="rps-link">West Auckland</a>
        <a href="/east-auckland-web-design/" class="rps-link">East Auckland</a>
        <a href="/central-auckland-web-design/" class="rps-link">Central Auckland</a>
      </div>
    </div>
  </section>

  <CTABanner
    variant="yellow"
    title="Ready for clearer Google Ads pricing?"
    subtitle="NZ$500 + GST setup and NZ$500 + GST per month for ongoing management, plus your separate Google ad spend. Book a free audit online or call 021 039 6580."
    ctaPrimary={{ text: "Get a Free Ads Audit", href: "/contact/" }}
    ctaSecondary={{ text: "Learn About SEO Too", href: "/affordable-seo-auckland/" }}
  />

</Layout>

<style>
  .ga-industries {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }
  .ga-industry-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.8);
  }
  .ga-check { color: var(--kwd-yellow); flex-shrink: 0; width: 18px; height: 18px; }

  .ga-pricing-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    background: var(--kwd-dark);
    border-radius: 20px;
    padding: 3rem;
    color: #fff;
  }
  .ga-pricing-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
