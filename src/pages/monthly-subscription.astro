---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import CTABanner from '../components/CTABanner.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import subscriptionImage from '../assets/services/website-security-auckland-dashboard-style.jpg';


const included = [
  {
    icon: "🌐",
    title: "Managed Hosting",
    desc: "Fast, reliable WordPress hosting on New Zealand servers. Uptime monitoring, CDN, and performance optimisation included.",
    items: ["NZ-based server", "99.9% uptime SLA", "CDN included", "Uptime monitoring"],
  },
  {
    icon: "🔒",
    title: "Security & Backups",
    desc: "Daily backups, malware scanning, firewall protection, and SSL certificate management. Your site is protected around the clock.",
    items: ["Daily backups (30-day retention)", "SSL management", "Malware scanning", "WordPress firewall"],
  },
  {
    icon: "🔄",
    title: "WordPress Updates",
    desc: "Core WordPress, theme, and plugin updates applied monthly and tested before going live. No more broken sites from update conflicts.",
    items: ["Core WordPress updates", "Plugin updates", "Theme updates", "Pre-update backups"],
  },
  {
    icon: "✏️",
    title: "30 Minutes Content Editing",
    desc: "Need to update your prices, swap an image, add a new team member, or change your opening hours? We handle it for you.",
    items: ["Text & copy updates", "Image swaps", "Page additions", "Menu / price updates"],
  },
  {
    icon: "📊",
    title: "Monthly Report",
    desc: "A simple monthly summary showing your site's traffic, top pages, and key performance metrics. Know how your site is performing.",
    items: ["Google Analytics summary", "Top traffic sources", "Top performing pages", "Month-on-month comparison"],
  },
  {
    icon: "🛎️",
    title: "Priority Support",
    desc: "Got a question or something's gone wrong? As a subscriber you get priority response, typically within a few hours on business days.",
    items: ["Priority email support", "Same-day response (biz hours)", "Issue diagnosis", "Emergency fix guarantee"],
  },
];

const comparisonItems = [
  { label: "Managed WordPress hosting", included: true },
  { label: "SSL certificate", included: true },
  { label: "Daily backups (30-day retention)", included: true },
  { label: "Security monitoring & malware scanning", included: true },
  { label: "Monthly WordPress core + plugin updates", included: true },
  { label: "30 minutes content editing per month", included: true },
  { label: "Monthly performance report", included: true },
  { label: "Priority support response", included: true },
  { label: "Uptime monitoring", included: true },
  { label: "No lock-in contract", included: true },
];


const coverage = [
  {
    title: "WordPress core and plugin updates",
    desc: "Outdated plugins are the single most common cause of WordPress sites being compromised. Every month we apply core, theme, and plugin updates, and we take a restore point before we touch anything so an update conflict never becomes your problem.",
    items: [
      "WordPress core updates applied and tested",
      "Plugin and theme updates, checked for conflicts",
      "A backup taken before every update run",
      "Deprecated or abandoned plugins flagged and replaced",
    ],
  },
  {
    title: "Website security, SSL and firewall",
    desc: "Automated bots scan the internet continuously for vulnerable WordPress installations. Your site does not need to be well known to be targeted. Security runs quietly in the background so you never have to deal with a hacked site.",
    items: [
      "SSL certificate issued, renewed and monitored",
      "Web application firewall filtering malicious traffic",
      "Scheduled malware scanning across files and database",
      "Login protection against brute force attempts",
      "Hardening: file editing disabled, XML-RPC managed, security headers set",
    ],
  },
  {
    title: "Daily backups and fast restoration",
    desc: "Most shared hosting keeps weekly backups on the same server as your site, which is no help if the account itself is compromised or suspended. We keep an independent daily copy offsite, so there is always a clean point to go back to.",
    items: [
      "Automated daily backups of files and database",
      "Stored offsite, separate from the web server",
      "30 days of restore history retained",
      "Backups verified, not just created",
      "Full restore typically completed within 1 to 3 hours",
    ],
  },
  {
    title: "Malware cleanup and hack recovery",
    desc: "If the worst happens, cleanup is covered by your plan rather than billed as an emergency. Reinfection happens when the entry point is left open, so we close it rather than just removing the visible symptoms.",
    items: [
      "Diagnosis of the infection and how it got in",
      "Malware removal, or a clean restore where that is faster",
      "The entry point closed and the site hardened afterwards",
      "Google blacklist and Search Console warning removal",
      "A written incident report explaining what happened",
    ],
  },
  {
    title: "Analytics, Search Console and monthly reporting",
    desc: "Without measurement you cannot tell whether your website is earning its keep. You get a plain-English monthly summary rather than being left to interpret a raw GA4 dashboard.",
    items: [
      "GA4 installed and configured properly",
      "Google Search Console connected and monitored",
      "Enquiry and phone-click conversion tracking",
      "A monthly report: traffic, top pages, sources, conversions",
      "Month-on-month comparison so trends are visible",
    ],
  },
  {
    title: "Content changes, training and handover",
    desc: "Thirty minutes of changes each month covers the things that would otherwise sit on your to-do list for weeks. And if you would rather do it yourself, we will show you how, properly.",
    items: [
      "30 minutes of content editing each month",
      "Text, images, prices, opening hours, new pages",
      "A structured walkthrough of editing your own site",
      "Written notes or a recording to refer back to",
      "Full credentials handover, no dependency by design",
    ],
  },
];

const faqs = [
  { q: "What is included in the care plan?", a: "Managed WordPress hosting, core and plugin updates, website security and firewall, daily offsite backups, malware cleanup if you ever need it, analytics and a monthly report, 30 minutes of content editing, and priority support. One monthly fee, no lock-in." },
  { q: "Do I need a care plan if my website is brand new?", a: "A new site is the ideal time to start. Updates are released constantly for WordPress core, plugins, and themes, and vulnerabilities accumulate quickly without regular maintenance. The first 6 to 12 months are when most sites become exposed if left unattended." },
  { q: "Can you maintain a WordPress site you did not build?", a: "Yes. We can take over any WordPress site. We start with an audit to understand the current state of the site, its plugins, and any existing issues. If it turns out the site needs more than maintenance, we also offer <a href=\"/wordpress-website-rebuilds-auckland/\">WordPress website rebuilds</a>." },
  { q: "What happens if my site gets hacked while I am on the plan?", a: "Malware removal is covered. We diagnose the infection, clean it, close the entry point that allowed it, restore from a clean backup if that is faster, and handle any Google blacklist removal. There is no extra charge beyond your plan." },
  { q: "How likely is my small business website to be attacked?", a: "More likely than most people expect. Automated bots scan continuously for vulnerable WordPress installations, and small business sites are targeted precisely because they tend to be less well protected. It is rarely personal and almost never manual." },
  { q: "Do I need security if my site is a simple brochure with no logins?", a: "Yes. Every WordPress site has a login page even if your visitors never see it, and attackers target the backend rather than the front end. A compromised brochure site can be used to send spam or host phishing pages without you noticing anything." },
  { q: "Does my hosting company not already back up my site?", a: "Most shared hosting includes server-level backups, but they are often weekly, stored on the same server, and may exclude the database. If the hosting account itself is compromised or suspended, those backups can go with it. An independent daily offsite backup is a separate safety net." },
  { q: "How far back can I restore, and how long does it take?", a: "We retain 30 days of history, so a problem you only notice three weeks later is still recoverable. A full restore usually takes 1 to 3 hours depending on site size; partial restores of just the database or specific files are faster." },
  { q: "Is there a minimum contract period?", a: "No lock-in. The plan runs month-to-month and you can cancel with 30 days notice. We would rather earn your continued business than trap you in a contract." },
  { q: "What counts as a content change?", a: "Text updates, image swaps, adding or removing pages, menu changes, price updates, publishing blog posts, anything that does not require custom development. Major new features or a redesign are quoted separately." },
  { q: "What if I need more than 30 minutes of changes in a month?", a: "Additional time is billed at our standard hourly rate, and we will always tell you before starting if a request is going to exceed your monthly allocation. If you regularly need more, we can add a discounted block of prepaid hours." },
  { q: "Can I still learn to manage the site myself?", a: "Yes, and we encourage it. Every build includes a structured handover session walking through your actual site, plus written notes or a recording. The plan is there to take work off your plate, not to make you dependent on us." },
  { q: "Does the plan include SEO?", a: "No, SEO is a separate service. The plan covers hosting, maintenance, security, backups, reporting, and minor content changes. We offer <a href=\"/local-seo-for-auckland-small-businesses/\">local SEO</a> and <a href=\"/wordpress-seo-optimisation/\">WordPress SEO</a> as add-ons that can be bundled with your plan." },
  { q: "What about domains and email?", a: "Those are handled separately, and we offer both: <a href=\"/domain-management-auckland/\">domain management</a> for DNS, renewals and transfers, and <a href=\"/email-setup-business-email-hosting/\">business email setup</a> on Microsoft 365 or Google Workspace." },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.kiwiwebdesign.co.nz/monthly-subscription/",
      "url": "https://www.kiwiwebdesign.co.nz/monthly-subscription/",
      "name": "WordPress Maintenance Auckland | Website Care Plan & Managed Hosting",
      "description": "WordPress maintenance, security, daily backups, malware cleanup and monthly reporting in one care plan for Auckland small businesses. No lock-in contract.",
      "mainEntity": { "@id": "https://www.kiwiwebdesign.co.nz/monthly-subscription/#service" },
      "inLanguage": "en-NZ",
      "isPartOf": { "@id": "https://www.kiwiwebdesign.co.nz/#website" },
      "breadcrumb": { "@id": "https://www.kiwiwebdesign.co.nz/monthly-subscription/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.kiwiwebdesign.co.nz/monthly-subscription/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.kiwiwebdesign.co.nz/" },
        { "@type": "ListItem", "position": 2, "name": "WordPress Maintenance & Website Care" }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://www.kiwiwebdesign.co.nz/monthly-subscription/#service",
      "name": "WordPress maintenance and website care plan",
      "serviceType": "Website maintenance",
      "description": "A single monthly plan covering managed WordPress hosting, core and plugin updates, website security, daily offsite backups, malware cleanup, analytics reporting, and 30 minutes of content editing.",
      "provider": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "areaServed": [
        { "@type": "Place", "name": "Auckland" },
        { "@type": "Place", "name": "New Zealand" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "What the care plan covers",
        "itemListElement": coverage.map((c) => ({
          "@type": "Offer",
          "itemOffered": { "@type": "Service", "name": c.title, "description": c.desc }
        }))
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.kiwiwebdesign.co.nz/monthly-subscription/#faq",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/<[^>]+>/g, "") }
      }))
    },
    {
      "@type": "Organization",
      "@id": "https://www.kiwiwebdesign.co.nz/#organization",
      "name": "Kiwi Web Design",
      "url": "https://www.kiwiwebdesign.co.nz/"
    }
  ]
};

---

<Layout
  title="WordPress Maintenance Auckland | Website Care Plan & Managed Hosting"
  description="WordPress maintenance, security, daily backups, malware cleanup and monthly reporting in one care plan for Auckland small businesses. No lock-in contract."
  canonicalURL="https://www.kiwiwebdesign.co.nz/monthly-subscription/"
  schema={schema}
>

  <PageHero
    eyebrow="Website Care Plan"
    title="WordPress maintenance and website care for Auckland businesses"
    subtitle="Managed hosting, security, daily backups, updates, malware protection, and 30 minutes of content editing, all for a single monthly fee. No surprises, no lock-in."
    badgeText="$59/mo + GST"
    ctaPrimary={{ text: "Get Started", href: "/contact/" }}
    ctaSecondary={{ text: "See What's Included", href: "#included" }}
    imgSrc={subscriptionImage.src}
    imgAlt="Managed website subscription dashboard for Auckland businesses"
    imgTitle="Monthly website subscription Auckland"
  />

  <!-- Main plan card -->
  <section class="section" style="background: var(--kwd-cream);">
    <div class="container">
      <div class="ms-plan-card">
        <div class="ms-plan-left">
          <p class="ms-plan-eyebrow">The Plan</p>
          <h2 class="ms-plan-title">Managed Website Subscription</h2>
          <p class="ms-plan-desc">One flat monthly fee covers everything your website needs to stay fast, secure, and up to date. You focus on running your business, we handle the tech.</p>
          <div class="ms-plan-price-row">
            <span class="ms-plan-price">$59</span>
            <div class="ms-plan-price-detail">
              <span class="ms-plan-per">/month</span>
              <span class="ms-plan-gst">excl. GST</span>
            </div>
          </div>
          <p class="ms-plan-note">No lock-in contract. Cancel with 30 days notice.</p>
          <a href="/contact/" class="ms-plan-btn">Get Started →</a>
        </div>
        <div class="ms-plan-right">
          <p class="ms-plan-list-label">What's included every month:</p>
          <ul class="ms-plan-checklist">
            {comparisonItems.map(({ label }) => (
              <li>
                <span class="ms-check">✓</span>
                {label}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature breakdown -->
  <section class="section" id="included">
    <div class="container">
      <SectionHeader
        eyebrow="Service Breakdown"
        title="Everything included. Explained"
        subtitle="We don't hide things in the fine print. Here's exactly what you get each month."
      />
      <ServiceGrid items={included} cols={3} />
    </div>
  </section>

  <!-- Deep coverage detail -->
  <section class="section" id="covered" style="background: var(--kwd-cream);">
    <div class="container">
      <SectionHeader
        eyebrow="In Detail"
        title="What the care plan actually covers"
        subtitle="The full detail behind each part of the plan, so you know exactly what you are paying for."
      />
      <div class="ms-cover">
        {coverage.map(({ title, desc, items }) => (
          <article class="ms-cover-item">
            <h3 class="ms-cover-title">{title}</h3>
            <p class="ms-cover-desc">{desc}</p>
            <ul class="ms-cover-list">
              {items.map((i) => <li>{i}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why it matters -->
  <section class="section" style="background: var(--kwd-dark);">
    <div class="container">
      <div class="ms-why-grid">
        <div class="ms-why-text">
          <p class="ms-why-eyebrow">Why It Matters</p>
          <h2>A neglected website costs you more than a managed one</h2>
          <p>Outdated plugins are the #1 cause of WordPress hacks. Slow hosting means Google ranks you lower. An unmaintained site sends the wrong signal to potential customers.</p>
          <p>For $59/month, you get the peace of mind that your site is secure, backed up, and professionally maintained, without having to think about it.</p>
        </div>
        <div class="ms-why-stats">
          <div class="ms-why-stat">
            <span class="ms-why-num">97%</span>
            <span class="ms-why-label">of WordPress hacks are due to outdated plugins or themes</span>
          </div>
          <div class="ms-why-stat">
            <span class="ms-why-num">1s</span>
            <span class="ms-why-label">delay in page load time reduces conversions by 7%</span>
          </div>
          <div class="ms-why-stat">
            <span class="ms-why-num">30 days</span>
            <span class="ms-why-label">of backups retained, we can restore to any point</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Add-ons -->
  <section class="section" style="background: var(--kwd-cream);">
    <div class="container">
      <SectionHeader
        eyebrow="Optional Add-Ons"
        title="Level up your subscription"
        subtitle="Bundle extra services alongside your managed hosting for a combined monthly rate."
      />
      <div class="ms-addons">
        <div class="ms-addon">
          <span class="ms-addon-icon">🔍</span>
          <div>
            <strong>Local SEO Management</strong>
            <p>Monthly Google Business Profile optimisation, citation management, and local ranking reports.</p>
            <span class="ms-addon-price">From +$299/mo</span>
          </div>
        </div>
        <div class="ms-addon">
          <span class="ms-addon-icon">✍️</span>
          <div>
            <strong>Monthly Blog Post</strong>
            <p>One SEO-optimised blog post per month written, formatted, and published for you.</p>
            <span class="ms-addon-price">From +$199/mo</span>
          </div>
        </div>
        <div class="ms-addon">
          <span class="ms-addon-icon">⏱️</span>
          <div>
            <strong>Extra Change Hours</strong>
            <p>Need more than 30 minutes? Add a bank of prepaid hours at a discounted rate.</p>
            <span class="ms-addon-price">$100/hr (5hr block)</span>
          </div>
        </div>
        <div class="ms-addon">
          <span class="ms-addon-icon">📣</span>
          <div>
            <strong>Google Ads Management</strong>
            <p>Full campaign management including setup, optimisation, and monthly reporting.</p>
            <span class="ms-addon-price">From +$399/mo</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container" style="max-width: 860px;">
      <FAQAccordion
        items={faqs}
        title="Subscription Questions Answered"
        subtitle="Common questions about the monthly plan before signing up."
      />
    </div>
  </section>

  <!-- Related services -->
  <section class="related-strip">
    <div class="container" style="max-width: 860px;">
      <p class="rps-label">Related services</p>
      <div class="rps-links">
        <a href="/website-hosting-auckland/" class="rps-link">Website Hosting</a>
        <a href="/domain-management-auckland/" class="rps-link">Domain Management</a>
        <a href="/email-setup-business-email-hosting/" class="rps-link">Business Email</a>
        <a href="/wordpress-website-design-auckland/" class="rps-link">WordPress Design</a>
        <a href="/small-business-website-design-auckland/" class="rps-link">Web Design Packages</a>
        <a href="/contact/" class="rps-link">Contact</a>
      </div>
    </div>
  </section>

  <CTABanner
    variant="yellow"
    title="Ready to take website maintenance off your plate?"
    subtitle="Get started today, we'll migrate your site and have it under management within 48 hours."
    ctaPrimary={{ text: "Get Started", href: "/contact/" }}
    ctaSecondary={{ text: "See Web Design Packages", href: "/small-business-website-design-auckland/" }}
  />

</Layout>

<style>
  /* Plan card */
  .ms-plan-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    background: var(--kwd-dark);
    border-radius: 20px;
    padding: 3rem;
    color: #fff;
  }
  .ms-plan-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--kwd-yellow);
    margin-bottom: 0.75rem;
  }
  .ms-plan-title {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .ms-plan-desc {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .ms-plan-price-row {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .ms-plan-price {
    font-family: var(--kwd-font-heading);
    font-size: 3.5rem;
    color: var(--kwd-yellow);
    line-height: 1;
  }
  .ms-plan-price-detail {
    display: flex;
    flex-direction: column;
    padding-bottom: 0.5rem;
  }
  .ms-plan-per {
    font-size: 1rem;
    color: rgba(255,255,255,0.7);
    font-weight: 600;
  }
  .ms-plan-gst {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
  }
  .ms-plan-note {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.45);
    margin-bottom: 1.75rem;
  }
  .ms-plan-btn {
    display: inline-block;
    background: var(--kwd-yellow);
    color: var(--kwd-dark);
    padding: 0.875rem 2rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    transition: background 0.2s;
  }
  .ms-plan-btn:hover { background: var(--kwd-gold); }

  /* Right checklist */
  .ms-plan-list-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.45);
    margin-bottom: 1.25rem;
  }
  .ms-plan-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .ms-plan-checklist li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.8);
  }
  .ms-check {
    color: var(--kwd-yellow);
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Why section */
  .ms-why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .ms-why-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--kwd-yellow);
    margin-bottom: 0.75rem;
  }
  .ms-why-text h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: #fff;
    margin-bottom: 1rem;
  }
  .ms-why-text p {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }
  .ms-why-stats {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .ms-why-stat {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .ms-why-num {
    font-family: var(--kwd-font-heading);
    font-size: 2rem;
    color: var(--kwd-yellow);
    flex-shrink: 0;
    min-width: 80px;
  }
  .ms-why-label {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.5;
  }

  /* Add-ons */
  .ms-addons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .ms-addon {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: #fff;
    border: 1.5px solid rgba(0,0,0,0.08);
    border-radius: 14px;
    padding: 1.5rem;
  }
  .ms-addon-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    width: 2.25rem;
    text-align: center;
  }
  .ms-addon strong {
    display: block;
    font-size: 0.95rem;
    color: var(--kwd-dark);
    margin-bottom: 0.3rem;
  }
  .ms-addon p {
    font-size: 0.82rem;
    color: var(--kwd-brown);
    line-height: 1.55;
    margin: 0 0 0.6rem;
  }
  .ms-addon-price {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--kwd-dark);
