---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import StatsRow from '../components/StatsRow.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTABanner from '../components/CTABanner.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import tradieHeroImg from '../assets/general/Auckland_Plumber-e1750286113265.jpg';

const faqs = [
  { q: "Do tradies really need a website in 2025?", a: "Yes, more than ever. 70% of homeowners research a tradie online before calling. Without a website, you're invisible to that majority. A Facebook page isn't enough, Google doesn't show Facebook pages in local search results the way it shows websites. See our <a href=\"/small-business-website-design-auckland/\">tradie web design packages</a> to get started." },
  { q: "How is a tradie website different from a standard business website?", a: "A tradie site is built around calls and quote requests. The phone number is front and centre, there's a gallery of completed work, individual service pages for each trade type, and <a href=\"/local-seo-for-auckland-small-businesses/\">local SEO</a> targeting the suburbs you work in. It's a lead machine, not a brochure." },
  { q: "What photos do I need to provide?", a: "Before and after photos of your work are ideal. We can also source stock imagery as a placeholder while you build up your own photo library. We'll advise you on the best shots to take on your phone, it doesn't need to be professional photography. Your site is built on <a href=\"/monthly-subscription/\">WordPress</a> so you can add photos yourself once live." },
  { q: "Can you include a quote request form?", a: "Yes. Every tradie site we build includes a contact form with fields relevant to your trade (job type, address, preferred timeframe). We can also set up email notifications so you're alerted immediately when a new enquiry comes in. For service businesses that need scheduling, we can also integrate <a href=\"/booking-appointment-websites-with-wordpress/\">appointment booking</a>." },
  { q: "Do you handle Google Business Profile too?", a: "We include a basic Google Business Profile setup with every website build. A full <a href=\"/google-business-profile-guide-for-auckland-businesses/\">Google Business Profile optimisation</a> is $299 + GST as a one-off, and ongoing GBP management (weekly posts, review responses, Q&A) is available as part of our <a href=\"/local-seo-for-auckland-small-businesses/\">local SEO service</a>." },
  { q: "How much does a tradie website cost?", a: "Every <a href=\"/small-business-website-design-auckland/\">tradie website</a> is scoped around the pages, services, gallery, forms, and integrations your business needs. We provide a fixed quote before work begins. You can also add <a href=\"/google-ads/\">Google Ads</a> to generate immediate leads while your SEO builds." },
  { q: "What should a tradie website include?", a: "At minimum: a phone number people can tap on every page, a page for each main service, the suburbs you cover, real photos of your finished work, Google reviews, a quote form that asks for the right details, and your licence or registration details where they apply. See <a href=\"#checklist\">our checklist</a> for what each one involves." },
  { q: "Do I need a separate page for each service and suburb?", a: "A separate page for each main service helps each one rank and answer one question clearly, such as switchboard upgrades or bathroom renovations. Suburb pages are worth building only where you genuinely work and can say something specific, such as jobs you have completed there. Dozens of near-identical suburb pages add little and can dilute the site, so we plan the page structure with you before design starts." },
  { q: "Should a tradie use a website builder or a custom WordPress site?", a: "A builder can work for a very simple site, especially when you are starting out. A custom WordPress site gives you more control over page structure, service pages, speed, and how enquiries are tracked. We compared the main options in our <a href=\"/affordable-web-design-auckland/best-website-builders-new-zealand/\">guide to website builders in New Zealand</a>, including when a builder is enough." },
  { q: "How long does a tradie website take to build?", a: "Typically 2–3 weeks from the free discovery call, once we have your photos, services, and service areas. The timing depends on the number of pages and how quickly your content arrives." },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.kiwiwebdesign.co.nz/tradie-website-design-auckland/",
      "url": "https://www.kiwiwebdesign.co.nz/tradie-website-design-auckland/",
      "name": "Tradie Website Design Auckland | Websites for NZ Tradies",
      "description": "Kiwi Web Design builds affordable websites for Auckland tradies, plumbers, electricians, builders, and more. Fixed, project-specific quotes. Free consultation.",
      "inLanguage": "en-NZ",
      "isPartOf": { "@id": "https://www.kiwiwebdesign.co.nz/#website" },
      "about": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "breadcrumb": { "@id": "https://www.kiwiwebdesign.co.nz/tradie-website-design-auckland/#breadcrumb" },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".tradie-snippet", ".stats-row"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.kiwiwebdesign.co.nz/tradie-website-design-auckland/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.kiwiwebdesign.co.nz/" },
        { "@type": "ListItem", "position": 2, "name": "Tradie Website Design", "item": "https://www.kiwiwebdesign.co.nz/tradie-website-design-auckland/" }
      ]
    },
    {
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": "https://www.kiwiwebdesign.co.nz/#organization",
      "name": "Kiwi Web Design",
      "alternateName": "Web Design Auckland",
      "url": "https://www.kiwiwebdesign.co.nz/",
      "telephone": "+64-21-039-6580",
      "email": "hi@kiwiwebdesign.co.nz",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "147 Great North Road",
        "addressLocality": "Grey Lynn",
        "addressRegion": "Auckland",
        "postalCode": "1021",
        "addressCountry": "NZ"
      },
      "areaServed": [
        { "@type": "City", "name": "Auckland" },
        { "@type": "Country", "name": "New Zealand" }
      ],
      "priceRange": "$$",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.kiwiwebdesign.co.nz/favicon.png",
        "width": 512,
        "height": 512
      }
    },
    {
      "@type": "Service",
