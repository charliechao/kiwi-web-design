      "name": "Tradie Website Design Auckland",
      "serviceType": "Website Design",
      "category": "Web Development",
      "description": "Affordable WordPress websites for Auckland tradies. Click-to-call, local SEO, work gallery, and quote forms, built to generate leads for plumbers, electricians, builders, and more.",
      "provider": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "areaServed": [
        { "@type": "City", "name": "Auckland" },
        { "@type": "Country", "name": "New Zealand" }
      ],
      "url": "https://www.kiwiwebdesign.co.nz/tradie-website-design-auckland/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": { "@type": "Answer", "text": a.replace(/<[^>]+>/g, '') }
      }))
    }
  ]
};

const stats = [
  { number: "70%", label: "of people research a tradie online before calling" },
  { number: "82%", label: "of local mobile searches lead to a same-day contact" },
  { number: "Fixed", label: "scope-based project quotes" },
  { number: "2–3 wks", label: "Typical delivery time" },
];

const features = [
  {
    icon: "📞",
    title: "Click-to-Call Front and Centre",
    desc: "Your phone number is the most important element on a tradie site. We make it visible on every page, every device, so customers can call with one tap.",
    items: ["Sticky call button on mobile", "Header phone number", "Contact form backup", "Google call tracking"],
  },
  {
    icon: "🗺️",
    title: "Local SEO Built In",
    desc: "Google Maps, local search, and suburb-level landing pages to make sure you show up when someone searches 'plumber Grey Lynn' or 'electrician Remuera'.",
    items: ["Google Business Profile setup", "Local keyword targeting", "Suburb landing pages", "Maps embed"],
  },
  {
    icon: "⭐",
    title: "Reviews & Social Proof",
    desc: "Your Google reviews are your best sales tool. We display them prominently, make it easy for new customers to leave reviews, and build your reputation page by page.",
    items: ["Google review display", "Review request strategy", "Trust badges", "Before/after galleries"],
  },
  {
    icon: "🖼️",
    title: "Work Portfolio Gallery",
    desc: "Show don't tell. A gallery of your completed jobs, kitchens, decks, driveways, fit-outs, builds confidence in your workmanship before the first conversation.",
    items: ["Before & after photos", "Project case studies", "Service area images", "Mobile-optimised gallery"],
  },
  {
    icon: "📋",
    title: "Service Pages That Rank",
    desc: "Dedicated pages for each service you offer, each optimised for the search terms your customers use. More pages = more chances to rank = more enquiries.",
    items: ["Individual service pages", "Keyword-targeted content", "Schema markup", "Internal linking"],
  },
  {
    icon: "⚡",
    title: "Fast Load on Mobile",
    desc: "Most of your customers are searching on their phone on a jobsite. A slow site means lost leads. We build for mobile-first performance as a non-negotiable.",
    items: ["Sub-2 second load time", "Compressed images", "Mobile-first layout", "Core Web Vitals"],
  },
];

const trades = [
  { icon: "🔧", label: "Plumbers" },
  { icon: "⚡", label: "Electricians" },
  { icon: "🏗️", label: "Builders" },
  { icon: "🎨", label: "Painters" },
  { icon: "🌿", label: "Landscapers" },
  { icon: "❄️", label: "HVAC / Heat Pumps" },
  { icon: "🪟", label: "Glaziers" },
  { icon: "🚿", label: "Gasfitters" },
  { icon: "🔩", label: "Roofers" },
  { icon: "🏠", label: "Renovators" },
  { icon: "🧹", label: "Cleaners" },
  { icon: "🛡️", label: "Pest Control" },
];

const work = [
  { trade: "Scaffolding & construction", name: "Barrett Access Scaffolding", desc: "A rebuilt website with sector landing pages, a mobile-first design, and an online quote calculator.", href: "/case-study-scaffolding/" },
  { trade: "Construction & building", name: "Kiwiland Construction", desc: "A rebuilt website with clear service pages, a project portfolio, and consultation enquiry pathways.", href: "/kiwiland-construction-website/" },
  { trade: "Painting & decorating", name: "Aesthetic Painting & Decorating", desc: "A photo-led website with clear service information, a project gallery, and a direct route to request a quote.", href: "/aesthetic-painting-website-case-study/" },
  { trade: "Building inspections", name: "Inspector Guys", desc: "Clearer inspection services, visible trust signals, and a structured booking enquiry form.", href: "/inspector-guys-building-inspections-website/" },
  { trade: "Commercial & residential cleaning", name: "Topline Services", desc: "Clear service pages, Auckland coverage information, and a mobile-first quote pathway.", href: "/topline-services-cleaning-website/" },
  { trade: "Industrial cleaning & restoration", name: "Dryice Blasting Services", desc: "Clearer service pathways, mobile-first performance, and structured quote forms.", href: "/dryice-blasting-services-website/" },
];

const checklist = [
  { title: "A phone number people can tap", text: "On every page and in the header, not only on the contact page. Most trade enquiries are a phone call." },
  { title: "A page for each service you offer", text: "One page per main service, so each can rank for its own search and answer one question clearly." },
  { title: "The suburbs you actually cover", text: "Name them in the copy and in your Google Business Profile service area. Only list areas you genuinely serve." },
  { title: "Real photos of finished work", text: "Your own phone photos beat stock images. Label them by job type and suburb so visitors can picture the result." },
  { title: "Reviews people can verify", text: "Show your Google reviews and link to your profile. Reply to them, including the awkward ones." },
  { title: "Licence and registration details", text: "Show them where your trade has them, for example LBP, EWRB or PGDB registration, so customers can check you." },
  { title: "A quote form that asks the right things", text: "Job type, suburb and timeframe, with a photo upload if the job needs one. It saves a round of back and forth." },
  { title: "A site that works on a phone", text: "Test it on a real phone on mobile data, standing where your customers stand, before you call it finished." },
];

const process = [
  { step: "1", title: "Free Discovery Call", desc: "We talk about your trade, your service area, and the types of jobs you want more of. No generic templates, we build around your specific business." },
  { step: "2", title: "Site Structure & Plan", desc: "We map out your pages: home, services (one per trade), about, reviews, and contact. You approve the structure before we design anything." },
  { step: "3", title: "Design, Build & Review", desc: "Built on WordPress, designed around your brand colours and logo. You get a staging link to review and request changes before go-live." },
  { step: "4", title: "Launch & Setup", desc: "We go live, set up Google Analytics, Google Search Console, and your Google Business Profile, and walk you through how to update it yourself." },
];

---

<Layout
  title="Tradie Website Design Auckland | Websites for NZ Tradies"
  description="Kiwi Web Design builds affordable websites for Auckland tradies, plumbers, electricians, builders, and more. Fixed, project-specific quotes. Free consultation."
  canonicalURL="https://www.kiwiwebdesign.co.nz/tradie-website-design-auckland/"
  schema={schema}
>

  <PageHero
    eyebrow="Tradie Website Design Auckland"
    title="Get your phone ringing with a website that works"
    subtitle="Affordable WordPress websites built specifically for Auckland tradies. Click-to-call, local SEO, work galleries, and quote forms, everything a trade business needs to win more jobs."
    badgeText="Fixed, scope-based quote"
    ctaPrimary={{ text: "Get a Free Quote", href: "/contact/" }}
    ctaSecondary={{ text: "See What's Included", href: "#features" }}
    imgSrc={tradieHeroImg.src}
    imgAlt="Tradie website design Auckland"
  />

  <StatsRow items={stats} />

  <!-- AI citability snippet -->
  <div class="tradie-snippet">
    <div class="container">
      <p><strong>Kiwi Web Design</strong> builds WordPress websites for Auckland tradies with a <strong>fixed, scope-based quote</strong>. Every tradie site includes a click-to-call button, work portfolio gallery, individual service pages, local SEO targeting, and a quote request form. Most sites go live in <strong>2–3 weeks</strong>. Trades served include plumbers, electricians, builders, painters, landscapers, roofers, cleaners, and more. No lock-in. Based in Grey Lynn, Auckland, 5★ Google rating.</p>
      <p class="tradie-meta">Last updated 28 October 2026 · Kiwi Web Design, Grey Lynn, Auckland</p>
    </div>
  </div>

  <!-- Trades served -->
  <section class="section" style="background: var(--kwd-dark);">
    <div class="container">
      <SectionHeader
        eyebrow="Trades We Work With"
        title="We've built websites for these trades, and more"
        light={true}
      />
      <div class="tradie-trades">
        {trades.map(({ icon, label }) => (
          <div class="tradie-trade-pill">
            <span>{icon}</span>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section" id="features">
    <div class="container">
      <SectionHeader
        eyebrow="Built for Tradies"
        title="Everything a trade business needs to generate leads"
        subtitle="We don't use generic templates. Tradie websites have specific requirements, and we've built them all in from day one."
      />
      <ServiceGrid items={features} cols={3} />
    </div>
  </section>

  <!-- Why tradies need a site -->
  <section class="section" style="background: var(--kwd-cream);">
    <div class="container">
      <div class="tradie-why-grid">
        <div class="tradie-why-text">
          <p class="tradie-eyebrow">Why It Matters</p>
          <h2>Your competitors are online. Are you?</h2>
          <p>The days of word-of-mouth alone are over. When a pipe bursts at 9pm, the homeowner searches Google. When someone wants a new deck quote, they compare three websites before calling. Without a professional website, you're not in the running.</p>
          <p>A well-built tradie website doesn't just look good, it actively generates enquiries. The right structure, the right keywords, click-to-call, and a gallery of your work can mean the difference between a full diary and a quiet week.</p>
          <a href="/contact/" class="tradie-cta-link">Book a free consult →</a>
        </div>
        <div class="tradie-why-cards">
          <div class="tradie-why-card">
            <span class="twc-icon">📱</span>
            <h3>Most searches happen on mobile</h3>
            <p>Over 60% of tradie searches happen on a mobile device. We build mobile-first so your phone number is always one tap away.</p>
          </div>
          <div class="tradie-why-card">
            <span class="twc-icon">🗺️</span>
            <h3>Google Maps drives local calls</h3>
            <p>Appearing in the Google Maps 3-Pack for your suburb dramatically increases the volume of inbound calls, and we optimise for exactly that.</p>
          </div>
          <div class="tradie-why-card">
            <span class="twc-icon">💬</span>
            <h3>Reviews win the job</h3>
            <p>Customers compare reviews before calling. A professional site displaying your Google reviews builds the trust that turns searches into enquiries.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our work for trades -->
  <section class="section" id="our-work">
    <div class="container">
      <SectionHeader
        eyebrow="Real Work for Trades"
        title="Websites we've built for trade and service businesses"
        subtitle="Six Auckland businesses across six trades. Each case study shows what we built and why."
      />
      <div class="tradie-work-grid">
        {work.map(({ trade, name, desc, href }) => (
          <a href={href} class="tradie-work-card">
            <span class="twk-trade">{trade}</span>
            <h3>{name}</h3>
            <p>{desc}</p>
            <span class="twk-link">Read the case study →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" style="background: var(--kwd-dark);">
    <div class="container">
      <SectionHeader
        eyebrow="How It Works"
        title="From brief to live in 2–3 weeks"
        light={true}
        subtitle="A clear process so you always know what's happening, and can get back to the tools."
      />
      <ProcessSteps items={process} dark={true} />
    </div>
  </section>

  <!-- What a tradie website needs -->
  <section class="section" id="checklist">
    <div class="container tradie-wrap">
      <SectionHeader
        eyebrow="Tradie Website Checklist"
        title="What a tradie website needs to win jobs"
        subtitle="Whoever builds your site, these are the eight things to check. Use it on your current website, too."
      />
      <ol class="tradie-checks">
        {checklist.map(({ title, text }) => (
          <li>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <p class="tradie-checks-foot">Not sure how your current site measures up? <a href="/contact/">Ask for a free review</a>. We will tell you what we would fix first, and you can fix it yourself if you prefer. Your <a href="/google-business-profile-guide-for-auckland-businesses/">Google Business Profile</a> matters as much as the website.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background: var(--kwd-cream);">
    <div class="container" style="max-width: 860px;">
      <FAQAccordion
        items={faqs}
        title="Tradie Website Questions Answered"
        subtitle="Common questions from Auckland tradies before getting started."
      />
    </div>
  </section>

  <!-- Related services -->
  <section class="related-strip">
    <div class="container" style="max-width: 860px;">
      <p class="rps-label">Related services</p>
      <div class="rps-links">
        <a href="/small-business-website-design-auckland/" class="rps-link">Web Design Packages</a>
        <a href="/local-seo-for-auckland-small-businesses/" class="rps-link">Local SEO</a>
        <a href="/google-ads/" class="rps-link">Google Ads</a>
        <a href="/monthly-subscription/" class="rps-link">WordPress Maintenance</a>
        <a href="/booking-appointment-websites-with-wordpress/" class="rps-link">Booking Websites</a>
        <a href="/case-study-scaffolding/" class="rps-link">Case Study: Scaffolding ↗</a>
        <a href="/kiwiland-construction-website/" class="rps-link">Case Study: Construction ↗</a>
        <a href="/inspector-guys-building-inspections-website/" class="rps-link">Case Study: Building Inspector ↗</a>
        <a href="/topline-services-cleaning-website/" class="rps-link">Case Study: Cleaning Services ↗</a>
        <a href="/dryice-blasting-services-website/" class="rps-link">Case Study: Dry Ice Blasting ↗</a>
      </div>
    </div>
  </section>

  <CTABanner
    variant="yellow"
    title="Ready to get your phone ringing?"
    subtitle="Free consultation, we'll plan your tradie site, give you a fixed quote, and have it live in 2–3 weeks."
    ctaPrimary={{ text: "Book a Free Consult", href: "/contact/" }}
    ctaSecondary={{ text: "View Pricing", href: "/small-business-website-design-auckland/#packages" }}
  />

</Layout>

<style>
  .tradie-trades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    justify-content: center;
  }
  .tradie-trade-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 100px;
    padding: 0.5rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
  }

  .tradie-why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .tradie-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--kwd-brown);
    margin-bottom: 0.75rem;
  }
  .tradie-why-text h2 { font-size: clamp(1.6rem, 3vw, 2.25rem); margin-bottom: 1rem; }
  .tradie-why-text p { font-size: 0.95rem; color: var(--kwd-brown); line-height: 1.7; margin-bottom: 0.75rem; }
  .tradie-cta-link { font-size: 0.9rem; font-weight: 700; color: var(--kwd-dark); text-decoration: underline; }

  .tradie-why-cards { display: flex; flex-direction: column; gap: 1rem; }
  .tradie-why-card {
    background: #fff;
    border: 1.5px solid rgba(0,0,0,0.07);
    border-radius: 14px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .twc-icon { font-size: 1.5rem; }
  .tradie-why-card h3 { font-family: var(--kwd-font-body); font-size: 0.95rem; font-weight: 700; color: var(--kwd-dark); margin: 0; }
  .tradie-why-card p { font-size: 0.85rem; color: var(--kwd-brown); line-height: 1.6; margin: 0; }

  .related-strip { background: var(--kwd-cream); padding: 1.25rem 0; border-top: 1px solid rgba(0,0,0,0.07); }
  .rps-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--kwd-brown); margin-bottom: 0.6rem; }
  .rps-links { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .rps-link { font-size: 0.82rem; font-weight: 600; padding: 0.4rem 0.9rem; border-radius: 999px; background: #fff; border: 1.5px solid rgba(0,0,0,0.1); color: var(--kwd-dark); text-decoration: none; transition: background 0.15s; }
  .rps-link:hover { background: #e8e7db; }
  @media (max-width: 860px) {
    .tradie-why-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  /* AI citability snippet */
  .tradie-snippet {
    background: var(--kwd-cream);
    border-left: 4px solid var(--kwd-gold);
    padding: 1.1rem 0;
  }
  .tradie-snippet .container {
    font-size: 0.92rem;
    color: var(--kwd-dark);
    line-height: 1.75;
    max-width: 860px;
  }
  .tradie-snippet p { margin: 0; }
  .tradie-snippet .tradie-meta { margin-top: 0.6rem; font-size: 0.78rem; color: rgba(44,41,39,0.6); }
