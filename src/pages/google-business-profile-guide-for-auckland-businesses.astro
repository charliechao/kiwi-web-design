---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatsRow from '../components/StatsRow.astro';
import CTABanner from '../components/CTABanner.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import PageVisual from '../components/PageVisual.astro';
import gbpImage from '../assets/services/google-business-profile-setup-optimisation-auckland.png';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.kiwiwebdesign.co.nz/google-business-profile-guide-for-auckland-businesses/",
      "url": "https://www.kiwiwebdesign.co.nz/google-business-profile-guide-for-auckland-businesses/",
      "name": "Google Business Profile Optimisation NZ | GBP Management Auckland",
      "description": "Google Business Profile optimisation for Auckland and NZ businesses. One-off GBP setup and optimisation for $299, plus a free 7-step DIY guide covering categories, NAP, photos, reviews, posts, and tracking.",
      "inLanguage": "en-NZ",
      "dateModified": "2026-10-15",
      "isPartOf": { "@id": "https://www.kiwiwebdesign.co.nz/#website" },
      "about": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "breadcrumb": { "@id": "https://www.kiwiwebdesign.co.nz/google-business-profile-guide-for-auckland-businesses/#breadcrumb" },
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".gbp-snippet", "h1"] }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.kiwiwebdesign.co.nz/google-business-profile-guide-for-auckland-businesses/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.kiwiwebdesign.co.nz/" },
        { "@type": "ListItem", "position": 2, "name": "Google Business Profile Guide", "item": "https://www.kiwiwebdesign.co.nz/google-business-profile-guide-for-auckland-businesses/" }
      ]
    },
    {
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": "https://www.kiwiwebdesign.co.nz/#organization",
      "name": "Kiwi Web Design",
      "alternateName": "Web Design Auckland",
      "url": "https://www.kiwiwebdesign.co.nz/",
      "telephone": "+64-21-039-6580",
      "email": "hi@kiwiwebdesign.co.nz",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "147 Great North Road",
        "addressLocality": "Grey Lynn",
        "addressRegion": "Auckland",
        "postalCode": "1021",
        "addressCountry": "NZ"
      },
      "areaServed": [
        { "@type": "Place", "name": "Auckland" },
        { "@type": "Place", "name": "New Zealand" }
      ],
      "logo": { "@type": "ImageObject", "url": "https://www.kiwiwebdesign.co.nz/favicon.png", "width": 512, "height": 512 }
    },
    {
      "@type": "Service",
      "@id": "https://www.kiwiwebdesign.co.nz/google-business-profile-guide-for-auckland-businesses/#service",
      "name": "Google Business Profile Optimisation",
      "serviceType": "Google Business Profile optimisation and management",
      "description": "One-off Google Business Profile setup and optimisation for Auckland and New Zealand businesses. Covers category selection, NAP consistency, the full business description, photos, services, Q&A, and Google Maps visibility.",
      "provider": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "areaServed": [
        { "@type": "Place", "name": "Auckland" },
        { "@type": "Place", "name": "New Zealand" }
      ],
      "offers": {
        "@type": "Offer",
        "price": "299",
        "priceCurrency": "NZD",
        "description": "One-off Google Business Profile optimisation, GST exclusive.",
        "availability": "https://schema.org/InStock",
        "url": "https://www.kiwiwebdesign.co.nz/google-business-profile-guide-for-auckland-businesses/"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How much does Google Business Profile optimisation cost in NZ?", "acceptedAnswer": { "@type": "Answer", "text": "Kiwi Web Design charges a one-off fee of $299 + GST to fully optimise an existing Google Business Profile, or to set one up from scratch. That covers category selection, the full business description, services, photos, Q&A, and website linking. Ongoing GBP management (weekly posts, review responses, monthly reporting) is available separately as part of our local SEO plans." } },
        { "@type": "Question", "name": "Do I need a physical storefront to have a Google Business Profile?", "acceptedAnswer": { "@type": "Answer", "text": "No. Service-area businesses (like tradies, cleaners, or mobile services) can hide their address and instead specify the suburbs or regions they serve. You still appear in local search results for those areas." } },
        { "@type": "Question", "name": "How long does it take to verify a Google Business Profile?", "acceptedAnswer": { "@type": "Answer", "text": "Phone and email verification can be instant. Postcard verification typically takes 5–14 business days. Video verification is available for some business types and is usually same-day." } },
        { "@type": "Question", "name": "Why isn't my business showing up in the Google Maps 3-Pack?", "acceptedAnswer": { "@type": "Answer", "text": "The 3-Pack is determined by relevance, distance, and prominence. Common causes for not appearing are: incomplete profile, wrong primary category, few reviews, no website, or strong competition in your area. A local SEO audit can pinpoint exactly what is holding you back." } },
        { "@type": "Question", "name": "Can I manage multiple locations from one account?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Google Business Profile supports multi-location management. You can manage all your locations from one account, with bulk verification available for businesses with 10 or more locations." } },
        { "@type": "Question", "name": "Should I respond to negative reviews?", "acceptedAnswer": { "@type": "Answer", "text": "Always. A professional, calm response to a negative review often impresses potential customers more than the negative review damages. Acknowledge the issue, apologise if warranted, and offer to resolve it offline. Never argue or be defensive." } },
        { "@type": "Question", "name": "Do you offer Google Business Profile management?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We offer ongoing Google Business Profile management as part of our local SEO service, weekly posts, review response, photo updates, and monthly reporting. It can also be bundled with a website maintenance plan." } }
      ]
    }
  ]
};

const stats = [
  { number: "$299", label: "one-off GBP optimisation, no lock-in contract" },
  { number: "5–7 days", label: "typical turnaround once we have profile access" },
  { number: "97%", label: "of consumers use Google to find local businesses" },
  { number: "3-Pack", label: "GBP is the key to appearing in Google Maps top 3" },
];

const steps = [
  {
    num: "01",
    title: "Claim & Verify Your Listing",
    content: `Go to <strong>business.google.com</strong> and search for your business name. If it exists, claim it. If not, create it. You'll need to verify ownership, Google typically sends a postcard with a PIN to your business address, or offers phone/email verification for some businesses.`,
    tips: ["Use your exact legal business name", "Choose the physical address or service area correctly", "Don't use a PO Box as your primary address"],
  },
  {
    num: "02",
    title: "Choose the Right Business Category",
    content: `Your primary category is the most important single field in GBP. It tells Google what searches to show your business for. Be specific, 'Plumber' outperforms 'Contractor'. You can add secondary categories too.`,
    tips: ["Be as specific as possible with your primary category", "Add all relevant secondary categories", "Check what categories top-ranking competitors use", "Avoid generic categories like 'Local Business'"],
  },
  {
    num: "03",
    title: "Complete Every Profile Field",
    content: `Complete every relevant field so Google and customers can understand the business. Add the business name, address or service area, phone, website, hours, applicable attributes, and an accurate business description.`,
    tips: ["Write a 750-character description using key service terms", "Set special hours for public holidays", "Add all relevant attributes for your business type", "Enable messaging if you can respond promptly"],
  },
  {
    num: "04",
    title: "Add Photos & Videos",
    content: `Businesses with photos receive 42% more directions requests and 35% more website clicks. Add: exterior and interior photos, team/staff photos, product or service images, and a cover photo that represents your brand.`,
    tips: ["Minimum 3 photos of each type (exterior, interior, team)", "Name photos with descriptive filenames before uploading", "Add at least one video (even a simple walkthrough)", "Update photos seasonally"],
  },
  {
    num: "05",
    title: "Build & Manage Reviews",
    content: `Reviews are the #1 local ranking factor alongside relevance and distance. More reviews, and a higher average rating, drives more calls and visits. Ask every happy customer for a review, make it easy by sharing your direct review link.`,
    tips: ["Create a short.link to your review page and add it to invoices/receipts", "Respond to every review, positive and negative", "Never incentivise or buy fake reviews", "Aim for a steady drip of reviews, not a burst"],
  },
  {
    num: "06",
    title: "Post Weekly Updates",
    content: `GBP Posts appear in your listing and show Google your business is active. Post about: offers, new services, events, before/after jobs, or just useful tips for your customers. Posts stay live for 7 days (Offers stay longer).`,
    tips: ["Post at least once a week", "Include a photo and a call to action in every post", "Use keywords naturally in post text", "Use Offer posts for time-limited promotions"],
  },
  {
    num: "07",
    title: "Monitor Insights & Calls",
    content: `GBP Insights shows how many people viewed your listing, called your number, got directions, and visited your website. Track these monthly to see what's working and where to focus your optimisation.`,
    tips: ["Check insights monthly", "Set up call tracking to attribute phone leads to GBP", "Monitor queries, what searches are triggering your listing?", "Watch for competitor activity in your area"],
  },
];

const faqs = [
  { q: "How much does Google Business Profile optimisation cost in NZ?", a: "We charge a one-off fee of <strong>$299 + GST</strong> to fully optimise an existing Google Business Profile, or to set one up from scratch. That covers category selection, the full business description, services, photos, Q&amp;A, and website linking. Ongoing GBP management, weekly posts, review responses and monthly reporting, is available separately as part of our <a href=\"/local-seo-for-auckland-small-businesses/\">local SEO plans</a>." },
  { q: "Do I need a physical storefront to have a Google Business Profile?", a: "No. Service-area businesses (like tradies, cleaners, or mobile services) can hide their address and instead specify the suburbs or regions they serve. You still appear in local search results for those areas." },
  { q: "How long does it take to verify a Google Business Profile?", a: "Phone and email verification can be instant. Postcard verification typically takes 5–14 business days. Video verification is available for some business types and is usually same-day." },
  { q: "Why isn't my business showing up in the Google Maps 3-Pack?", a: "The 3-Pack is determined by relevance, distance, and prominence. If you're not appearing, common causes are: incomplete profile, wrong primary category, few reviews, no website, or strong competition in your area. Our <a href=\"/local-seo-for-auckland-small-businesses/\">local SEO service</a> includes a full GBP audit that pinpoints exactly what's holding you back." },
  { q: "Can I manage multiple locations from one account?", a: "Yes. Google Business Profile supports multi-location management. You can manage all your locations from one account, with bulk verification available for businesses with 10+ locations. A <a href=\"/small-business-website-design-auckland/\">well-designed website</a> with individual location pages also reinforces your local authority." },
  { q: "Should I respond to negative reviews?", a: "Always. A professional, calm response to a negative review often impresses potential customers more than the negative review damages. Acknowledge the issue, apologise if warranted, and offer to resolve it offline. Never argue or be defensive." },
  { q: "Do you offer Google Business Profile management?", a: "Yes. We offer ongoing GBP management as part of our <a href=\"/affordable-seo-auckland/\">SEO service</a>, weekly posts, review response, photo updates, and monthly reporting. Ask us about bundling GBP management with your website maintenance plan." },
];
---

<Layout
  title="Google Business Profile Optimisation NZ | GBP Management Auckland"
  description="Google Business Profile optimisation for Auckland and NZ businesses, $299 one-off, no lock-in. Rank higher on Google Maps. Free 7-step DIY guide included."
  canonicalURL="https://www.kiwiwebdesign.co.nz/google-business-profile-guide-for-auckland-businesses/"
  schema={schema}
>

  <!-- Hero -->
  <section class="gbp-hero">
    <div class="container gbp-hero-inner">
      <div>
        <p class="gbp-eyebrow">Google Business Profile Optimisation NZ</p>
        <h1>Google Business Profile optimisation for Auckland businesses</h1>
        <p class="gbp-hero-sub">We optimise your Google Business Profile so you show up in the Google Maps 3-Pack for the searches your customers actually use. One-off fee, no lock-in contract. Prefer to do it yourself? The full 7-step guide is free, further down this page.</p>
        <div class="gbp-hero-actions">
          <a href="/contact/" class="gbp-btn-primary">Get My Profile Optimised, $299</a>
          <a href="/google-business-profile-audit-auckland/" class="gbp-btn-secondary">Check Your GBP Score Free</a>
          <a href="#steps" class="gbp-btn-secondary">Read the DIY Guide ↓</a>
        </div>
        <p class="gbp-hero-meta">Last updated 15 October 2026 · Written by Charlie Chao, Kiwi Web Design, Grey Lynn, Auckland</p>
      </div>
      <div class="gbp-hero-badge-wrap">
        <div class="gbp-hero-card">
          <p class="gbp-card-label">One-off GBP optimisation</p>
          <p class="gbp-card-price"><span class="gbp-price-num">$299</span> <span class="gbp-price-gst">+ GST</span></p>
          <p class="gbp-card-title">Everything your profile needs, done once, properly</p>
          <ul class="gbp-card-list">
            <li><span>✓</span> Primary &amp; secondary category review</li>
            <li><span>✓</span> Full 750-character description</li>
            <li><span>✓</span> Services, attributes &amp; hours</li>
            <li><span>✓</span> Photo naming &amp; upload</li>
            <li><span>✓</span> NAP consistency check</li>
            <li><span>✓</span> Website linking &amp; tracking</li>
          </ul>
          <p class="gbp-card-foot">You keep ownership of your Google account. 5–7 day turnaround.</p>
        </div>
      </div>
    </div>
  </section>

  <PageVisual
    imgSrc={gbpImage.src}
    imgAlt="Google Business Profile optimisation dashboard for an Auckland business"
    imgTitle="Google Business Profile guide for Auckland businesses"
    eyebrow="Local Search"
    title="Make your Google profile feel as polished as your website"
    caption="A visual local-search section helps break up the guide while reinforcing what Auckland businesses need to improve map visibility."
  />

  <!-- AI citability snippet -->
  <div class="gbp-snippet">
    <div class="container">
      <p><strong>Kiwi Web Design</strong> offers Google Business Profile optimisation for Auckland and New Zealand businesses for a one-off fee of <strong>$299 + GST</strong>, covering categories, business description, services, photos, NAP consistency and website linking, with a 5–7 day turnaround and no lock-in contract. Ongoing GBP management, including weekly posts, review responses and monthly reporting, is available as part of our local SEO plans. A complete, accurate profile helps Google understand the business and gives customers useful information directly in Search and Maps. The full 7-step DIY guide is published free on this page.</p>
    </div>
  </div>

  <StatsRow items={stats} />

  <!-- Service detail: Maps optimisation + ongoing management -->
  <section class="section" id="service">
    <div class="container gbp-svc-wrap">
      <SectionHeader
        eyebrow="What we do for you"
        title="Two ways we work on your Google Business Profile"
        subtitle="A one-off optimisation fixes the profile. Ongoing management keeps it ahead of your competitors."
      />

      <div class="gbp-svc-grid">
        <article class="gbp-svc-card">
          <p class="gbp-svc-tag">One-off · $299 + GST</p>
          <h2 class="gbp-svc-title">Google Maps optimisation for Auckland businesses</h2>
          <p>Google ranks local results on relevance, distance and prominence. Distance you cannot change. The other two are mostly decided by how well your profile is built, and most Auckland profiles are half-finished.</p>
          <p>We go through the whole profile once, properly:</p>
          <ul class="gbp-svc-list">
            <li>Primary category chosen against what the businesses currently in the 3-Pack are using, plus every relevant secondary category</li>
            <li>A full 750-character description written around the services and suburbs you actually want to be found for</li>
            <li>Services and attributes completed, so your listing can match more searches</li>
            <li>Photos renamed descriptively and uploaded across exterior, interior, team and work categories</li>
            <li>NAP (name, address, phone) checked for consistency against your website and major NZ directories</li>
            <li>Website link, UTM tracking and call tracking set up so you can see what the profile is actually bringing in</li>
          </ul>
          <p class="gbp-svc-foot">Turnaround is 5–7 days from the moment we have access. You keep ownership of the Google account throughout, we work as a manager and hand it back.</p>
          <a href="/contact/" class="gbp-svc-btn">Book a GBP optimisation</a>
        </article>

        <article class="gbp-svc-card">
          <p class="gbp-svc-tag">Ongoing · part of local SEO plans</p>
          <h2 class="gbp-svc-title">Google Business Profile management service</h2>
          <p>Optimisation is a one-off fix. Google rewards profiles that stay active, and so do customers comparing three businesses side by side. If you do not have time to keep posting and replying, this is the part to hand over.</p>
          <p>Ongoing GBP management covers:</p>
          <ul class="gbp-svc-list">
            <li>A weekly Google post with an image and a call to action</li>
            <li>Review responses within one business day, positive and negative</li>
            <li>A review request system so new reviews arrive steadily rather than in bursts</li>
            <li>Fresh photos added monthly</li>
            <li>Q&amp;A seeded and monitored, so competitors are not answering for you</li>
            <li>A monthly report on calls, direction requests and website clicks, not just profile views</li>
          </ul>
          <p class="gbp-svc-foot">Managed GBP is bundled into our local SEO plans rather than sold as a standalone retainer, because posting into a profile that is not properly built first is wasted effort.</p>
          <a href="/local-seo-for-auckland-small-businesses/" class="gbp-svc-btn gbp-svc-btn-alt">See local SEO plans</a>
        </article>
      </div>

      <p class="gbp-svc-note">Not sure which you need? <a href="/google-business-profile-audit-auckland/">Run the free GBP scorecard</a> first, it takes about 60 seconds and tells you what is missing before you spend anything.</p>
    </div>
  </section>

  <!-- Guide steps -->
  <section class="section" id="steps">
    <div class="container gbp-steps-wrap">
      <SectionHeader
        eyebrow="Free DIY guide"
        title="7 steps to a fully optimised Google Business Profile"
        subtitle="This is the same checklist we work through on a paid optimisation. Follow the steps in order, each one builds on the last."
      />
      <div class="gbp-steps">
        {steps.map(({ num, title, content, tips }) => (
          <div class="gbp-step">
            <div class="gbp-step-num">{num}</div>
            <div class="gbp-step-body">
              <h3 class="gbp-step-title">{title}</h3>
              <p class="gbp-step-content" set:html={content} />
              <div class="gbp-step-tips">
                <p class="gbp-tips-label">✦ Key tips</p>
                <ul>
                  {tips.map((tip) => <li>{tip}</li>)}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Common mistakes + comparison -->
  <section class="section" style="background: var(--kwd-cream);" id="mistakes">
    <div class="container gbp-steps-wrap">
      <SectionHeader
        eyebrow="From our audits"
        title="Common mistakes Auckland businesses make"
        subtitle="After reviewing dozens of Auckland business profiles, the same six issues come up again and again."
      />

      <div class="gbp-mistakes">
        <div class="gbp-mistake">
          <h3>Wrong or too-broad primary category</h3>
          <p>Choosing "Home Services" instead of "Plumber" means you miss every specific search. This is the single most common and most expensive mistake. Be precise.</p>
        </div>
        <div class="gbp-mistake">
          <h3>No photos, or stock images only</h3>
          <p>Customers can tell. Real photos of real work build trust. Stock images do the opposite.</p>
        </div>
        <div class="gbp-mistake">
          <h3>Ignoring reviews</h3>
          <p>Not responding to reviews, especially negative ones, signals to both Google and customers that you are not engaged with your own business.</p>
        </div>
        <div class="gbp-mistake">
          <h3>Inconsistent name, address or phone</h3>
          <p>If your profile says "Charlie's Electrical Ltd" but your website says "Charlie's Electrical", those are different signals to Google. Keep NAP identical everywhere.</p>
        </div>
        <div class="gbp-mistake">
          <h3>Never posting updates</h3>
          <p>A profile with no posts looks abandoned. Weekly posts take five minutes and keep the profile active.</p>
        </div>
        <div class="gbp-mistake">
          <h3>Not finishing verification</h3>
          <p>An unverified listing will not rank at all. If you claimed your profile and never completed verification, finish that before anything else.</p>
        </div>
      </div>

      <h2 class="gbp-cmp-title">Optimised vs unoptimised: what actually changes</h2>
      <div class="gbp-cmp-scroll">
        <table class="gbp-cmp">
          <thead>
            <tr><th>What Google and customers see</th><th>Unoptimised</th><th>Optimised</th></tr>
          </thead>
          <tbody>
            <tr><td>Google Maps visibility</td><td>Rarely appears</td><td>Regularly in the 3-Pack</td></tr>
            <tr><td>Photo count</td><td>0–2</td><td>10+ real photos</td></tr>
            <tr><td>Review responses</td><td>None</td><td>All reviews answered</td></tr>
            <tr><td>Weekly posts</td><td>Never</td><td>Consistent</td></tr>
            <tr><td>Services listed</td><td>Not filled in</td><td>Complete with descriptions</td></tr>
            <tr><td>Category</td><td>Broad or wrong</td><td>Precise primary + secondary</td></tr>
            <tr><td>Insights reviewed</td><td>Never</td><td>Monthly</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Do it for you CTA -->
  <section class="section" style="background: var(--kwd-dark);">
    <div class="container">
      <div class="gbp-diy-card">
        <div>
          <p class="gbp-diy-eyebrow">That is a lot of steps</p>
          <h2 class="gbp-diy-title">We will do all seven for $299 + GST</h2>
          <p class="gbp-diy-desc">Those steps take most business owners a full day, and the category and description choices are easy to get wrong in ways that quietly cost you Maps visibility for months. We do the lot in 5–7 days, one-off fee, no lock-in, and you keep ownership of the account.</p>
        </div>
        <div class="gbp-diy-actions">
          <a href="/contact/" class="gbp-diy-btn-primary">Get My Profile Optimised</a>
          <a href="/google-business-profile-audit-auckland/" class="gbp-diy-btn-secondary">Check My Score First</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background: var(--kwd-cream);">
    <div class="container" style="max-width: 860px;">
      <FAQAccordion
        items={faqs}
        title="Google Business Profile Questions"
        subtitle="Common questions from Auckland businesses about GBP setup and optimisation."
      />
    </div>
  </section>

  <!-- Related services -->
  <section class="related-strip">
    <div class="container" style="max-width: 860px;">
      <p class="rps-label">Related services</p>
      <div class="rps-links">
        <a href="/local-seo-for-auckland-small-businesses/" class="rps-link">Local SEO</a>
        <a href="/google-business-profile-audit-auckland/" class="rps-link">GBP Scorecard</a>
        <a href="/affordable-seo-auckland/" class="rps-link">SEO Services</a>
        <a href="/small-business-website-design-auckland/" class="rps-link">Web Design</a>
        <a href="/ai-seo-for-auckland-small-businesses/" class="rps-link">AI SEO</a>
        <a href="/google-ads/" class="rps-link">Google Ads</a>
      </div>
    </div>
  </section>

  <CTABanner
    variant="yellow"
    title="Ready to get found on Google Maps in Auckland?"
    subtitle="One-off Google Business Profile optimisation, $299 + GST, 5–7 day turnaround, no lock-in contract."
    ctaPrimary={{ text: "Get My Profile Optimised", href: "/contact/" }}
    ctaSecondary={{ text: "Run the Free GBP Scorecard", href: "/google-business-profile-audit-auckland/" }}
  />

</Layout>

<style>
  .gbp-snippet { background: #fff8e1; border-left: 4px solid var(--kwd-yellow); padding: 1rem 0; }
  .gbp-snippet p { margin: 0; font-size: 0.95rem; line-height: 1.65; color: var(--kwd-dark); }

  /* Hero */
  .gbp-hero {
    background: var(--kwd-dark);
    padding: 5rem 0;
  }
  .gbp-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .gbp-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--kwd-yellow);
    margin-bottom: 1rem;
  }
  .gbp-hero h1 { font-size: clamp(1.9rem, 3.5vw, 3rem); color: #fff; line-height: 1.1; margin-bottom: 1.25rem; }
  .gbp-hero-sub { font-size: 0.95rem; color: rgba(255,255,255,0.65); line-height: 1.7; margin-bottom: 2rem; max-width: 500px; }
  .gbp-hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .gbp-btn-primary {
