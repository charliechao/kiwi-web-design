---
import Layout from '../layouts/Layout.astro';
import AuthorProfile from '../components/AuthorProfile.astro';
import { Copy, RotateCcw } from 'lucide-astro';
import { readinessChecks } from '../utils/chatgpt-ads-readiness';

const title = 'ChatGPT Ads Readiness Checklist for NZ Businesses | Kiwi Web Design';
const description = 'Check six ChatGPT Ads launch requirements: eligibility, account and location controls, offer, landing page, measurement and lead follow-up. Get specific next steps.';
const canonicalURL = 'https://www.kiwiwebdesign.co.nz/chatgpt-ads-readiness-check/';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage', '@id': `${canonicalURL}#webpage`, url: canonicalURL,
      name: title, description, inLanguage: 'en-NZ', datePublished: '2026-09-19', dateModified: '2026-09-19',
      isPartOf: { '@id': 'https://www.kiwiwebdesign.co.nz/#website' },
      publisher: { '@id': 'https://www.kiwiwebdesign.co.nz/#organization' },
      breadcrumb: { '@id': `${canonicalURL}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList', '@id': `${canonicalURL}#breadcrumb`, itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.kiwiwebdesign.co.nz/' },
        { '@type': 'ListItem', position: 2, name: 'ChatGPT Ads', item: 'https://www.kiwiwebdesign.co.nz/chatgpt-ads/' },
        { '@type': 'ListItem', position: 3, name: 'Readiness checklist', item: canonicalURL },
      ],
    },
  ],
};
---

<Layout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
  <section class="readiness">
    <div class="check-shell">
      <nav aria-label="Breadcrumb"><a href="/chatgpt-ads/">ChatGPT Ads NZ</a><span aria-hidden="true"> / </span><span>Readiness checklist</span></nav>
      <header>
        <h1>ChatGPT Ads readiness checklist</h1>
        <p>Can your NZ business run a useful, measurable test? Check the offer, account, destination and follow-up before committing to launch.</p>
        <p class="source-date">Sources checked 19 September 2026. This is KWD's self-assessment, not OpenAI approval or a performance forecast.</p>
      </header>
      <div class="check-layout">
        <form id="readiness-form" aria-label="Campaign preparation checks">
          {readinessChecks.map((check, index) => (
            <fieldset>
              <legend><span class="check-number">{index + 1}.</span> {check.question}</legend>
              <p id={`${check.id}-detail`}>{check.detail}</p>
              <label for={check.id}>Preparation status</label>
              <select id={check.id} name={check.id} aria-describedby={`${check.id}-detail`} disabled>
                <option value="unknown">Not checked</option>
                <option value="yes">Yes, confirmed</option>
                <option value="no">No, needs work</option>
              </select>
              <details><summary>What to check</summary><p>{check.fix}</p><a href={check.href}>{check.linkLabel}</a></details>
            </fieldset>
          ))}
          <button type="reset" class="secondary" id="reset-check" disabled><RotateCcw size={18} aria-hidden="true" /> Reset answers</button>
        </form>
        <aside class="result" aria-labelledby="result-title">
          <p class="result-label">Your preparation</p>
          <div role="status" aria-live="polite" aria-atomic="true">
            <h2 id="result-title">Complete the preparation checks</h2>
            <p id="result-count">0 of 6 checks confirmed</p>
          </div>
          <progress id="readiness-progress" value="0" max="6" aria-label="Preparation checks confirmed">0 of 6</progress>
          <p id="result-explanation">Unconfirmed requirements remain open. Confirming all six means you have a brief to review, not permission to launch.</p>
          <div id="next-steps" hidden>
            <h3>Next steps</h3>
            <ol id="result-gaps"></ol>
          </div>
          <button type="button" class="secondary" id="copy-readiness" disabled><Copy size={18} aria-hidden="true" /> Copy summary</button>
          <p id="copy-status" role="status"></p>
          <textarea id="summary-fallback" rows="10" readonly hidden aria-label="Readiness summary"></textarea>
          <a class="consultation" href="/contact/">Discuss your campaign</a>
          <p class="privacy-note">Your selections stay in this page and are not submitted with the contact form. You can include the copied summary in your enquiry.</p>
          <noscript><p>The interactive assessment needs JavaScript. The six requirements and their recommendations remain available on this page.</p></noscript>
        </aside>
      </div>
      <footer class="check-footer">
        <h2>Before you make a launch decision</h2>
        <p>Read the <a href="/affordable-web-design-auckland/chatgpt-ads-new-zealand-guide/">NZ launch guide</a> and <a href="https://help.openai.com/en/articles/20001245-ads-manager-availability">OpenAI's account availability requirements</a>. Policies and account controls can change; check them again when preparing the real campaign.</p>
        <p>Compare your proposed test with <a href="/affordable-web-design-auckland/chatgpt-ads-vs-google-search-ads-nz/">Google Search Ads</a>, or return to our <a href="/chatgpt-ads/">ChatGPT Ads management hub</a>.</p>
        <AuthorProfile variant="inline" />
      </footer>
    </div>
  </section>
</Layout>

<script>
  import { assessReadiness, readinessChecks, readinessSummary } from '../utils/chatgpt-ads-readiness';
  import type { ReadinessAnswers } from '../utils/chatgpt-ads-readiness';

  const form = document.querySelector<HTMLFormElement>('#readiness-form');
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-readiness');
  const copyStatus = document.querySelector<HTMLElement>('#copy-status');
  const fallback = document.querySelector<HTMLTextAreaElement>('#summary-fallback');

  if (form && copyButton && copyStatus && fallback) {
    const readAnswers = (): ReadinessAnswers => {
      const data = new FormData(form);
      return Object.fromEntries(readinessChecks.map((check) => {
        const value = data.get(check.id);
        return [check.id, value === 'yes' || value === 'no' ? value : 'unknown'];
      }));
    };
    const update = () => {
      const result = assessReadiness(readAnswers());
      document.querySelector('#result-title')!.textContent = result.title;
      document.querySelector('#result-count')!.textContent = `${result.confirmed} of ${readinessChecks.length} checks confirmed`;
      const progress = document.querySelector<HTMLProgressElement>('#readiness-progress')!;
      progress.value = result.confirmed;
      progress.textContent = `${result.confirmed} of ${readinessChecks.length}`;
      document.querySelector('#result-explanation')!.textContent = result.ready
        ? 'All six requirements are self-confirmed. Review the evidence and current policies before launch. Approval and results are not guaranteed.'
        : `${result.gaps.length - result.pending} marked as needing work; ${result.pending} not yet checked. Resolve the items below before planning launch.`;
      document.querySelector<HTMLElement>('#next-steps')!.hidden = result.ready;
      document.querySelector('#result-gaps')!.replaceChildren(...result.gaps.map((check) => {
        const item = document.createElement('li');
        const text = document.createElement('p');
        text.textContent = check.fix;
        const link = document.createElement('a');
        link.href = check.href;
        link.textContent = check.linkLabel;
        item.append(text, link);
        return item;
      }));
      copyStatus.textContent = '';
      fallback.hidden = true;
      fallback.value = '';
    };
    form.querySelectorAll<HTMLSelectElement>('select').forEach((select) => { select.disabled = false; });
    form.querySelector<HTMLButtonElement>('#reset-check')!.disabled = false;
    copyButton.disabled = false;
    form.addEventListener('change', update);
    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('reset', () => setTimeout(update, 0));
    copyButton.addEventListener('click', async () => {
      const summary = readinessSummary(readAnswers());
      try {
        await navigator.clipboard.writeText(summary);
        copyStatus.textContent = 'Summary copied. Nothing has been sent.';
      } catch {
        fallback.value = summary;
        fallback.hidden = false;
        fallback.focus();
        fallback.select();
        copyStatus.textContent = 'Copy was unavailable. Your summary is selected below.';
      }
    });
    update();
  }
</script>

<style>
  .readiness { background: #fff; color: #172b25; padding: 36px 0 64px; letter-spacing: 0; }
  .check-shell { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
  nav { font-size: 0.875rem; margin-bottom: 28px; }
  a { color: #24513e; text-underline-offset: 4px; }
  header { max-width: 820px; margin-bottom: 32px; }
  h1 { font-size: 2.5rem; line-height: 1.15; margin: 0 0 20px; letter-spacing: 0; }
  h2 { font-size: 1.4rem; line-height: 1.3; letter-spacing: 0; }
  p { line-height: 1.65; }
  .source-date, .privacy-note { font-size: 0.875rem; color: #465e52; }
  .check-layout { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  fieldset { min-width: 0; margin: 0 0 28px; padding: 20px 0 28px; border: 0; border-bottom: 1px solid #d4ded7; }
  legend { font-size: 1.1rem; font-weight: 700; line-height: 1.5; padding: 0; }
  .check-number { color: #42664f; }
  fieldset p { margin: 0 0 16px; }
  label { display: block; font-size: 0.875rem; margin-bottom: 8px; font-weight: 700; }
  select { width: min(100%, 320px); min-height: 46px; background: #fff; color: #172b25; border: 1px solid #6f8578; border-radius: 4px; font: inherit; padding: 10px; }
  details { margin-top: 20px; }
  summary { cursor: pointer; font-weight: 600; }
  details p { margin: 12px 0; }
  .result { background: #edf4f0; border-top: 4px solid #c59721; padding: 24px; min-width: 0; }
  .result-label { font-size: 0.875rem; font-weight: 700; margin: 0 0 14px; }
  progress { width: 100%; height: 12px; accent-color: #24513e; }
  #result-title { min-height: 3.9rem; margin: 0; }
  #next-steps { border-top: 1px solid #c4d5c9; margin-top: 20px; padding-top: 12px; }
  #result-gaps { padding-left: 22px; font-size: 0.95rem; }
  #result-gaps :global(li) { margin: 0 0 20px; }
  #result-gaps :global(p) { margin: 0 0 8px; line-height: 1.6; }
  #result-gaps :global(a) { color: #24513e; text-underline-offset: 4px; }
  button, .consultation { min-height: 46px; padding: 10px 16px; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font: inherit; font-weight: 700; cursor: pointer; white-space: normal; }
  button :global(svg) { flex: 0 0 18px; }
  .secondary { border: 1px solid #6f8578; background: #fff; color: #172b25; }
  .consultation { background: #f7c439; color: #172b25; text-decoration: none; width: 100%; }
  button:disabled { opacity: 0.55; cursor: default; }
  :is(button, a, select, summary, textarea):focus-visible { outline: 3px solid #ad7300; outline-offset: 4px; }
  textarea { width: 100%; box-sizing: border-box; margin: 12px 0; padding: 10px; font: inherit; border: 1px solid #6f8578; }
  [hidden] { display: none !important; }
  .check-footer { margin-top: 48px; padding-top: 24px; border-top: 1px solid #d4ded7; max-width: 820px; }
  @media (max-width: 760px) { .check-layout { grid-template-columns: 1fr; gap: 28px; } h1 { font-size: 2rem; } .result { padding: 20px; } #result-title { min-height: 0; } }
</style>
