---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import StatsRow from '../components/StatsRow.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTABanner from '../components/CTABanner.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import TestimonialGrid from '../components/TestimonialGrid.astro';
import { Image } from 'astro:assets';
import consultImg from '../assets/general/about5.webp';
import aucklandCBD from '../assets/general/Auckland-CBD.jpg';
import Icon from '../components/Icon.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.kiwiwebdesign.co.nz/ai-seo-for-auckland-small-businesses/",
      "url": "https://www.kiwiwebdesign.co.nz/ai-seo-for-auckland-small-businesses/",
      "name": "AI SEO Agency Auckland | GEO & AI Search Optimisation",
      "description": "AI SEO agency Auckland: improve Google visibility and make your business easier for ChatGPT, AI Overviews, Perplexity, Gemini, and other AI search tools to understand and cite.",
      "inLanguage": "en-NZ",
      "isPartOf": { "@id": "https://www.kiwiwebdesign.co.nz/#website" },
      "about": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "breadcrumb": { "@id": "https://www.kiwiwebdesign.co.nz/ai-seo-for-auckland-small-businesses/#breadcrumb" },
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".aiseo-snippet", "h1"] }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.kiwiwebdesign.co.nz/ai-seo-for-auckland-small-businesses/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.kiwiwebdesign.co.nz/" },
        { "@type": "ListItem", "position": 2, "name": "SEO Auckland", "item": "https://www.kiwiwebdesign.co.nz/affordable-seo-auckland/" },
        { "@type": "ListItem", "position": 3, "name": "AI SEO Auckland", "item": "https://www.kiwiwebdesign.co.nz/ai-seo-for-auckland-small-businesses/" }
      ]
    },
    {
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": "https://www.kiwiwebdesign.co.nz/#organization",
      "name": "Kiwi Web Design",
      "alternateName": "Web Design Auckland",
      "url": "https://www.kiwiwebdesign.co.nz/",
      "telephone": "+64-21-039-6580",
      "email": "hi@kiwiwebdesign.co.nz",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "147 Great North Road",
        "addressLocality": "Grey Lynn",
        "addressRegion": "Auckland",
        "postalCode": "1021",
        "addressCountry": "NZ"
      },
      "areaServed": [
        { "@type": "Place", "name": "Auckland" },
        { "@type": "Place", "name": "New Zealand" }
      ],
      "logo": { "@type": "ImageObject", "url": "https://www.kiwiwebdesign.co.nz/favicon.png", "width": 512, "height": 512 }
    },
    {
      "@type": "Service",
      "@id": "https://www.kiwiwebdesign.co.nz/ai-seo-for-auckland-small-businesses/#service",
      "name": "AI SEO & Generative Engine Optimisation (GEO) Auckland",
      "serviceType": "AI SEO",
      "category": "Digital Marketing",
      "description": "AI-powered SEO and GEO for Auckland businesses, combining traditional search optimisation with content, schema, authority, and technical work designed for AI-assisted discovery.",
      "provider": { "@id": "https://www.kiwiwebdesign.co.nz/#organization" },
      "areaServed": [
        { "@type": "Place", "name": "Auckland" },
        { "@type": "Place", "name": "New Zealand" }
      ],
      "url": "https://www.kiwiwebdesign.co.nz/ai-seo-for-auckland-small-businesses/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is AI SEO and how is it different from regular SEO?",
          "acceptedAnswer": { "@type": "Answer", "text": "Traditional SEO focuses on ranking in Google's blue-link results. AI SEO, also called Generative Engine Optimisation or GEO, adds work designed to make content easier for AI-assisted search tools to understand, retrieve, and cite." }
        },
        {
          "@type": "Question",
          "name": "Do Auckland small businesses really need to worry about AI search?",
          "acceptedAnswer": { "@type": "Answer", "text": "AI-assisted search is becoming a meaningful part of how people research products, services, and providers. The practical response is to strengthen the same fundamentals that support both search and AI discovery: clear service information, strong local signals, structured data, useful content, and authoritative third-party mentions." }
        },
        {
          "@type": "Question",
          "name": "How do you get a business cited in ChatGPT or Perplexity?",
          "acceptedAnswer": { "@type": "Answer", "text": "There is no guaranteed citation formula. We improve the conditions that support visibility by making content crawlable and answer-ready, strengthening structured data and entity signals, and building credible third-party mentions and local business information." }
        },
        {
          "@type": "Question",
          "name": "What is a GEO score?",
          "acceptedAnswer": { "@type": "Answer", "text": "A GEO score is an internal benchmarking concept rather than a universal search-engine metric. We use practical checks such as content clarity, schema completeness, technical crawlability, brand mentions, and observed AI visibility to identify gaps and track progress." }
        },
        {
          "@type": "Question",
          "name": "Does AI SEO replace traditional SEO?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Traditional search fundamentals still matter. AI SEO extends them with stronger entity signals, answer-ready content, structured data, and visibility across AI-assisted discovery environments." }
        },
        {
          "@type": "Question",
          "name": "How much does AI SEO cost?",
          "acceptedAnswer": { "@type": "Answer", "text": "We quote AI SEO after reviewing your current visibility, competition, technical condition, content needs, and authority gaps. The scope is tailored to the business rather than published as a generic package price." }
        },
        {
          "@type": "Question",
          "name": "What is the difference between GEO and AEO (Answer Engine Optimization)?",
          "acceptedAnswer": { "@type": "Answer", "text": "GEO focuses on visibility and citations in generative AI answers, while AEO focuses more broadly on being selected for direct answers, snippets, and answer surfaces. In practice, both reward clear answers, useful structure, strong entities, and credible sources." }
        },
        {
          "@type": "Question",
          "name": "What is llms.txt and does my website need one?",
          "acceptedAnswer": { "@type": "Answer", "text": "llms.txt is an emerging convention intended to make important site content easier for AI systems and agents to understand. It is not a substitute for technical SEO, crawlability, structured data, or useful content, so we treat it as an optional supporting layer rather than a ranking shortcut." }
        },
        {
          "@type": "Question",
          "name": "How do you track AI citations and mentions?",
          "acceptedAnswer": { "@type": "Answer", "text": "We review how the brand appears across relevant AI-assisted search tools, alongside Search Console, GA4, local visibility, referral traffic, and enquiry data. Because AI visibility can vary by query and session, we treat citation monitoring as directional evidence rather than a guaranteed ranking metric." }
        },
        {
          "@type": "Question",
          "name": "Can you help my business build authority on third-party platforms?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. We identify credible directories, associations, publications, community platforms, and industry sources where a genuine business presence can strengthen discoverability and authority without relying on spam or manufactured mentions." }
        }
      ]
    }
  ]
};

const stats = [
  { number: "Search + AI", label: "one strategy across traditional and AI-assisted discovery" },
  { number: "Local", label: "Auckland-focused entity and location signals" },
  { number: "50+", label: "NZ businesses helped by Kiwi Web Design" },
  { number: "5★", label: "Google rating across client reviews" },
];

const services = [
  {
    icon: "🤖",
    title: "Generative Engine Optimisation (GEO)",
    desc: "Structure your content so AI-assisted search tools can understand the business, services, locations, and answers you provide.",
    items: ["AI visibility audits", "Answer-first content structuring", "Entity & topic coverage", "AI-readable site guidance"],
  },
  {
    icon: "🏷️",
    title: "AI-Ready Schema Markup",
    desc: "Use structured data to make important business, service, location, and content information more explicit to search systems.",
    items: ["LocalBusiness & Service schema", "FAQ schema where appropriate", "Entity linking", "Structured data validation"],
  },
  {
    icon: "📝",
    title: "AI-Assisted Content Strategy",
    desc: "Research the questions, comparisons, and service topics customers actually need answered, then build content around useful buyer intent.",
    items: ["Keyword & topic clustering", "Competitor content gap analysis", "Human-reviewed content", "Content planning"],
  },
  {
    icon: "⚡",
    title: "Technical SEO & Core Web Vitals",
    desc: "Keep the site fast, crawlable, mobile-friendly, and structurally clear so search engines and AI-assisted systems can access the right pages.",
    items: ["Core Web Vitals optimisation", "Crawl efficiency", "Sitemap & robots.txt", "Page speed audit & fixes"],
  },
  {
    icon: "🗺️",
    title: "Local AI SEO",
    desc: "Strengthen the local signals that help search systems connect your business with Auckland services, suburbs, and customer needs.",
    items: ["Google Business Profile optimisation", "Local schema markup", "Suburb landing pages", "Review strategy"],
  },
  {
    icon: "📊",
    title: "AI Search Visibility Tracking",
    desc: "Monitor observed brand visibility across relevant AI-assisted tools alongside rankings, traffic, local visibility, and enquiries.",
    items: ["AI mention checks", "GBP insights reporting", "Search Console integration", "Monthly visibility reporting"],
  },
  {
    icon: "💬",
    title: "Third-Party Authority Signals",
    desc: "Build legitimate presence on credible directories, associations, publications, community platforms, and industry sources that support brand authority.",
    items: ["Relevant directory presence", "Industry mentions", "Community opportunities", "Platform-specific content"],
  },
  {
    icon: "📰",
    title: "Digital PR & Brand Authority",
    desc: "Earn credible mentions that help both people and search systems understand who your business is and why it is trustworthy.",
    items: ["NZ media & directory outreach", "Industry publication mentions", "Brand entity clarification", "Authority signal building"],
  },
];

const aiBenefit = [
  { icon: "🔍", title: "Google AI Overviews", desc: "Structure useful, direct content that can support visibility across Google's AI-assisted search experiences.", items: ["Answer-first content", "Structured data", "Strong supporting pages"] },
  { icon: "💬", title: "ChatGPT", desc: "Strengthen crawlable service information, brand authority, and third-party references so your business is easier to understand during AI-assisted research.", items: ["Entity clarity", "Third-party mentions", "Structured service information"] },
  { icon: "🔗", title: "Perplexity", desc: "Create authoritative, source-worthy pages with clear claims, useful evidence, and strong page structure.", items: ["Source-worthy content", "Clear evidence", "Citation-friendly formatting"] },
  { icon: "⭐", title: "Gemini & Bing Copilot", desc: "Keep structured data, indexing, business information, and content quality consistent across the wider search ecosystem.", items: ["Cross-platform crawlability", "Structured data", "Indexing checks"] },
  { icon: "🤖", title: "Other AI assistants", desc: "Focus on durable web fundamentals rather than chasing one model: crawlable pages, explicit entities, useful answers, and credible authority signals.", items: ["Crawlability", "Entity clarity", "AI-readable content structure"] },
];

const process = [
  { step: "1", title: "AI Visibility Audit", desc: "We review your current search visibility, AI-assisted discoverability, technical setup, local signals, and authority gaps." },
  { step: "2", title: "Strategy & Content Plan", desc: "We identify the highest-impact search topics, buyer questions, entity gaps, technical issues, and authority opportunities." },
  { step: "3", title: "Implementation", desc: "We improve technical SEO, structured data, service content, internal links, local signals, and supporting authority work in a prioritised sequence." },
  { step: "4", title: "Track & Report", desc: "We report on rankings, organic traffic, local visibility, observed AI mentions, and enquiries so the work stays tied to commercial outcomes." },
];

const reviews = [
  { name: "Zane Barrett", company: "Barrett Access Scaffolding", text: "Professional, responsive, and they really took the time to understand our business." },
  { name: "Jack", company: "Show Me Shorts", text: "They understood what I needed from the beginning and offered smart, practical solutions." },
  { name: "Gina Dellabarca", company: "Auckland client", text: "Clear information, great communication, and a genuinely helpful audit." },
];

const faqs = [
  { q: "What is AI SEO and how is it different from regular SEO?", a: "Traditional <a href=\"/affordable-seo-auckland/\">SEO</a> focuses on ranking in search results. AI SEO, also called GEO, adds work designed to make your business and content easier for AI-assisted search tools to understand, retrieve, and cite. The strongest approach combines both rather than treating them as separate channels." },
  { q: "Do Auckland small businesses really need to worry about AI search?", a: "AI-assisted discovery is becoming part of how people compare products, services, and providers. The useful response is not to chase every AI trend, but to strengthen durable fundamentals: clear service pages, local signals, useful answers, structured data, crawlability, and credible third-party authority." },
  { q: "How do you get a business cited in ChatGPT or Perplexity?", a: "There is no guaranteed citation formula. We improve the conditions that support visibility by strengthening crawlable content, direct answers, structured data, entity clarity, local business information, and credible third-party mentions." },
  { q: "What is a GEO score?", a: "There is no universal GEO score used by all AI search systems. We use practical benchmarks such as content clarity, schema completeness, technical crawlability, brand mentions, local authority, and observed AI visibility to identify gaps and track progress." },
  { q: "Does AI SEO replace traditional SEO?", a: "No. It extends it. Traditional ranking signals, technical quality, useful content, links, and local relevance still matter. AI SEO adds stronger entity signals, answer-ready content, and structured information on top. See our full <a href=\"/affordable-seo-auckland/\">SEO services Auckland</a> and <a href=\"/local-seo-for-auckland-small-businesses/\">local SEO</a> services." },
  { q: "How much does AI SEO cost?", a: "We quote AI SEO after reviewing your current visibility, competition, technical condition, content needs, local footprint, and authority gaps. The scope is tailored to the business rather than published as a generic package price." },
  { q: "What is the difference between GEO and AEO (Answer Engine Optimisation)?", a: "GEO focuses on visibility and citations in generative AI answers, while AEO focuses more broadly on being selected for direct answers, snippets, and answer surfaces. In practice, both reward clear answers, useful structure, strong entities, and credible sources." },
  { q: "What is llms.txt and does my website need one?", a: "llms.txt is an emerging convention intended to make important site content easier for AI systems and agents to understand. It is not a replacement for technical SEO, structured data, crawlability, or good content, so we use it only as a supporting layer where appropriate." },
  { q: "How do you track AI citations and mentions?", a: "We review how your brand appears across relevant AI-assisted tools alongside Search Console, GA4, local visibility, referral traffic, and enquiry data. Because AI answers can vary by query and session, we treat citation monitoring as directional evidence rather than a guaranteed ranking metric." },
  { q: "Can you help my business build authority on third-party platforms?", a: "Yes. We identify credible directories, associations, publications, community platforms, and industry sources where a genuine business presence can strengthen discoverability and authority without relying on spam or manufactured mentions." },
];
---

<Layout
  title="AI SEO Agency Auckland | GEO & AI Search Optimisation"
  description="AI SEO agency Auckland: improve Google visibility and make your business easier for ChatGPT, AI Overviews, Perplexity, Gemini, and other AI search tools to understand and cite."
  canonicalURL="https://www.kiwiwebdesign.co.nz/ai-seo-for-auckland-small-businesses/"
  schema={schema}
  alternateUrl="https://www.kiwiwebdesign.co.nz/zh/ai-seo-for-auckland-small-businesses/"
>

  <PageHero
    eyebrow="AI SEO Agency Auckland"
    title="Rank on Google. Be easier for AI to understand"
    subtitle="We combine traditional SEO with Generative Engine Optimisation to improve how Auckland businesses appear across Google and AI-assisted discovery tools."
    badgeText="Auckland AI SEO & GEO Specialists"
    ctaPrimary={{ text: "Get a Free AI SEO Audit", href: "/contact/" }}
    ctaSecondary={{ text: "See How It Works", href: "#services" }}
  />

  <StatsRow items={stats} />

  <div class="aiseo-snippet">
    <div class="container">
      <p><strong>Kiwi Web Design</strong> provides AI SEO and Generative Engine Optimisation for Auckland businesses. The service combines technical SEO, structured data, local entity signals, answer-ready content, authority building, and practical AI visibility monitoring. Scope is tailored to each business after an audit, with no lock-in contracts.</p>
    </div>
  </div>

  <section class="aiseo-trust-strip">
    <div class="container">
      <div class="aiseo-trust-inner">
        <div class="aiseo-trust-text">
          <p class="aiseo-trust-eyebrow">Why Kiwi Web Design for AI SEO</p>
          <h2>AI search optimisation built on real SEO foundations</h2>
          <p>AI visibility is not a replacement for search fundamentals. We combine technical SEO, local relevance, clear service information, structured data, useful content, and authority signals so the work supports both traditional search and newer AI-assisted discovery.</p>
        </div>
        <div class="aiseo-trust-badges">
          <div class="aiseo-trust-badge">
            <span class="atb-num">50+</span>
            <span class="atb-lbl">NZ businesses helped</span>
          </div>
          <div class="aiseo-trust-badge">
            <span class="atb-num">5★</span>
            <span class="atb-lbl">Google rating</span>
          </div>
          <div class="aiseo-trust-badge">
            <span class="atb-num">Local</span>
            <span class="atb-lbl">Auckland-focused strategy</span>
          </div>
          <div class="aiseo-trust-badge">
            <span class="atb-num">No lock-in</span>
            <span class="atb-lbl">Flexible engagement</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--kwd-cream);">
    <div class="container">
      <SectionHeader
        eyebrow="The AI Search Shift"
        title="Search is changing. Your SEO strategy should cover both"
        subtitle="Customers increasingly research through a mix of Google, AI-assisted answers, maps, reviews, and third-party sources. We optimise the foundations that support visibility across that whole journey."
      />
      <div class="aiseo-engines">
        {aiBenefit.map(({ icon, title, desc, items }) => (
          <div class="aiseo-engine-card">
            <span class="aiseo-eng-icon"><Icon name={icon} size={24} /></span>
            <h3 class="aiseo-eng-title">{title}</h3>
            <p class="aiseo-eng-desc">{desc}</p>
            {items && (
              <ul class="aiseo-eng-items">
                {items.map((item: string) => <li>{item}</li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="container">
      <SectionHeader
        eyebrow="AI SEO Services"
        title="Every layer of modern search optimisation"
        subtitle="From technical foundations to content, local signals, structured data, and authority, we focus on the parts that improve discoverability and enquiries."
      />
      <ServiceGrid items={services} cols={3} />
    </div>
  </section>

  <section class="section" style="background: var(--kwd-dark);">
    <div class="container">
      <SectionHeader eyebrow="What We Deliver" title="The foundations of AI-ready SEO." light={true} />
      <div class="seo-results">
        <div class="seo-result">
          <span class="sr-num">Technical</span>
          <span class="sr-label">Crawlable site structure</span>
          <span class="sr-industry">Search foundations</span>
        </div>
        <div class="seo-result">
          <span class="sr-num">Local</span>
          <span class="sr-label">Auckland entity signals</span>
          <span class="sr-industry">Local relevance</span>
        </div>
        <div class="seo-result">
          <span class="sr-num">Content</span>
          <span class="sr-label">Answer-ready service pages</span>
          <span class="sr-industry">AI discovery readiness</span>
        </div>
        <div class="seo-result">
          <span class="sr-num">Tracking</span>
          <span class="sr-label">GSC and GA4 reporting</span>
          <span class="sr-industry">Measured progress</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--kwd-dark);">
    <div class="container">
      <SectionHeader
        eyebrow="Traditional vs AI SEO"
        title="What we add to a strong SEO foundation"
        light={true}
        subtitle="Traditional SEO still matters. AI SEO adds clearer entities, answer-ready content, and broader discovery signals."
      />
      <div class="aiseo-compare">
        <div class="aiseo-compare-col">
          <p class="aiseo-compare-label">Traditional SEO foundation</p>
          <ul class="aiseo-compare-list aiseo-compare-list--old">
            <li>Optimise page titles and content</li>
            <li>Build relevant authority</li>
            <li>Target search intent</li>
            <li>Improve site performance</li>
          </ul>
        </div>
        <div class="aiseo-compare-divider">+</div>
        <div class="aiseo-compare-col aiseo-compare-col--new">
          <p class="aiseo-compare-label aiseo-compare-label--new">What AI SEO adds</p>
          <ul class="aiseo-compare-list aiseo-compare-list--new">
            <li>Structure content as direct, useful answers</li>
            <li>Add clear business, service, and entity schema</li>
            <li>Strengthen credible third-party mentions</li>
            <li>Improve AI-readable service and location information</li>
            <li>Optimise for AI-assisted search surfaces</li>
            <li>Monitor observed AI visibility alongside search data</li>
            <li>Build legitimate community and industry authority</li>
            <li>Keep crawler access and technical foundations clean</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section aiseo-process-section" style="background: var(--kwd-cream);">
    <div class="container">
      <div class="aiseo-process-split">
        <div class="aiseo-process-content">
          <SectionHeader
            eyebrow="How It Works"
            title="Audit, plan, build, report"
            subtitle="A structured engagement focused on the highest-impact search and AI visibility work first."
          />
          <ProcessSteps items={process} />
        </div>
        <div class="aiseo-process-img-wrap">
          <Image src={consultImg} alt="SEO strategy consultation, Kiwi Web Design Auckland" width={600} height={700} class="aiseo-process-img" />
          <div class="aiseo-process-pill">Free AI visibility audit included</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Client Reviews" title="What our clients say." />
      <TestimonialGrid items={reviews} cols={3} />
    </div>
  </section>

  <div class="aiseo-city-strip">
    <Image src={aucklandCBD} alt="Auckland CBD aerial view, Kiwi Web Design serves businesses across Auckland" width={1400} height={420} class="aiseo-city-img" />
    <div class="aiseo-city-overlay">
      <p class="aiseo-city-tag">Auckland-based · NZ-wide reach</p>
      <p class="aiseo-city-line">Helping Auckland businesses rank on Google and become easier to discover through AI.</p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width: 860px;">
      <FAQAccordion
        items={faqs}
        title="AI SEO Questions Answered"
        subtitle="Common questions from Auckland businesses about AI search, GEO, and generative engine optimisation."
      />
    </div>
  </section>

  <section class="related-strip">
    <div class="container" style="max-width: 860px;">
      <p class="rps-label">Related services</p>
      <div class="rps-links">
        <a href="/affordable-seo-auckland/" class="rps-link">SEO Services Auckland</a>
        <a href="/local-seo-for-auckland-small-businesses/" class="rps-link">Local SEO Auckland</a>
        <a href="/wordpress-seo-optimisation/" class="rps-link">WordPress SEO</a>
        <a href="/seo-for-ecommerce/" class="rps-link">eCommerce SEO</a>
        <a href="/analytics-reporting-for-auckland-small-business-websites/" class="rps-link">Analytics & Reporting</a>
        <a href="/google-business-profile-guide-for-auckland-businesses/" class="rps-link">Google Business Profile</a>
        <a href="/case-study-scaffolding/" class="rps-link">Case Study: Barrett Scaffolding</a>
        <a href="/beauty-touch-case-study/" class="rps-link">Case Study: Beauty Touch</a>
      </div>
    </div>
  </section>

  <CTABanner
    variant="yellow"
    title="Ready to improve your visibility across Google and AI search?"
    subtitle="Start with a free AI SEO audit and we will show you the highest-priority gaps and opportunities."
    ctaPrimary={{ text: "Get a Free AI SEO Audit", href: "/contact/" }}
    ctaSecondary={{ text: "See All SEO Services", href: "/affordable-seo-auckland/" }}
  />

</Layout>

<style>
  .aiseo-snippet { background: #fff8e1; border-left: 4px solid var(--kwd-yellow); padding: 1rem 0; }
  .aiseo-snippet p { margin: 0; font-size: 0.95rem; line-height: 1.65; color: var(--kwd-dark); }

  .aiseo-trust-strip {
    background: var(--kwd-dark);
    padding: 3.5rem 0;
  }
  .aiseo-trust-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .aiseo-trust-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--kwd-yellow);
    margin: 0 0 0.75rem;
  }
  .aiseo-trust-text h2 {
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    color: #fff;
    line-height: 1.2;
    margin: 0 0 1rem;
  }
